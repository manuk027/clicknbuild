            <div class="flex items-center gap-3 min-w-0">
                <i class="fas fa-th w-5 flex-shrink-0"></i>
                <span class="text-sm sm:text-base truncate">Category</span>
            </div>
            <i class="fas fa-chevron-right w-4 flex-shrink-0"></i>
