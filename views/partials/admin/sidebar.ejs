<aside id="sidebar"
    class="w-full sm:w-64 bg-white shadow-lg fixed lg:static left-0 top-0 h-screen z-40 transition-transform duration-300 lg:translate-x-0 -translate-x-full overflow-y-auto">
    <!-- Logo -->
    <div class="p-4 sm:p-6 border-b border-gray-200 sticky top-0 bg-white flex items-center justify-center">
        <div class="flex items-center gap-2">
            <div
                class="w-14 sm:w-20 h-14 sm:h-20 bg-black rounded flex items-center justify-center text-white font-bold text-xs sm:text-lg overflow-hidden">
                <img src="`/images/logo.png" alt="Logo" class="w-full h-full object-contain object-center">
            </div>
        </div>
    </div>


    <!-- Navigation Menu -->
    <nav class="p-2 sm:p-4 space-y-1 sm:space-y-2">
        <!-- Dashboard Link -->
        <a href="#dashboard"
            class="nav-link flex items-center gap-3 px-3 sm:px-4 py-2 sm:py-3 rounded-lg text-gray-700 hover:bg-gray-100 transition-colors active bg-gray-100">
            <i class="fas fa-chart-line w-5"></i>
            <span class="text-sm sm:text-base">Dashboard</span>
        </a>

        <!-- Products Link -->
        <button
            class="nav-link w-full flex items-center justify-between px-3 sm:px-4 py-2 sm:py-3 rounded-lg text-gray-700 hover:bg-gray-100 transition-colors">
            <div class="flex items-center gap-3 min-w-0">
                <i class="fas fa-box w-5 flex-shrink-0"></i>
                <span class="text-sm sm:text-base truncate">Products</span>
            </div>
            <i class="fas fa-chevron-right w-4 flex-shrink-0"></i>
        </button>

        <!-- Order List Link -->
        <button
            class="nav-link w-full flex items-center justify-between px-3 sm:px-4 py-2 sm:py-3 rounded-lg text-gray-700 hover:bg-gray-100 transition-colors">
            <div class="flex items-center gap-3 min-w-0">
                <i class="fas fa-list w-5 flex-shrink-0"></i>
                <span class="text-sm sm:text-base truncate">Order List</span>
            </div>
            <i class="fas fa-chevron-right w-4 flex-shrink-0"></i>
        </button>

        <!-- Customer Link -->
        <button
            class="nav-link w-full flex items-center justify-between px-3 sm:px-4 py-2 sm:py-3 rounded-lg text-gray-700 hover:bg-gray-100 transition-colors">
            <div class="flex items-center gap-3 min-w-0">
