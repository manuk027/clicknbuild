<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Category List - Admin Dashboard</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>

<body class="bg-gray-50 font-sans text-gray-900">

    <%- include("../../views/partials/admin/sidebar") %>

        <div class="flex flex-col min-h-screen lg:ml-64 transition-all duration-300">

            <header class="bg-white shadow-sm sticky top-0 z-30">
                <%- include("../../views/partials/admin/header") %>
            </header>

            <main class="flex-1 p-4 sm:p-6 lg:p-8">

                <div class="mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
                    <div>
                        <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-1">CATEGORY LIST</h1>
                        <div class="flex items-center gap-2 text-sm text-gray-600">
                            <span><a href="/admin" class="hover:text-black transition-colors">Dashboard</a></span>
                            <i class="fas fa-chevron-right text-xs"></i>
                            <span class="text-gray-900 font-medium">Category</span>
                        </div>
                    </div>
                    <a href="/admin/category/add"
                        class="flex items-center justify-center gap-2 px-5 py-2.5 bg-black text-white rounded-lg hover:bg-gray-800 transition-all shadow-md active:scale-95 w-full sm:w-auto">
                        <span>ADD CATEGORY</span>
                        <i class="fas fa-plus"></i>
                    </a>
                </div>

                <div class="flex flex-col sm:flex-row gap-4 mb-6 justify-between items-start sm:items-center">

                    <form id="searchForm" action="/admin/category" method="GET"
                        class="flex w-full sm:max-w-md relative">
                        <div class="relative w-full">
                            <i class="fas fa-search absolute left-3 top-1/2 -translate-y-1/2 text-gray-400"></i>
                            <input type="text" name="search" id="searchInput" placeholder="Search category..."
                                value="<%= typeof search !== 'undefined' ? search : '' %>"
                                class="w-full pl-10 pr-10 py-2.5 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-black transition-shadow" />
                            <% if (search) { %>
                                <button type="button" id="clearSearch"
                                    class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-700 p-1">
                                    <i class="fas fa-times"></i>
                                </button>
                                <% } %>
                        </div>
                        <button type="submit"
                            class="ml-2 px-4 py-2 bg-black text-white rounded-lg hover:bg-gray-800 transition-colors">
                            Search
                        </button>
                    </form>

                    <div class="relative self-end sm:self-auto">
                        <button id="sortBtn"
                            class="flex items-center gap-2 px-4 py-2.5 border border-gray-300 bg-white rounded-lg hover:bg-gray-50 transition-colors shadow-sm">
                            <i class="fas fa-sort text-gray-500"></i>
                            <span>Sort</span>
                            <i class="fas fa-chevron-down text-xs ml-1 text-gray-400"></i>
                        </button>

                        <div id="sortDropdown"
                            class="hidden absolute right-0 mt-2 w-40 bg-white border border-gray-200 rounded-lg shadow-xl z-50 overflow-hidden">
                            <a onclick="applySort('newest')"
                                class="block px-4 py-2 hover:bg-gray-50 cursor-pointer text-sm text-gray-700 transition-colors border-b border-gray-100">Newest</a>
                            <a onclick="applySort('oldest')"
                                class="block px-4 py-2 hover:bg-gray-50 cursor-pointer text-sm text-gray-700 transition-colors">Oldest</a>
                        </div>
                    </div>
                </div>

                <div class="hidden md:block bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden mb-6">
                    <div class="overflow-x-auto">
                        <table class="w-full whitespace-nowrap">
                            <thead class="bg-black text-white text-center">
                                <tr>
                                    <th class="px-4 py-4 text-xs font-bold uppercase tracking-wider">SL NO</th>
                                    <th class="px-4 py-4 text-xs font-bold uppercase tracking-wider">Category Name</th>
                                    <th class="px-4 py-4 text-xs font-bold uppercase tracking-wider">Sales</th>
                                    <th class="px-4 py-4 text-xs font-bold uppercase tracking-wider">Type</th>
                                    <th class="px-4 py-4 text-xs font-bold uppercase tracking-wider">Status</th>
                                    <th class="px-4 py-4 text-xs font-bold uppercase tracking-wider">Offer Action</th>
                                    <th class="px-4 py-4 text-xs font-bold uppercase tracking-wider">Edit</th>
                                    <th class="px-4 py-4 text-xs font-bold uppercase tracking-wider">Offer %</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-gray-200 bg-white text-center">
                                <% for (let i=0; i < data.length; i++) { %>
                                    <tr class="hover:bg-gray-50 transition-colors">
                                        <td class="px-4 py-4 text-gray-700">
                                            <%= (current - 1) * limit + i + 1 %>
                                        </td>
                                        <td class="px-4 py-4 font-medium text-gray-900">
                                            <%= data[i].name %>
                                        </td>
                                        <td class="px-4 py-4 text-gray-500">sales</td>
                                        <td class="px-4 py-4 text-gray-700">
                                            <% if(data[i].isPeripheral){ %> Peripheral <% } else { %> Component <% } %>
                                        </td>
                                        <td class="px-4 py-4">
                                            <% if (data[i].isListed) { %>
                                                <a href="/admin/category/unListCategory?id=<%=data[i]._id%>&page=<%= current %>"
                                                    class="inline-flex items-center justify-center w-20 py-1 rounded-full bg-red-100 text-red-700 text-xs font-bold hover:bg-red-200 transition-colors">
                                                    Unlist
                                                </a>
                                                <% } else { %>
                                                    <a href="/admin/category/listCategory?id=<%=data[i]._id%>&page=<%= current %>"
                                                        class="inline-flex items-center justify-center w-20 py-1 rounded-full bg-green-100 text-green-700 text-xs font-bold hover:bg-green-200 transition-colors">
                                                        List
                                                    </a>
                                                    <% } %>
                                        </td>
                                        <td class="px-4 py-4">
                                            <% if (data[i].maxOffer===0) { %>
                                                <button onclick="addOffer('<%=data[i]._id%>')"
                                                    class="inline-flex items-center justify-center px-3 py-1 rounded-lg bg-green-600 text-white text-xs font-medium hover:bg-green-700 transition-colors shadow-sm">
                                                    Add Offer
                                                </button>
                                                <% } else { %>
                                                    <button onclick="removeOffer('<%=data[i]._id%>')"
                                                        class="inline-flex items-center justify-center px-3 py-1 rounded-lg bg-blue-600 text-white text-xs font-medium hover:bg-blue-700 transition-colors shadow-sm">
                                                        Remove Offer
                                                    </button>
                                                    <% } %>
                                        </td>
                                        <td class="px-4 py-4">
                                            <a href="/admin/category/editCategory?id=<%=data[i]._id%>"
                                                class="text-gray-500 hover:text-black transition-colors p-2">
                                                <i class="fas fa-edit text-lg"></i>
                                            </a>
                                        </td>
                                        <td class="px-4 py-4 text-gray-700 font-bold">
                                            <%= data[i].maxOffer ?? 0 %>%
                                        </td>
                                    </tr>
                                    <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="grid grid-cols-1 gap-4 md:hidden mb-6">
                    <% for (let i=0; i < data.length; i++) { %>
                        <div class="bg-white p-5 rounded-xl shadow-sm border border-gray-200 flex flex-col">

                            <div class="flex justify-between items-start mb-3 border-b border-gray-100 pb-3">
                                <div class="flex items-center gap-2">
                                    <span
                                        class="bg-black text-white text-xs font-bold rounded-full w-6 h-6 flex items-center justify-center">
                                        <%= (current - 1) * limit + i + 1 %>
                                    </span>
                                    <h3 class="font-bold text-gray-900">
                                        <%= data[i].name %>
                                    </h3>
                                </div>
                                <span class="text-xs font-semibold px-2 py-1 bg-gray-100 text-gray-600 rounded">
                                    <% if(data[i].isPeripheral){ %> Peripheral <% } else { %> Component <% } %>
                                </span>
                            </div>

                            <div class="grid grid-cols-2 gap-4 mb-4 text-sm">
                                <div>
                                    <span class="text-xs text-gray-500 block mb-1">Offer Applied</span>
                                    <span class="font-medium text-blue-600 bg-blue-50 px-2 py-0.5 rounded">
                                        <%= data[i].maxOffer ?? 0 %>%
                                    </span>
                                </div>
                                <div>
                                    <span class="text-xs text-gray-500 block mb-1">Sales</span>
                                    <span class="font-medium text-gray-700">sales</span>
                                </div>
                            </div>

                            <div class="flex flex-wrap gap-2 mt-auto">
                                <% if (data[i].isListed) { %>
                                    <button onclick="unListCategory('<%= data[i]._id %>', '<%= current %>')"
                                        class="flex-1 text-center py-2 rounded-lg bg-red-50 text-red-700 text-xs font-bold border border-red-100 hover:bg-red-100 transition">
                                        Unlist
                                    </button>
                                    <% } else { %>
                                        <button onclick="listCategory('<%= data[i]._id %>', '<%= current %>')"
                                            class="flex-1 text-center py-2 rounded-lg bg-green-50 text-green-700 text-xs font-bold border border-green-100 hover:bg-green-100 transition">
                                            List
                                        </button>
                                        <% } %>

                                            <% if (data[i].maxOffer===0) { %>
                                                <button onclick="addOffer('<%=data[i]._id%>')"
                                                    class="flex-1 py-2 rounded-lg bg-black text-white text-xs font-bold hover:bg-gray-800 transition shadow-sm">
                                                    Add Offer
                                                </button>
                                                <% } else { %>
                                                    <button onclick="removeOffer('<%=data[i]._id%>')"
                                                        class="flex-1 py-2 rounded-lg bg-white border border-gray-300 text-gray-700 text-xs font-bold hover:bg-gray-50 transition shadow-sm">
                                                        Remove
                                                    </button>
                                                    <% } %>

                                                        <a href="/admin/category/editCategory?id=<%=data[i]._id%>"
                                                            class="w-9 h-9 flex items-center justify-center rounded-lg bg-gray-100 text-gray-600 hover:bg-black hover:text-white transition">
                                                            <i class="fas fa-edit"></i>
                                                        </a>
                            </div>
                        </div>
                        <% } %>
                </div>

                <% if (data.length> 0) { %>
                    <div class="flex justify-center mt-8 pb-8">
                        <nav aria-label="Dashboard Pagination">
                            <ul class="flex items-center space-x-2">
                                <% let baseUrl=`/admin/category?sort=${sort || "" }&search=${search || "" }`; %>

                                    <% if (current==1) { %>
                                        <li><span
                                                class="px-3 py-2 text-sm font-medium text-gray-400 bg-gray-100 border border-gray-300 rounded-lg cursor-not-allowed">First</span>
                                        </li>
                                        <% } else { %>
                                            <li><a href="<%= baseUrl %>&page=1"
                                                    class="px-3 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50">First</a>
                                            </li>
                                            <% } %>

                                                <% let i=(Number(current)> 5 ? Number(current) - 4 : 1); %>
                                                    <% if (i !==1) { %>
                                                        <li class="hidden sm:block"><span
                                                                class="px-3 py-2 text-sm text-gray-500">...</span></li>
                                                        <% } %>

                                                            <% for (; i <=(Number(current) + 4) && i <=pages; i++) { %>
                                                                <% if (i==current) { %>
                                                                    <li><span
                                                                            class="px-4 py-2 text-sm font-bold text-white bg-black border border-black rounded-lg">
                                                                            <%= i %>
                                                                        </span></li>
                                                                    <% } else { %>
                                                                        <li><a href="<%= baseUrl %>&page=<%= i %>"
                                                                                class="px-3 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50">
                                                                                <%= i %>
                                                                            </a></li>
                                                                        <% } %>
                                                                            <% } %>

                                                                                <% if (i==Number(current) + 4 && i <
                                                                                    pages) { %>
                                                                                    <li class="hidden sm:block"><span
                                                                                            class="px-3 py-2 text-sm text-gray-500">...</span>
                                                                                    </li>
                                                                                    <% } %>

                                                                                        <% if (current==pages) { %>
                                                                                            <li><span
                                                                                                    class="px-3 py-2 text-sm font-medium text-gray-400 bg-gray-100 border border-gray-300 rounded-lg cursor-not-allowed">Last</span>
                                                                                            </li>
                                                                                            <% } else { %>
                                                                                                <li><a href="<%= baseUrl %>&page=<%= pages %>"
                                                                                                        class="px-3 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50">Last</a>
                                                                                                </li>
                                                                                                <% } %>
                            </ul>
                        </nav>
                    </div>
                    <% } %>

            </main>
        </div>

        <script src="https://code.jquery.com/jquery-3.6.4.min.js"></script>
        <script>
            // --- Search Logic ---
            const searchInput = document.getElementById("searchInput");
            const searchForm = document.getElementById("searchForm");
            const clearSearch = document.getElementById("clearSearch");

            if (clearSearch) {
                clearSearch.addEventListener("click", () => window.location.href = "/admin/category");
            }
            if (searchInput && searchForm) {
                searchInput.addEventListener("keypress", (e) => {
                    if (e.key === "Enter") {
                        e.preventDefault();
                        searchForm.submit();
                    }
                });
            }

            // --- Sort Logic ---
            const sortBtn = document.getElementById('sortBtn');
            const sortDropdown = document.getElementById('sortDropdown');

            if (sortBtn && sortDropdown) {
                sortBtn.addEventListener('click', (e) => {
                    e.stopPropagation();
                    sortDropdown.classList.toggle('hidden');
                });
                window.addEventListener('click', (e) => {
                    if (!sortBtn.contains(e.target) && !sortDropdown.contains(e.target)) {
                        sortDropdown.classList.add('hidden');
                    }
                });
            }

            window.applySort = (sortType) => {
                const url = new URL(window.location.href);
                url.searchParams.set("sort", sortType);
                window.location.href = url.toString();
            };


            // -----------------------------------------------------------------
            // 💡 Reusable SweetAlert API Response Handler
            // -----------------------------------------------------------------
            function showApiResponse(success, message) {
                if (success) {
                    Swal.fire({
                        icon: "success",
                        title: "Success",
                        text: message || "Operation Successful",
                        confirmButtonColor: "#000"
                    }).then(() => location.reload());
                } else {
                    Swal.fire({
                        icon: "error",
                        title: "Failed",
                        text: message || "Something went wrong",
                        confirmButtonColor: "#000"
                    });
                }
            }


            // -----------------------------------------------------------------
            // ⭐ ADD OFFER
            // -----------------------------------------------------------------
            async function addOffer(categoryId) {
                const { value: amount } = await Swal.fire({
                    title: "Offer in percentage",
                    input: "number",
                    inputLabel: "Percentage",
                    inputPlaceholder: "%",
                    confirmButtonColor: "#000",
                });

                if (!amount) return;

                try {
                    const response = await fetch("/admin/category/addCategoryOffer", {
                        method: "POST",
                        headers: { "content-type": "application/json" },
                        body: JSON.stringify({ percentage: amount, categoryId }),
                    });

                    const result = await response.json();
                    showApiResponse(result.success, result.message);

                } catch (error) {
                    console.error(error);
                    showApiResponse(false, "An unexpected error occurred.");
                }
            }


            // -----------------------------------------------------------------
            // ⭐ REMOVE OFFER
            // -----------------------------------------------------------------
            async function removeOffer(categoryId) {
                const confirmation = await Swal.fire({
                    title: "Are you sure?",
                    text: "You want to remove this offer?",
                    icon: "warning",
                    showCancelButton: true,
                    confirmButtonColor: "#d33",
                    cancelButtonColor: "#000",
                    confirmButtonText: "Yes, remove it!"
                });

                if (!confirmation.isConfirmed) return;

                try {
                    const response = await fetch("/admin/category/removeCategoryOffer", {
                        method: "POST",
                        headers: { "content-type": "application/json" },
                        body: JSON.stringify({ categoryId }),
                    });

                    const result = await response.json();
                    showApiResponse(result.success, result.message);

                } catch (error) {
                    console.error(error);
                    showApiResponse(false, "An unexpected error occurred.");
                }
            }
        </script>
        <script>
            // -----------------------------------------------------------------
            // ⭐ SweetAlert Response Handler
            // -----------------------------------------------------------------
            function showApiResponse(success, message) {
                if (success) {
                    Swal.fire({
                        icon: "success",
                        title: "Success",
                        text: message || "Operation Successful",
                        confirmButtonColor: "#000"
                    }).then(() => location.reload());
                } else {
                    Swal.fire({
                        icon: "error",
                        title: "Failed",
                        text: message || "Something went wrong",
                        confirmButtonColor: "#000"
                    });
                }
            }


            // -----------------------------------------------------------------
            // ⭐ LIST CATEGORY
            // -----------------------------------------------------------------
            async function listCategory(categoryId, page) {

                const confirm = await Swal.fire({
                    title: "Are you sure?",
                    text: "You want to list this category?",
                    icon: "warning",
                    showCancelButton: true,
                    confirmButtonColor: "#28a745",
                    cancelButtonColor: "#000",
                    confirmButtonText: "Yes, List it"
                });

                if (!confirm.isConfirmed) return;

                try {
                    const response = await fetch(`/admin/category/listCategory?id=${categoryId}&page=${page}`, {
                        method: "GET"
                    });

                    if (response.redirected) {
                        return location.href = response.url;
                    }

                    const result = await response.json();
                    showApiResponse(result.success, result.message);

                } catch (err) {
                    console.error(err);
                    showApiResponse(false, "An unexpected error occurred.");
                }
            }


            // -----------------------------------------------------------------
            // ⭐ UNLIST CATEGORY
            // -----------------------------------------------------------------
            async function unListCategory(categoryId, page) {

                const confirm = await Swal.fire({
                    title: "Are you sure?",
                    text: "You want to unlist this category?",
                    icon: "warning",
                    showCancelButton: true,
                    confirmButtonColor: "#d33",
                    cancelButtonColor: "#000",
                    confirmButtonText: "Yes, Unlist it"
                });

                if (!confirm.isConfirmed) return;

                try {
                    const response = await fetch(`/admin/category/unListCategory?id=${categoryId}&page=${page}`, {
                        method: "GET"
                    });

                    if (response.redirected) {
                        return location.href = response.url;
                    }

                    const result = await response.json();
                    showApiResponse(result.success, result.message);

                } catch (err) {
                    console.error(err);
                    showApiResponse(false, "An unexpected error occurred.");
                }
            }
        </script>

</body>

</html>