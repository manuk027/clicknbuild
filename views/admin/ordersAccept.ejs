<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin - Orders</title>
    <link rel="icon" href="https://res.cloudinary.com/dmx7sia5q/image/upload/v1761540715/logo_dtmtfn.png" type="image/png">
    
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>

<body class="bg-gray-50 font-sans text-gray-900">

    <%- include("../../views/partials/admin/sidebar") %>

    <div class="flex flex-col min-h-screen lg:ml-64 transition-all duration-300">
        
        <header class="bg-white shadow-sm sticky top-0 z-30">
            <%- include("../../views/partials/admin/header") %>
        </header>

        <main class="flex-1 p-4 sm:p-6 lg:p-8">
            
            <div class="mb-6">
                <div class="flex justify-between items-center w-full">
                    <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-2">
                        ORDER LIST
                    </h1>
                </div>
                <div class="flex items-center gap-2 text-sm text-gray-600">
                    <span><a href="/admin" class="hover:text-black">Dashboard</a></span>
                    <i class="fas fa-chevron-right text-xs"></i>
                    <span class="text-gray-900 font-medium">Orders</span>
                </div>
            </div>

            <div class="flex flex-col lg:flex-row gap-4 mb-6 justify-between items-start lg:items-center">
                
                <form id="searchForm" action="/admin/orders" method="GET" class="flex w-full lg:max-w-md relative">
                    <div class="relative w-full">
                        <i class="fas fa-search absolute left-3 top-1/2 -translate-y-1/2 text-gray-400"></i>
                        <input type="text" name="search" id="searchInput" placeholder="Search orders..." 
                            value="<%= typeof search !== 'undefined' ? search : '' %>" 
                            class="w-full pl-10 pr-10 py-2.5 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-black transition-shadow" />
                        <% if (search) { %>
                            <button type="button" id="clearSearch" class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-700 p-1">
                                <i class="fas fa-times"></i>
                            </button>
                        <% } %>
                    </div>
                    <button type="submit" class="ml-2 px-4 py-2 bg-black text-white rounded-lg hover:bg-gray-800 transition-colors">
                        Search
                    </button>
                </form>

                <div class="flex flex-wrap gap-3 w-full lg:w-auto">
                    <div class="relative w-full sm:w-auto">
                        <button id="filtersBtn" class="w-full sm:w-auto flex items-center justify-center gap-2 px-4 py-2.5 border border-gray-300 bg-white rounded-lg hover:bg-gray-50 transition-colors shadow-sm">
                            <i class="fas fa-sliders-h text-gray-500"></i>
                            <span>Filters</span>
                            <i class="fas fa-chevron-down text-xs ml-1 text-gray-400"></i>
                        </button>
                        <div id="filtersDropdown" class="hidden absolute right-0 mt-2 w-48 bg-white border border-gray-200 rounded-lg shadow-xl z-50 overflow-hidden">
                            <a onclick="applyFilter('All')" class="block px-4 py-2 hover:bg-gray-50 cursor-pointer text-sm">All</a>
                            <a onclick="applyFilter('Pending')" class="block px-4 py-2 hover:bg-gray-50 cursor-pointer text-sm">Pending</a>
                            <a onclick="applyFilter('Processing')" class="block px-4 py-2 hover:bg-gray-50 cursor-pointer text-sm">Processing</a>
                            <a onclick="applyFilter('Out for delivery')" class="block px-4 py-2 hover:bg-gray-50 cursor-pointer text-sm">Out for delivery</a>
                            <a onclick="applyFilter('Delivered')" class="block px-4 py-2 hover:bg-gray-50 cursor-pointer text-sm">Delivered</a>
                            <a onclick="applyFilter('Return requested')" class="block px-4 py-2 hover:bg-gray-50 cursor-pointer text-sm">Return requested</a>
                            <a onclick="applyFilter('Returned')" class="block px-4 py-2 hover:bg-gray-50 cursor-pointer text-sm">Returned</a>
                            <a onclick="applyFilter('Cancelled')" class="block px-4 py-2 hover:bg-gray-50 cursor-pointer text-sm">Cancelled</a>
                        </div>
                    </div>

                    <div class="relative w-full sm:w-auto">
                        <button id="sortBtn" class="w-full sm:w-auto flex items-center justify-center gap-2 px-4 py-2.5 border border-gray-300 bg-white rounded-lg hover:bg-gray-50 transition-colors shadow-sm">
                            <i class="fas fa-sort text-gray-500"></i>
                            <span>Sort</span>
                            <i class="fas fa-chevron-down text-xs ml-1 text-gray-400"></i>
                        </button>
                        <div id="sortDropdown" class="hidden absolute right-0 mt-2 w-40 bg-white border border-gray-200 rounded-lg shadow-xl z-50 overflow-hidden">
                            <a onclick="applySort('newest')" class="block px-4 py-2 hover:bg-gray-50 cursor-pointer text-sm">Newest</a>
                            <a onclick="applySort('oldest')" class="block px-4 py-2 hover:bg-gray-50 cursor-pointer text-sm">Oldest</a>
                        </div>
                    </div>
                </div>
            </div>

            <% 
            function statusColor(status) {
                switch (status) {
                    case "Delivered": return "bg-green-100 text-green-700 border-green-200";
                    case "Pending": return "bg-yellow-100 text-yellow-700 border-yellow-200";
                    case "Cancelled": return "bg-red-100 text-red-700 border-red-200";
                    case "Return requested": return "bg-blue-100 text-blue-700 border-blue-200";
                    case "Returned": return "bg-purple-100 text-purple-700 border-purple-200";
                    default: return "bg-gray-100 text-gray-700 border-gray-200";
                }
            } 
            %>

            <div class="hidden md:block bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden mb-6">
                <div class="overflow-x-auto">
                    <table class="w-full whitespace-nowrap">
                        <thead class="bg-black text-white text-center">
                            <tr>
                                <th class="px-4 py-4 text-sm font-semibold tracking-wider">OrderId</th>
                                <th class="px-4 py-4 text-sm font-semibold tracking-wider">SKU</th>
                                <th class="px-4 py-4 text-sm font-semibold tracking-wider">Date</th>
                                <th class="px-4 py-4 text-sm font-semibold tracking-wider">Status</th>
                                <th class="px-4 py-4 text-sm font-semibold tracking-wider">Action</th>
                                <th class="px-4 py-4 text-sm font-semibold tracking-wider">Details</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-200 bg-white">
                            <% for(let i=0; i<product.length; i++){ %>
                                <tr class="hover:bg-gray-50 transition-colors" data-order='<%- JSON.stringify(product[i]) %>'>
                                    <td class="px-4 py-4 text-gray-700 text-center font-medium">#<%=product[i].orderId%></td>
                                    <td class="px-4 py-4 text-gray-600 text-center"><%=product[i].sku%></td>
                                    <td class="px-4 py-4 text-gray-600 text-center"><%=product[i]?.orderDate.toLocaleDateString("en-CA")%></td>
                                    <td class="px-4 py-4 text-center">
                                        <span class="<%= statusColor(product[i].status) %> px-3 py-1 rounded-full text-xs font-semibold inline-block border">
                                            <%= product[i].status %>
                                        </span>
                                    </td>
                                    <td class="px-4 py-4 text-center">
                                        <button class="orderActionBtn w-8 h-8 rounded-full bg-gray-100 text-gray-600 hover:bg-black hover:text-white transition-colors flex items-center justify-center mx-auto"
                                            data-id="<%= product[i].orderId %>" data-sku="<%= product[i].sku %>" data-status="<%= product[i].status %>">
                                            <i class="fas fa-edit text-xs"></i>
                                        </button>
                                    </td>
                                    <td class="px-4 py-4 text-center">
                                        <button class="showVariantsBtn w-8 h-8 rounded-full bg-blue-50 text-blue-600 hover:bg-blue-600 hover:text-white transition-colors flex items-center justify-center mx-auto"
                                            data-id="<%= product[i].itemId %>">
                                            <i class="far fa-eye text-xs"></i>
                                        </button>
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="grid grid-cols-1 gap-4 md:hidden mb-6">
                <% for(let i=0; i<product.length; i++){ %>
                    <div class="bg-white p-5 rounded-xl shadow-sm border border-gray-200 relative" data-order='<%- JSON.stringify(product[i]) %>'>
                        
                        <div class="flex justify-between items-start mb-3 border-b border-gray-100 pb-3">
                            <div>
                                <span class="text-xs text-gray-500 block uppercase">Order ID</span>
                                <span class="font-bold text-gray-900">#<%= product[i].orderId %></span>
                            </div>
                            <span class="<%= statusColor(product[i].status) %> px-2 py-1 rounded text-xs font-semibold border">
                                <%= product[i].status %>
                            </span>
                        </div>

                        <div class="grid grid-cols-2 gap-4 mb-4">
                            <div>
                                <span class="text-xs text-gray-500 block">SKU</span>
                                <span class="text-sm font-medium text-gray-700"><%= product[i].sku %></span>
                            </div>
                            <div>
                                <span class="text-xs text-gray-500 block">Date</span>
                                <span class="text-sm font-medium text-gray-700"><%= product[i]?.orderDate.toLocaleDateString("en-CA") %></span>
                            </div>
                        </div>

                        <div class="flex justify-end gap-3 pt-2">
                            <button class="orderActionBtn flex-1 py-2 rounded-lg bg-gray-100 text-gray-600 hover:bg-black hover:text-white transition-colors flex items-center justify-center gap-2 text-sm font-medium"
                                data-id="<%= product[i].orderId %>" data-sku="<%= product[i].sku %>" data-status="<%= product[i].status %>">
                                <i class="fas fa-edit"></i> Edit Status
                            </button>
                            <button class="showVariantsBtn flex-1 py-2 rounded-lg bg-blue-50 text-blue-600 hover:bg-blue-600 hover:text-white transition-colors flex items-center justify-center gap-2 text-sm font-medium"
                                data-id="<%= product[i].itemId %>">
                                <i class="far fa-eye"></i> View Details
                            </button>
                        </div>
                    </div>
                <% } %>
            </div>

            <% if (product.length > 0) { %>
            <div class="flex justify-center mt-8 pb-8">
                <nav aria-label="Dashboard Pagination">
                    <ul class="flex items-center space-x-2">
                        <% let baseUrl = `/admin/orders?sort=${sort || ""}&search=${search || ""}&status=${statusFilter || ""}`; %>

                        <% if (current == 1) { %>
                            <li><span class="px-3 py-2 text-sm font-medium text-gray-400 bg-gray-100 border border-gray-300 rounded-lg cursor-not-allowed">First</span></li>
                        <% } else { %>
                            <li><a href="<%= baseUrl %>&page=1" class="px-3 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50">First</a></li>
                        <% } %>

                        <% let i = (Number(current) > 5 ? Number(current) - 4 : 1); %>
                        <% if (i !== 1) { %>
                            <li class="hidden sm:block"><span class="px-3 py-2 text-sm text-gray-500">...</span></li>
                        <% } %>

                        <% for (; i <= (Number(current) + 4) && i <= pages; i++) { %>
                            <% if (i == current) { %>
                                <li><span class="px-4 py-2 text-sm font-bold text-white bg-black border border-black rounded-lg"><%= i %></span></li>
                            <% } else { %>
                                <li><a href="<%= baseUrl %>&page=<%= i %>" class="px-3 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50"><%= i %></a></li>
                            <% } %>
                        <% } %>

                        <% if (i == Number(current) + 4 && i < pages) { %>
                            <li class="hidden sm:block"><span class="px-3 py-2 text-sm text-gray-500">...</span></li>
                        <% } %>

                        <% if (current == pages) { %>
                            <li><span class="px-3 py-2 text-sm font-medium text-gray-400 bg-gray-100 border border-gray-300 rounded-lg cursor-not-allowed">Last</span></li>
                        <% } else { %>
                            <li><a href="<%= baseUrl %>&page=<%= pages %>" class="px-3 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50">Last</a></li>
                        <% } %>
                    </ul>
                </nav>
            </div>
            <% } %>

        </main>
    </div>

    <div id="orderModal" class="hidden fixed inset-0 bg-black bg-opacity-60 flex items-center justify-center z-[80] backdrop-blur-sm px-4">
        <div class="bg-white rounded-xl shadow-2xl w-full max-w-2xl relative flex flex-col max-h-[90vh]">
            <div class="p-5 border-b border-gray-200 flex justify-between items-center sticky top-0 bg-white rounded-t-xl z-10">
                <h2 class="text-xl font-bold text-gray-800">Order Details</h2>
                <button id="closeOrderModal" class="text-gray-400 hover:text-red-500 transition text-2xl leading-none">&times;</button>
            </div>
            <div id="orderDetailsContent" class="p-6 overflow-y-auto space-y-4 text-gray-700"></div>
        </div>
    </div>

    <div id="statusModal" class="fixed inset-0 bg-black bg-opacity-60 flex items-center justify-center z-[80] hidden px-4 backdrop-blur-sm">
        <div class="bg-white rounded-xl w-full max-w-sm p-6 shadow-2xl animate-fade-in">
            <h2 class="text-xl font-bold mb-4 text-gray-900">Update Status</h2>
            <select id="statusSelect" class="w-full border border-gray-300 rounded-lg p-3 focus:outline-none focus:ring-2 focus:ring-black mb-6 bg-white">
                <option value="Pending">Pending</option>
                <option value="Processing">Processing</option>
                <option value="Out for delivery">Out for delivery</option>
                <option value="Delivered">Delivered</option>
                <option value="Cancelled">Cancelled</option>
                <option value="Returned">Returned</option>
                <option value="Return requested">Return requested</option>
            </select>
            <div class="flex justify-end gap-3">
                <button id="cancelModal" class="px-4 py-2 rounded-lg border border-gray-300 text-gray-700 hover:bg-gray-50 transition">Cancel</button>
                <button id="confirmStatus" class="px-4 py-2 rounded-lg bg-black text-white hover:bg-gray-800 transition shadow-md">Update</button>
            </div>
        </div>
    </div>

    <script>
        // --- Search & Filters ---
        const searchInput = document.getElementById("searchInput");
        const searchForm = document.getElementById("searchForm");
        const clearSearch = document.getElementById("clearSearch");

        if (clearSearch) {
            clearSearch.addEventListener("click", () => window.location.href = "/admin/orders");
        }
        if (searchInput && searchForm) {
            searchInput.addEventListener("keypress", (e) => {
                if (e.key === "Enter") { e.preventDefault(); searchForm.submit(); }
            });
        }

        // --- Dropdown Toggles ---
        const toggleDropdown = (btnId, menuId) => {
            const btn = document.getElementById(btnId);
            const menu = document.getElementById(menuId);
            if(btn && menu) {
                btn.addEventListener("click", (e) => {
                    e.stopPropagation();
                    menu.classList.toggle("hidden");
                });
                document.addEventListener("click", (e) => {
                    if (!btn.contains(e.target) && !menu.contains(e.target)) menu.classList.add("hidden");
                });
            }
        }
        toggleDropdown("filtersBtn", "filtersDropdown");
        toggleDropdown("sortBtn", "sortDropdown");

        // --- Helper Functions ---
        window.applyFilter = (status) => {
            const url = new URL(window.location.href);
            status === "All" ? url.searchParams.delete("status") : url.searchParams.set("status", status);
            window.location.href = url.toString();
        }
        window.applySort = (type) => {
            const url = new URL(window.location.href);
            url.searchParams.set("sort", type);
            window.location.href = url.toString();
        }

        // --- Order Modal Logic ---
        document.addEventListener("DOMContentLoaded", () => {
            const orderModal = document.getElementById("orderModal");
            const closeOrderModal = document.getElementById("closeOrderModal");
            const contentBox = document.getElementById("orderDetailsContent");

            // Event Delegation to handle buttons in both Desktop Table AND Mobile Cards
            document.body.addEventListener("click", (e) => {
                const btn = e.target.closest(".showVariantsBtn");
                if (btn) {
                    // Find nearest container with data (row for desktop, card for mobile)
                    const container = btn.closest("tr") || btn.closest(".bg-white[data-order]");
                    if (container && container.dataset.order) {
                        const order = JSON.parse(container.dataset.order);
                        
                        contentBox.innerHTML = `
                            <div class="space-y-6">
                                <div class="border rounded-lg p-4 bg-gray-50 shadow-sm">
                                    <h3 class="font-bold text-gray-800 text-lg mb-3 flex items-center gap-2">Summary</h3>
                                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-y-2 gap-x-4 text-sm">
                                        <p><span class="text-gray-500">Order ID:</span> <span class="font-medium text-gray-900">#${order.orderId}</span></p>
                                        <p><span class="text-gray-500">Date:</span> <span class="font-medium text-gray-900">${new Date(order.orderDate).toLocaleDateString("en-CA")}</span></p>
                                        <p><span class="text-gray-500">Status:</span> <span class="font-medium text-gray-900">${order.status}</span></p>
                                        <p><span class="text-gray-500">Payment:</span> <span class="font-medium text-gray-900">${order.paymentMethod}</span></p>
                                    </div>
                                </div>
                                <div class="flex flex-col sm:flex-row gap-4 items-start border rounded-lg p-4 bg-white">
                                    <img src="${order.coverImage}" class="w-20 h-20 object-cover rounded-md border border-gray-200" />
                                    <div>
                                        <h4 class="font-bold text-gray-900">${order.name}</h4>
                                        <p class="text-sm text-gray-500 mt-1">SKU: ${order.sku}</p>
                                        <p class="text-sm text-gray-500">Qty: ${order.quantity}</p>
                                    </div>
                                </div>
                                <div class="border rounded-lg p-4 bg-gray-50 shadow-sm">
                                    <div class="flex justify-between text-sm mb-1"><span>Subtotal</span> <span>₹${order.subtotal}</span></div>
                                    <div class="flex justify-between text-sm mb-2 pb-2 border-b border-gray-200"><span>Delivery</span> <span>₹${order.deliveryFee}</span></div>
                                    <div class="flex justify-between font-bold text-lg"><span>Total</span> <span>₹${order.totalAmount}</span></div>
                                </div>
                                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                                    <div class="p-4 border rounded-lg">
                                        <h3 class="font-bold text-gray-800 mb-2">Customer</h3>
                                        <p class="text-sm text-gray-600">${order.address.fullName}</p>
                                        <p class="text-sm text-gray-600">${order.address.phoneNumber}</p>
                                    </div>
                                    <div class="p-4 border rounded-lg">
                                        <h3 class="font-bold text-gray-800 mb-2">Shipping</h3>
                                        <p class="text-sm text-gray-600">${order.address.address}, ${order.address.city}</p>
                                        <p class="text-sm text-gray-600">${order.address.state} - ${order.address.pincode}</p>
                                    </div>
                                </div>
                                ${order.returnReason ? `<div class="p-4 border rounded-lg bg-red-50 text-red-700"><h3 class="font-bold mb-1">Return Request</h3><p class="text-sm">${order.returnReason}</p></div>` : ''}
                            </div>
                        `;
                        orderModal.classList.remove("hidden");
                    }
                }
            });

            closeOrderModal.addEventListener("click", () => orderModal.classList.add("hidden"));
            orderModal.addEventListener("click", (e) => { if(e.target === orderModal) orderModal.classList.add("hidden"); });

            // --- Status Modal Logic ---
            const statusModal = document.getElementById("statusModal");
            const statusSelect = document.getElementById("statusSelect");
            const cancelStatusBtn = document.getElementById("cancelModal");
            const confirmStatusBtn = document.getElementById("confirmStatus");
            let activeOrderId = null, activeSku = null;

            // Event Delegation for Edit Status Button
            document.body.addEventListener("click", (e) => {
                const btn = e.target.closest(".orderActionBtn");
                if (btn) {
                    activeOrderId = btn.dataset.id;
                    activeSku = btn.dataset.sku;
                    statusSelect.value = btn.dataset.status; 
                    statusModal.classList.remove("hidden");
                }
            });

            cancelStatusBtn.addEventListener("click", () => statusModal.classList.add("hidden"));
            statusModal.addEventListener("click", (e) => { if(e.target === statusModal) statusModal.classList.add("hidden"); });

            confirmStatusBtn.addEventListener("click", async () => {
                const newStatus = statusSelect.value;
                try {
                    const res = await fetch("/admin/orders/updateStatus", {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({ orderId: activeOrderId, sku: activeSku, status: newStatus })
                    });
                    const data = await res.json();
                    
                    if (data.success) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Updated!',
                            text: data.message,
                            confirmButtonColor: '#000'
                        }).then(() => location.reload());
                    } else {
                        Swal.fire("Error", data.message, "error");
                    }
                } catch (error) {
                    console.error(error);
                    Swal.fire("Error", "Something went wrong", "error");
                }
                statusModal.classList.add("hidden");
            });
        });
    </script>
</body>
</html>