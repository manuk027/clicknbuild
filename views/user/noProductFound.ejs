<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>clickNbuild</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/stylesheet/footer.css">
</head>

<body class="font-[Poppins] bg-gray-50 flex flex-col min-h-screen">

    <!-- Header -->
    <%- include("../../views/partials/user/header", { peripheral: peripheral, component: component, user: "manu" }) %>

    <!-- MAIN CONTENT -->
    <main class="flex-grow flex flex-col items-center justify-center text-center py-20 px-6">
        <h1 class="text-4xl font-semibold text-gray-800 mb-2">Product Not Found</h1>
        <p class="text-gray-500 mb-6">Sorry, we couldn’t find the product you’re looking for.</p>
        <a href="/" class="bg-black text-white px-6 py-2 rounded-md hover:bg-gray-800 transition">Back to Home</a>
    </main>

    <!-- Footer -->
     <%- include("../../views/partials/user/footer") %>

    <!-- Mobile menu script -->
    <script>
        const menuBtn = document.getElementById('menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');
        if (menuBtn && mobileMenu) {
            menuBtn.addEventListener('click', () => {
                mobileMenu.classList.toggle('hidden');
            });
        }
    </script>

</body>

</html>