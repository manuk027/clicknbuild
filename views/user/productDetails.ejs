<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%=product.brand.name + product.model%>
    </title>
    <link rel="icon" href="https://res.cloudinary.com/dmx7sia5q/image/upload/v1761540715/logo_dtmtfn.png" type="image/png">
    
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="https://unpkg.com/drift-zoom/dist/drift-basic.min.css" />
    <script src="https://unpkg.com/drift-zoom/dist/Drift.min.js"></script>
</head>

<body class="bg-white">
    
    <%- include("../../views/partials/user/header", { peripheral: peripheral, component: component, user: user }) %>

    <div class="container mx-auto px-4 py-8 lg:py-12 max-w-7xl">
        
        <span class="text-black font-medium mb-4 block">
            All Products/ <%=product.brand.name%> <%=product.model%> <%=product.variant%>
        </span>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 pt-3">
            
            <div class="flex flex-col-reverse sm:flex-row gap-4">
                <div class="flex flex-row sm:flex-col gap-3 sm:gap-4 overflow-x-auto sm:overflow-visible">
                    <% for(let i=0; i < product.images.length; i++) { %>
                        <img src="<%= product.images[i] %>" alt="Thumbnail <%= i+1 %>"
                            class="w-16 h-16 sm:w-20 sm:h-20 flex-shrink-0 object-cover border-2 border-blue-500 rounded cursor-pointer thumbnail"
                            data-index="<%= i %>" data-large="<%= product.images[i] %>">
                    <% } %>
                </div>

                <div class="flex-1 max-w-md relative overflow-hidden rounded-lg">
                    <img id="mainImage" src="<%= product.images[0] %>" data-zoom="<%= product.images[0] %>"
                        alt="<%=product.model%>"
                        class="w-full h-auto object-contain rounded-lg cursor-zoom-in">
                </div>
            </div>

            <div class="space-y-4">
                <h1 class="text-2xl sm:text-3xl lg:text-4xl font-semibold">
                    <%=product.brand.name%>
                </h1>
                <p class="text-gray-600 text-sm sm:text-base">
                    <%=product.model%>
                </p>

                <div class="text-3xl sm:text-4xl font-bold">₹<%=selectedVariant.offer%></div>
                <div class="text-xl sm:text-2xl line-through">₹<%=selectedVariant.price%></div>

                <div>
                    <label class="block text-sm font-medium mb-3">Choose Variant</label>
                    <div class="flex flex-wrap gap-3">
    <% for (let i = 0; i < product.variants.length; i++) { %>
        <a href="/product?id=<%= product._id %>&variant=<%= product.variants[i]._id %>"
           class="color-btn px-4 sm:px-6 py-2 text-sm sm:text-base border-2 rounded 
           <%= product.variants[i]._id.toString() === selectedVariant._id.toString()
                ? 'border-black bg-black text-white'
                : 'border-gray-300 bg-white text-gray-700' 
           %>">

            <%= product.variants[i].variant %>
        </a>
    <% } %>
</div>

                </div>

                <% if(selectedVariant.quantity <= 10 && selectedVariant.quantity >= 1) { %>
                    <div>
                        <p class="text-red-900">
                            <%=selectedVariant.quantity%> items left.
                        </p>
                    </div>
                <% } else if(selectedVariant.quantity === 0) { %>
                    <p class="text-red-900">
                        Product out of Stock.
                    </p>
                <% } %>

                <div class="flex flex-col sm:flex-row gap-3 sm:gap-4 pt-4">
                    <% if(selectedVariant.quantity > 0) { %>
                        <button id="add-to-cart-btn"
                            class="flex-1 bg-black text-white py-3 px-6 rounded-full hover:bg-gray-800 transition text-sm sm:text-base font-medium">
                            Add to Cart
                        </button>
                    <% } %>
                    
                    <button id="wishlist-btn"
                        onclick="addToWishlist('<%= product._id %>', '<%=selectedVariant._id %>')"
                        class="sm:w-auto p-3 border-2 rounded-full transition 
                        <%= wish.includes(selectedVariant._id.toString()) ? 'border-transparent text-red-500' : 'border-gray-300 hover:border-red-500 hover:text-red-500' %>">
                        <i class="<%= wish.includes(selectedVariant._id.toString()) ? 'fas fa-heart text-red-500' : 'far fa-heart text-gray-700' %> text-lg transition-all duration-300 ease-in-out"></i>
                    </button>
                </div>
            </div>
        </div>

        <div class="mt-12 lg:mt-16">
            <div class="border-b border-gray-200 overflow-x-auto">
                <div class="flex gap-6 sm:gap-8 min-w-max">
                    <button class="tab-btn pb-4 px-2 text-sm sm:text-base text-gray-600 border-b-2 border-transparent whitespace-nowrap"
                        data-tab="details">Product Details</button>
                    </div>
            </div>

            <div id="detailsTab" class="tab-content hidden py-6 sm:py-8">
                <p class="text-gray-700 text-sm sm:text-base">
                    <%=product.description%>
                </p>
                <table class="min-w-full divide-y divide-gray-200 mt-4">
                    <thead class="bg-gray-100">
                        <tr>
                            <th class="px-4 py-2 text-left text-sm font-medium text-gray-700">Feature</th>
                            <th class="px-4 py-2 text-left text-sm font-medium text-gray-700">Specification</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-200 bg-white">
                        <% for(let i=0; i<product.specification.length; i++){ %>
                            <tr>
                                <td class="px-4 py-2 text-sm text-gray-700">
                                    <%=product.specification[i].title%>
                                </td>
                                <td class="px-4 py-2 text-sm text-gray-700">
                                    <%=product.specification[i].details%>
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
            
            </div>

        <% 
            const shuffled = recommendedProducts.sort(() => 0.5 - Math.random());
            const randomProducts = shuffled.slice(0, 4);
        %>
        <div class="container mx-auto px-4 py-12 max-w-7xl">
            <h2 class="text-2xl sm:text-3xl font-semibold mb-8 text-gray-900">Recommended Products</h2>

            <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-6">
                <% recommendedProducts.forEach(p => { %>
                    <div class="border border-gray-200 rounded-xl overflow-hidden hover:shadow-lg transition">
                        <a href="/product?id=<%= p._id %>" class="block">
                            <img src="<%= p.images[0] %>" alt="<%= p.model %>"
                                class="w-full h-48 object-contain bg-gray-50 p-4">
                            <div class="p-4">
                                <h3 class="text-sm sm:text-base font-medium text-gray-800 truncate">
                                    <%= p.brand.name %> <%= p.model %>
                                </h3>
                                <div class="mt-1 flex items-center gap-2">
                                    <span class="text-lg sm:text-xl font-bold text-black">₹<%= p.variants[0].offer %></span>
                                    <span class="text-gray-500 text-sm line-through">₹<%= p.variants[0].price %></span>
                                </div>
                                <a href="/product?id=<%= p._id %>"
                                    class="mt-3 w-full bg-black text-white py-2 rounded-full text-sm hover:bg-gray-800 transition inline-block text-center">
                                    View Details
                                </a>
                            </div>
                        </a>
                    </div>
                <% }) %>
            </div>
        </div>

    </div>

    <%- include("../../views/partials/user/footer") %>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            
            // --- 1. Drift Zoom Logic ---
            const mainImage = document.getElementById("mainImage");
            
            let drift = new Drift(mainImage, {
                inlinePane: true,
                hoverBoundingBox: true,
                containInline: true,
                sourceAttribute: 'data-zoom',
                inlineOffsetY: 0,
                inlineOffsetX: 0
            });

            const thumbnails = document.querySelectorAll(".thumbnail");
            thumbnails.forEach((thumb) => {
                thumb.addEventListener("click", function () {
                    const largeSrc = this.dataset.large;
                    mainImage.src = largeSrc;
                    mainImage.setAttribute("data-zoom", largeSrc);

                    thumbnails.forEach(t => t.classList.remove("border-yellow-500"));
                    this.classList.add("border-yellow-500");

                    drift.destroy();
                    drift = new Drift(mainImage, {
                        inlinePane: true,
                        hoverBoundingBox: true,
                        containInline: true,
                        sourceAttribute: 'data-zoom'
                    });
                });
            });

            // --- 2. Color/Variant Button Selection ---
            const colorBtns = document.querySelectorAll(".color-btn");
            colorBtns.forEach(btn => {
                btn.addEventListener("click", () => {
                    colorBtns.forEach(b => {
                        b.classList.remove("border-black", "bg-black", "text-white");
                        b.classList.add("border-gray-300", "bg-white", "text-gray-700");
                    });
                    
                    if (btn === event.target) { // Logic based on original script, though page reload happens
                        btn.classList.add("border-black", "bg-black", "text-white");
                        btn.classList.remove("border-gray-300", "bg-white", "text-gray-700");
                    }
                });
            });

            // --- 3. Tab Switching ---
            const tabBtns = document.querySelectorAll('.tab-btn'); 
            const tabContents = document.querySelectorAll('.tab-content'); 
            
            tabBtns.forEach(btn => {
                btn.addEventListener('click', () => {
                    const tabName = btn.getAttribute('data-tab');

                    tabBtns.forEach(b => {
                        b.classList.remove('border-black', 'text-gray-900');
                        b.classList.add('border-transparent', 'text-gray-600');
                    });

                    btn.classList.add('border-black', 'text-gray-900');
                    btn.classList.remove('border-transparent', 'text-gray-600');

                    tabContents.forEach(content => content.classList.add('hidden'));
                    
                    const activeContent = document.getElementById(tabName + 'Tab');
                    if(activeContent) activeContent.classList.remove('hidden');
                });
            });

            // Set default active tab
            const detailsTab = document.getElementById('detailsTab');
            if(detailsTab) detailsTab.classList.remove('hidden');
            
            tabBtns.forEach(btn => {
                if (btn.getAttribute('data-tab') === 'details') {
                    btn.classList.add('border-black', 'text-gray-900');
                    btn.classList.remove('border-transparent', 'text-gray-600');
                }
            });

            // --- 4. Add To Cart Logic ---
            const addToCartBtn = document.getElementById("add-to-cart-btn");
            if (addToCartBtn) {
                addToCartBtn.addEventListener("click", async (event) => {
                    event.preventDefault();

                    const productId = "<%= product._id %>";
                    const variantId = "<%= selectedVariant._id %>";

                    try {
                        const response = await fetch("/cart/add", {
                            method: "POST",
                            headers: { "Content-Type": "application/json" },
                            body: JSON.stringify({ productId, variantId, quantity: 1 }),
                            credentials: "include",
                        });

                        const contentType = response.headers.get("content-type");

                        if (!contentType || !contentType.includes("application/json")) {
                            await Swal.fire({
                                icon: "warning",
                                title: "Login Required",
                                text: "Please log in to add items to your cart.",
                                confirmButtonColor: "#000000",
                            });
                            window.location.href = "/login";
                            return;
                        }

                        if (response.status === 401) {
                            await Swal.fire({
                                icon: "warning",
                                title: "Login Required",
                                text: "Please log in to continue shopping.",
                                confirmButtonColor: "#000000",
                            });
                            window.location.href = "/login";
                            return;
                        }

                        const data = await response.json();

                        if (data.success) {
                            await Swal.fire({
                                icon: "success",
                                title: "Added to Cart!",
                                text: data.message || "Product added to cart successfully.",
                                confirmButtonColor: "#000000",
                                confirmButtonText: "OK",
                            });
                            window.location.reload();
                        } else {
                            await Swal.fire({
                                icon: "warning",
                                title: "Could Not Add Product",
                                text: data.message || "Something went wrong. Please try again.",
                                confirmButtonColor: "#000000",
                            });
                        }

                    } catch (error) {
                        console.error(" Error adding to cart:", error);
                        await Swal.fire({
                            icon: "error",
                            title: "Server Error",
                            text: "Unable to connect to the server. Please try again later.",
                            confirmButtonColor: "#000000",
                        });
                    }
                });
            }
        });

        // --- 5. Wishlist Logic ---
        async function addToWishlist(productId, variantId, index) {
            try {
                const response = await fetch("/wishlist/add", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ productId, variantId }),
                    credentials: "include",
                });

                const contentType = response.headers.get("content-type");

                if (!contentType || !contentType.includes("application/json")) {
                    await Swal.fire({
                        icon: "warning",
                        title: "Login Required",
                        text: "Please log in to add items to your wishlist.",
                        confirmButtonColor: "#000000",
                    });
                    window.location.href = "/login";
                    return;
                }

                if (response.status === 401) {
                    await Swal.fire({
                        icon: "warning",
                        title: "Login Required",
                        text: "Please log in to continue shopping.",
                        confirmButtonColor: "#000000",
                    });
                    window.location.href = "/login";
                    return;
                }

                const data = await response.json();

                if (data.success) {
                    if (data.added) {
                        await Swal.fire({
                            icon: "success",
                            title: "Added to wishlist!",
                            text: data.message || "Product added to wishlist successfully.",
                            confirmButtonColor: "#000000",
                        });

                        const button = document.getElementById('wishlist-btn');
                        const icon = button.querySelector('i');
                        icon.classList.remove('far', 'text-black');
                        icon.classList.add('fas', 'text-red-500');
                        button.classList.remove('border-2', 'border-gray-300', 'hover:border-red-500', 'hover:text-red-500');
                        button.classList.add('bg-white', 'text-red-500', 'border-transparent');

                    } else {
                        await Swal.fire({
                            icon: "warning",
                            title: "Removed from wishlist!",
                            text: data.message || "Product removed from wishlist successfully.",
                            confirmButtonColor: "#000000",
                        });

                        const button = document.getElementById('wishlist-btn');
                        const icon = button.querySelector('i');
                        icon.classList.remove('fas', 'text-red-500');
                        icon.classList.add('far', 'text-black');
                        button.classList.remove('bg-white', 'border-transparent', 'text-red-500');
                        button.classList.add('border-2', 'border-gray-300', 'hover:border-red-500', 'hover:text-red-500');
                    }

                } else {
                    await Swal.fire({
                        icon: "warning",
                        title: "Could Not Add Product",
                        text: data.message || "Something went wrong. Please try again.",
                        confirmButtonColor: "#000000",
                    });
                }

            } catch (error) {
                console.error(" Error adding to wishlist:", error);
                await Swal.fire({
                    icon: "error",
                    title: "Server Error",
                    text: "Unable to connect to the server. Please try again later.",
                    confirmButtonColor: "#000000",
                });
            }
        };
    </script>
</body>

</html>