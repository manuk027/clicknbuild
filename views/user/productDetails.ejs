<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%=product.brand.name + product.model%>
    </title>
    <link rel="icon" href="https://res.cloudinary.com/dmx7sia5q/image/upload/v1761540715/logo_dtmtfn.png"
        type="image/png">
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="https://unpkg.com/drift-zoom/dist/drift-basic.min.css" />

</head>

<body class="bg-white">
    <%- include("../../views/partials/user/header", { peripheral: peripheral, component: component, user: user }) %>

        <!-- Main Product Section -->
        <div class="container mx-auto px-4 py-8 lg:py-12 max-w-7xl">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12">
                <!-- Left Side - Product Images -->
                <div class="flex flex-col-reverse sm:flex-row gap-4">
                    <!-- Thumbnail Column -->
                    <div class="flex flex-row sm:flex-col gap-3 sm:gap-4 overflow-x-auto sm:overflow-visible">
                        <% for(let i=0; i < product.images.length; i++) { %>
                            <img src="<%= product.images[i] %>" alt="Thumbnail <%= i+1 %>"
                                class="w-16 h-16 sm:w-20 sm:h-20 flex-shrink-0 object-cover border-2 border-blue-500 rounded cursor-pointer thumbnail"
                                data-index="<%= i %>" data-large="<%= product.images[i] %>">
                            <% } %>
                    </div>

                    <!-- Main Image Container -->
                    <div class="flex-1 max-w-md relative overflow-hidden rounded-lg">
                        <img id="mainImage" src="<%= product.images[0] %>" data-zoom="<%= product.images[0] %>"
                            alt="Cooler Master Hyper 620 S"
                            class="w-full h-auto object-contain rounded-lg cursor-zoom-in">
                    </div>
                </div>


                <script src="https://unpkg.com/drift-zoom/dist/Drift.min.js"></script>
                <script>
                    document.addEventListener("DOMContentLoaded", function () {
                        const mainImage = document.getElementById("mainImage");

                        // Initialize Drift for inline zoom
                        let drift = new Drift(mainImage, {
                            inlinePane: true,        // zoom inside the image container
                            hoverBoundingBox: true,  // shows lens overlay
                            containInline: true,     // keeps zoom inside container
                            sourceAttribute: 'data-zoom',
                            inlineOffsetY: 0,        // adjust vertical position if needed
                            inlineOffsetX: 0         // adjust horizontal position if needed
                        });

                        // Handle thumbnail clicks
                        const thumbnails = document.querySelectorAll(".thumbnail");
                        thumbnails.forEach((thumb) => {
                            thumb.addEventListener("click", function () {
                                const largeSrc = this.dataset.large;

                                // Update main image and zoom source
                                mainImage.src = largeSrc;
                                mainImage.setAttribute("data-zoom", largeSrc);

                                // Optional: highlight active thumbnail
                                thumbnails.forEach(t => t.classList.remove("border-yellow-500"));
                                this.classList.add("border-yellow-500");

                                // Reinitialize Drift
                                drift.destroy();
                                drift = new Drift(mainImage, {
                                    inlinePane: true,
                                    hoverBoundingBox: true,
                                    containInline: true,
                                    sourceAttribute: 'data-zoom'
                                });
                            });
                        });
                    });
                </script>




                <!-- Right Side - Product Details -->
                <div class="space-y-4">
                    <h1 class="text-2xl sm:text-3xl lg:text-4xl font-semibold">
                        <%=product.brand.name%>
                    </h1>
                    <p class="text-gray-600 text-sm sm:text-base">
                        <%=product.model%>
                    </p>

                    <!-- Rating -->
                    <div class="flex items-center gap-2">
                        <div class="flex text-yellow-400 text-sm sm:text-base">
                            <i class="fas fa-star"></i>
                            <i class="fas fa-star"></i>
                            <i class="fas fa-star"></i>
                            <i class="fas fa-star"></i>
                            <i class="fas fa-star-half-alt"></i>
                        </div>
                        <span class="text-gray-600 text-sm sm:text-base">(125)</span>
                    </div>

                    <!-- Price -->
                    <div class="text-3xl sm:text-4xl font-bold">₹<%=product.variants[index].offer%>
                    </div>
                    <div class="text-xl sm:text-2xl  line-through">₹<%=product.variants[index].price%>
                    </div>

                    <!-- Color Selection -->
                    <div>
                        <label class="block text-sm font-medium mb-3">Choose Variant</label>
                        <div class="flex flex-wrap gap-3">
                            <% for (let i=0; i < product.variants.length; i++) { %>
                                <a href="/product?id=<%= product._id %>&variant=<%= i %>" class="color-btn px-4 sm:px-6 py-2 text-sm sm:text-base border-2 rounded 
         <%= i === index ? 'border-black bg-black text-white' : 'border-gray-300 bg-white text-gray-700' %>">
                                    <%= product.variants[i].variant %>
                                </a>
                                <% } %>
                        </div>
                    </div>


                    <script>
                        document.addEventListener("DOMContentLoaded", function () {
                            const colorBtns = document.querySelectorAll(".color-btn");

                            // Change selection color on click
                            function selectButton(selectedBtn) {
                                colorBtns.forEach(btn => {
                                    if (btn === selectedBtn) {
                                        btn.classList.add("border-black", "bg-black", "text-white");
                                        btn.classList.remove("border-gray-300", "bg-white", "text-gray-700");
                                    } else {
                                        btn.classList.remove("border-black", "bg-black", "text-white");
                                        btn.classList.add("border-gray-300", "bg-white", "text-gray-700");
                                    }
                                });
                            }

                            // Click listener for all buttons
                            colorBtns.forEach(btn => {
                                btn.addEventListener("click", () => selectButton(btn));
                            });
                        });
                    </script>






                    <%if(product.variants[index].quantity<=10 && product.variants[index].quantity>=1){%>
