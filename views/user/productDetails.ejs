                                <i class="fas fa-sliders-h text-sm"></i>
                            </button>
                            <select class="px-3 sm:px-4 py-2 text-sm sm:text-base border border-gray-300 rounded-full">
                                <option>Latest</option>
                                <option>Highest Rating</option>
