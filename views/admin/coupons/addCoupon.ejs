<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Add Coupon</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>

<body class="bg-gray-50">
    <div class="flex min-h-screen">

        <!-- Sidebar -->
        <aside class="w-full sm:w-64 bg-white shadow-lg fixed lg:static left-0 top-0 h-screen z-40 overflow-y-auto">
            <%- include("../../views/partials/admin/sidebar") %>
        </aside>

        <!-- Main content -->
        <div class="flex-1 flex flex-col min-h-screen">
            <header class="bg-white shadow-sm sticky top-0 z-30">
                <%- include("../../views/partials/admin/header") %>
            </header>

            <main class="p-6">
                <h1 class="text-2xl font-bold text-gray-800 mb-6">ADD COUPON</h1>

                <nav class="flex items-center gap-2 text-sm text-gray-500 mb-6">
                    <a href="/admin" class="hover:text-gray-700">Dashboard</a>
                    <i class="fas fa-chevron-right text-xs"></i>
                    <a href="/admin/coupons" class="hover:text-gray-700">Coupons</a>
                    <i class="fas fa-chevron-right text-xs"></i>
                    <span class="text-gray-700">Add</span>
                </nav>

                <!-- Form -->
                <form id="couponForm" action="/admin/coupons/addCoupons" method="POST" class="bg-white shadow p-6 rounded-lg">

                    <!-- Grid layout (2 columns) -->
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

                        <!-- Coupon Name -->
                        <div>
                            <label class="block mb-1 font-medium text-gray-700">Coupon Name</label>
                            <input type="text" name="couponName"
                                class="w-full border px-3 py-2 rounded focus:ring focus:ring-blue-300"
                                placeholder="Enter coupon name" />
                            <p class="text-red-500 text-sm hidden" id="couponNameError">Coupon name is required.</p>
                        </div>

                        <!-- Coupon Code -->
                        <div>
                            <label class="block mb-1 font-medium text-gray-700">Coupon Code</label>
                            <input type="text" name="couponCode"
                                class="w-full border px-3 py-2 rounded focus:ring focus:ring-blue-300"
                                placeholder="Enter coupon code" />
                            <p class="text-red-500 text-sm hidden" id="couponCodeError">Coupon code is required.</p>
                        </div>

                        <!-- Discount -->
                        <div>
                            <label class="block mb-1 font-medium text-gray-700">Discount (%)</label>
                            <input type="number" name="discount"
                                class="w-full border px-3 py-2 rounded focus:ring focus:ring-blue-300"
                                placeholder="Enter discount percentage" />
                            <p class="text-red-500 text-sm hidden" id="discountError">Valid discount is required.</p>
                        </div>

                        <!-- Minimum Purchase -->
                        <div>
                            <label class="block mb-1 font-medium text-gray-700">Minimum Purchase (₹)</label>
                            <input type="number" name="minPurchase"
                                class="w-full border px-3 py-2 rounded focus:ring focus:ring-blue-300"
                                placeholder="Enter minimum purchase amount" />
                            <p class="text-red-500 text-sm hidden" id="minPurchaseError">Minimum purchase required.</p>
                        </div>

                    </div>

                    <!-- List / Unlist -->
                    <div class="mt-6">
                        <label class="block mb-2 font-medium text-gray-700">Status</label>

                        <div class="flex gap-8">
                            <label class="flex items-center gap-2">
                                <input type="radio" name="status" value="listed" checked class="w-4 h-4 text-blue-600">
                                <span>List</span>
                            </label>

                            <label class="flex items-center gap-2">
                                <input type="radio" name="status" value="unlisted" class="w-4 h-4 text-blue-600">
                                <span>Unlist</span>
                            </label>
                        </div>
                    </div>

                    <!-- Buttons -->
                    <div class="mt-8 flex gap-4">
                        <button type="submit" class="px-6 py-3 bg-black text-white rounded hover:bg-gray-800">
                            Add Coupon
                        </button>

                        <a href="/admin/coupons" class="px-6 py-3 border rounded text-gray-700 hover:bg-gray-100">
                            Cancel
                        </a>
                    </div>

                </form>
            </main>
        </div>
    </div>

    <!-- JS -->
    <script>
        const form = document.getElementById("couponForm");

        form.addEventListener("submit", (e) => {
            let valid = true;

            const couponName = form.couponName;
            const couponCode = form.couponCode;
            const discount = form.discount;
            const minPurchase = form.minPurchase;

            // Reset errors
            document.querySelectorAll("p.text-red-500").forEach(el => el.classList.add("hidden"));

            // Validation
            if (couponName.value.trim() === "") {
                document.getElementById("couponNameError").classList.remove("hidden");
                valid = false;
            }
            if (couponCode.value.trim() === "") {
                document.getElementById("couponCodeError").classList.remove("hidden");
                valid = false;
            }
            if (discount.value.trim() === "" || discount.value < 1) {
                document.getElementById("discountError").classList.remove("hidden");
                valid = false;
            }
            if (minPurchase.value.trim() === "" || minPurchase.value < 1) {
                document.getElementById("minPurchaseError").classList.remove("hidden");
                valid = false;
            }

            if (!valid) e.preventDefault();
        });
    </script>

</body>

</html>