<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>clickNbuild</title>
  <link rel="icon" href="https://res.cloudinary.com/dmx7sia5q/image/upload/v1761540715/logo_dtmtfn.png"
    type="image/png">
  <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-50 text-black flex flex-col min-h-screen">

  <!-- Main Content -->
  <main class="flex-1 flex flex-col justify-center items-center text-center px-4 sm:px-6 lg:px-8 py-16">
    <h1 class="text-[120px] sm:text-[140px] font-extrabold mb-6 tracking-widest">
      <%= statusCode ? statusCode : "500" %>
    </h1>
    <p class="text-lg sm:text-xl text-gray-600 mb-8">
      <%= message ?? "Internal Error Occurred" %>
    </p>
    <a href="/"
      class="bg-black text-white px-6 sm:px-8 py-3 rounded-md font-medium hover:bg-gray-800 transition-colors">
      Back to Home
    </a>
  </main>

</body>

</html>