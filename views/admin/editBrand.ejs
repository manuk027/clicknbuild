<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Edit Brand - Admin Dashboard</title>
  <link rel="icon" href="https://res.cloudinary.com/dmx7sia5q/image/upload/v1761540715/logo_dtmtfn.png" type="image/png">
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
  <!-- Cropper.js -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.css" />
</head>

<body class="bg-gray-50">
  <div class="flex min-h-screen">
    <!-- Sidebar -->
    <%- include("../../views/partials/admin/sidebar") %>

    <!-- Main Content -->
    <div class="flex-1 flex flex-col min-h-screen">
      <!-- Header -->
      <%- include("../../views/partials/admin/header") %>

      <!-- Page Content -->
      <main class="flex-1 p-4 sm:p-6 lg:p-8">
        <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-2">EDIT BRAND</h2>
        <div class="flex items-center gap-2 text-sm text-gray-600 mb-6">
          <a href="/admin" class="hover:text-gray-800">Dashboard</a>
          <i class="fas fa-chevron-right text-xs"></i>
          <a href="/admin/brands" class="hover:text-gray-800">Brands</a>
          <i class="fas fa-chevron-right text-xs"></i>
          <span class="text-gray-900">Edit</span>
        </div>

        <!-- Edit Form -->
        <form id="editBrandForm" enctype="multipart/form-data">
          <!-- Brand Name -->
          <div class="bg-white rounded-lg shadow-sm p-6 mb-6">
            <label for="brandName" class="block text-sm font-medium text-gray-700 mb-2">Brand Name</label>
            <input type="text" id="brandName" name="brandName" value="<%= brand.name %>"
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-gray-900 text-sm sm:text-base"
              placeholder="Enter brand name...">
            <p id="brandName-error" class="error-message text-red-500 text-sm mt-1 hidden"></p>
          </div>

          <!-- Brand Image -->
          <div class="bg-white rounded-lg shadow-sm p-6 mb-6">
            <h2 class="text-lg font-semibold text-gray-800 mb-4">Brand Image</h2>

            <input type="file" name="brandImage" id="brandImageInput" accept="image/*" class="hidden">

            <!-- Upload box -->
            <div id="uploadContainer"
              class="border-2 border-dashed border-gray-300 rounded-lg p-12 text-center bg-gray-50 hover:border-blue-400 transition cursor-pointer <%= brand.image ? 'hidden' : '' %>">
              <i class="fas fa-image text-4xl text-blue-400 mb-2"></i>
              <p class="text-sm text-gray-500 mb-3">Drag and drop or click to upload</p>
              <button type="button" id="uploadBtn"
                class="px-6 py-2 bg-blue-100 text-blue-600 rounded-lg text-sm hover:bg-blue-200 transition">Add
                Image</button>
            </div>

            <!-- Preview -->
            <div id="previewContainer"
              class="mt-4 relative w-48 h-48 <%= brand.image ? '' : 'hidden' %>">
              <img id="previewImage" src="<%= brand.image %>"
                class="w-full h-full object-cover rounded-lg border border-gray-300" />
              <button type="button" id="removeImageBtn"
                class="absolute top-0 right-0 bg-red-600 text-white w-6 h-6 rounded-full flex items-center justify-center hover:bg-red-700">
                &times;
              </button>
            </div>
          </div>

          <!-- Cropper Modal -->
          <div id="cropModal"
            class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center hidden z-50">
            <div class="bg-white p-4 rounded-lg w-96 h-96 relative flex flex-col">
              <h3 class="text-lg font-semibold mb-2">Crop Image</h3>
              <div class="flex-1 overflow-hidden">
                <img id="cropperImage" class="w-full h-full object-contain" />
              </div>
              <div class="flex justify-end gap-2 mt-2">
                <button id="cropModalCancel"
                  class="px-4 py-2 bg-gray-300 text-gray-700 rounded-lg">Cancel</button>
                <button id="cropModalConfirm"
                  class="px-4 py-2 bg-blue-600 text-white rounded-lg">Crop</button>
              </div>
            </div>
          </div>

          <!-- Submit -->
          <div class="flex justify-end pt-4">
            <button type="submit"
              class="px-6 sm:px-8 py-2.5 sm:py-3 bg-black text-white rounded-lg hover:bg-gray-800 transition font-medium text-sm sm:text-base">
              Update Brand
            </button>
          </div>
        </form>
      </main>
    </div>
  </div>

  <!-- JS Libraries -->
  <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.js"></script>

  <script>
    const uploadBtn = document.getElementById("uploadBtn");
    const brandImageInput = document.getElementById("brandImageInput");
    const previewContainer = document.getElementById("previewContainer");
    const previewImage = document.getElementById("previewImage");
    const removeImageBtn = document.getElementById("removeImageBtn");
    const uploadContainer = document.getElementById("uploadContainer");

    // Cropper Modal Elements
    const cropModal = document.getElementById("cropModal");
    const cropperImage = document.getElementById("cropperImage");
    const cropModalConfirm = document.getElementById("cropModalConfirm");
    const cropModalCancel = document.getElementById("cropModalCancel");

    let cropper;

    // Open file picker
    uploadBtn?.addEventListener("click", (e) => {
      e.stopPropagation();
      brandImageInput.click();
    });
    uploadContainer?.addEventListener("click", () => brandImageInput.click());

    // Handle image selection
    brandImageInput.addEventListener("change", (e) => {
      const file = e.target.files[0];
      if (!file) return;

      const reader = new FileReader();
      reader.onload = () => {
        cropperImage.src = reader.result;
        cropModal.classList.remove("hidden");

        if (cropper) cropper.destroy();
        cropper = new Cropper(cropperImage, {
          aspectRatio: 1,
          viewMode: 1,
          movable: true,
          zoomable: true,
        });
      };
      reader.readAsDataURL(file);
    });

    // Confirm crop
    cropModalConfirm.addEventListener("click", () => {
      if (!cropper) return;
      cropper.getCroppedCanvas().toBlob((blob) => {
        const file = new File([blob], brandImageInput.files[0].name, { type: "image/png" });

        const dataTransfer = new DataTransfer();
        dataTransfer.items.add(file);
        brandImageInput.files = dataTransfer.files;

        previewImage.src = URL.createObjectURL(file);
        previewContainer.classList.remove("hidden");
        uploadContainer.classList.add("hidden");

        cropper.destroy();
        cropModal.classList.add("hidden");
      });
    });

    cropModalCancel.addEventListener("click", () => {
      cropper.destroy();
      cropModal.classList.add("hidden");
      brandImageInput.value = "";
    });

    // Remove image
    removeImageBtn.addEventListener("click", () => {
      brandImageInput.value = "";
      previewImage.src = "";
      previewContainer.classList.add("hidden");
      uploadContainer.classList.remove("hidden");
    });

    // AJAX form submit
    $("#editBrandForm").submit(function (e) {
      e.preventDefault();

      const brandName = $("#brandName").val().trim();
      if (!brandName) {
        Swal.fire("Error", "Please enter a brand name", "error");
        return;
      }

      const formData = new FormData(this);

      $.ajax({
        url: "/admin/brands/editBrand?id=<%= brand._id %>",
        type: "POST",
        data: formData,
        processData: false,
        contentType: false,
        success: function (response) {
          if (response.success) {
            Swal.fire({
              icon: "success",
              title: response.message,
              showConfirmButton: false,
              timer: 1200
            }).then(() => {
              window.location.href = response.redirectUrl;
            });
          } else {
            Swal.fire("Error", response.message, "error");
          }
        },
        error: function (xhr) {
          Swal.fire("Error", "Something went wrong while updating brand", "error");
        }
      });
    });
  </script>
</body>

</html>
