<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Order Confirmation - clickNbuild</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-50 min-h-screen">
    <!-- Main Container -->
    <%- include("../../views/partials/user/header", { peripheral: peripheral, component: component, user: user }) %>
        <div class="container mx-auto px-4 py-8 lg:py-16">
            <div class="max-w-6xl mx-auto bg-white rounded-lg shadow-sm p-6 lg:p-12">
                <!-- Desktop Layout -->
                <div class="lg:grid lg:grid-cols-2 lg:gap-12">
                    <!-- Left Section -->
                    <div class="mb-8 lg:mb-0">
                        <h1 class="text-3xl lg:text-4xl font-bold text-gray-900 mb-4">Thank You for Your Order!</h1>
                        <p class="text-gray-700 mb-8">Your order has been successfully placed. Here are your order
                            details:
                        </p>
                        <div class="flex justify-center mb-8">
                            <div class="relative">
                                <svg class="w-64 h-64 lg:w-80 lg:h-80" viewBox="0 0 400 400" fill="none"
                                    xmlns="http://www.w3.org/2000/svg">
                                    <circle cx="200" cy="200" r="150" fill="#E0F2FE" opacity="0.5" />
                                    <rect x="180" y="120" width="140" height="200" rx="10" fill="#BFDBFE" />
                                    <rect x="190" y="130" width="120" height="160" rx="5" fill="#60A5FA" />
                                    <rect x="80" y="100" width="100" height="70" rx="8" fill="#93C5FD" opacity="0.8" />
                                    <rect x="90" y="110" width="80" height="50" rx="4" fill="#3B82F6" />
                                    <rect x="100" y="130" width="20" height="15" rx="2" fill="#FCA5A5" />
                                    <ellipse cx="120" cy="280" rx="60" ry="40" fill="#FBBF24" opacity="0.3" />
                                    <path d="M60 260 Q80 240 100 250 L100 300 Q90 310 70 300 Z" fill="#FCD34D" />
                                    <rect x="100" y="240" width="80" height="60" rx="10" fill="#FDE68A" />
                                    <rect x="110" y="260" width="70" height="45" rx="4" fill="#3B82F6" />
                                    <rect x="115" y="280" width="30" height="4" rx="2" fill="#1E40AF" />
                                    <circle cx="270" cy="240" r="20" fill="#FCA5A5" />
                                    <rect x="255" y="260" width="30" height="50" rx="5" fill="#FBBF24" />
                                    <rect x="250" y="280" width="15" height="30" fill="#F59E0B" />
                                    <rect x="270" y="280" width="15" height="30" fill="#F59E0B" />
                                    <circle cx="300" cy="140" r="35" fill="#FCD34D" />
                                    <path d="M285 140 L295 150 L315 130" stroke="white" stroke-width="6"
                                        stroke-linecap="round" stroke-linejoin="round" fill="none" />
                                </svg>
                            </div>
                        </div>

                        <p class="text-center text-gray-600 mb-8">You will receive an email confirmation shortly with
                            the
                            details of your order.</p>
                        <div class="flex flex-col sm:flex-row gap-4 justify-center">
                            <a href="/orders" class="px-6 py-3 bg-blue-400 text-white rounded-lg hover:bg-blue-500 transition">
                                View Orders
                            </a>
                            <a href="/shop"
                                class="px-6 py-3 bg-white border-2 border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 transition">
                                CONTINUE SHOPPING
                            </a>
                        </div>
                    </div>
                    <div class="lg:flex lg:flex-col lg:justify-start">
                        <div class="flex justify-center lg:justify-end mb-6">
                            <div class="flex flex-col items-center">
                                <div class="w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mb-3">
                                    <svg class="w-8 h-8 text-green-600" fill="none" stroke="currentColor"
                                        viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3"
                                            d="M5 13l4 4L19 7"></path>
                                    </svg>
                                </div>
                                <h2 class="text-xl font-semibold text-gray-700">Payment Success!</h2>
                            </div>
                        </div>

                        <hr class="my-6 border-gray-200">
                        <div class="space-y-6">
                            <div class="flex justify-between items-center">
                                <span class="text-gray-600">Order Id</span>
                                <span class="font-semibold text-gray-900">
                                    <%=order.orderId%>
                                </span>
                            </div>

                            <div class="flex justify-between items-center">
                                <span class="text-gray-600">Order Date</span>
                                <span class="font-semibold text-gray-900">
                                    <%=order.orderDate.toLocaleDateString("en-CA")%>
                                </span>
                            </div>

                            <div class="flex justify-between items-center">
                                <span class="text-gray-600">Payment Method</span>
                                <span class="font-semibold text-gray-900">
                                    <%=order.paymentMethod%>
                                </span>
                            </div>

                            <div class="flex justify-between items-center">
                                <span class="text-gray-600">Sender Name</span>
                                <span class="font-semibold text-gray-900">
                                    <%=order.address.fullName%>
                                </span>
                            </div>

                            <hr class="border-gray-200">

                            <div class="flex justify-between items-center">
                                <span class="text-gray-600">Amount</span>
                                <span class="font-bold text-xl text-gray-900">₹ <%=order.totalAmount%></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <script>
document.addEventListener("DOMContentLoaded", () => {
    // Prevent back
    history.pushState({ page: "summary" }, "", "");

    window.addEventListener("popstate", function (event) {
        // When user clicks Back:
        history.pushState({ page: "summary" }, "", "");
    });
});
</script>



        <!-- Footer -->
        <%- include("../../views/partials/user/footer") %>
</body>

</html>