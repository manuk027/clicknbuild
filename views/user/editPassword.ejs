<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>User Profile</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

</head>

<body class="bg-gray-50">
    <%- include("../../views/partials/user/header", { peripheral: peripheral, component: component, user: user }) %>
        <!-- Mobile Sidebar Toggle Button (visible only on mobile) -->
        <div class="lg:hidden fixed top-4 left-4 z-50">
            <button id="mobileSidebarBtn" class="bg-white p-2 rounded-lg shadow-md">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16">
                    </path>
                </svg>
            </button>
        </div>

        <!-- Sidebar Overlay (mobile only) -->
        <div id="sidebarOverlay" class="hidden fixed inset-0 bg-black bg-opacity-50 z-40 lg:hidden"></div>

        <div class="flex min-h-screen">
            <!-- Sidebar -->

            <%- include("../../views/partials/user/sidebar")%>

                <!-- Main Content -->
                <main class="flex-1 p-4 md:p-6 lg:p-8">
                    <!-- Breadcrumb -->
                    <div class="mb-6">
                        <a href="/profile" class="text-gray-600 hover:text-black text-sm">Account </a>
                        <a href="/profile" class="text-gray-600 hover:text-black text-sm"> &gt; <%=breadcrumbs%></a>
                        <a href="/profile" class="text-gray-600 hover:text-black text-sm"> &gt; Change Password </a>
                    </div>

                    <!-- Profile Card -->
                    <div class="bg-white rounded-lg shadow-lg p-6 md:p-8 lg:p-10 max-w-4xl">
                        <!-- Welcome Header -->
                        <h1 class="text-2xl md:text-3xl font-light text-center mb-8">Change Password
                        </h1>

                        <!-- Profile Form -->
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">Old Password</label>
                            <input id="oldPassword" type="text" placeholder="Old password"
                                class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-black focus:border-transparent">
                            <p id="oldWarning" class="text-red-500 text-sm mt-1"></p>
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">New Password</label>
                            <input id="newPassword" type="text" placeholder="Old password"
                                class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-black focus:border-transparent">
                            <p id="newWarning" class="text-red-500 text-sm mt-1"></p>
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">Confirm New Password</label>
                            <input id="confirmPassword" type="text" placeholder="Old password"
                                class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-black focus:border-transparent">
                            <p id="confirmWarning" class="text-red-500 text-sm mt-1"></p>
                        </div>

                        <div class="flex flex-col sm:flex-row gap-4 pt-6">
                            <button id="changePasswordBtn" type="button"
                                class="flex-1 bg-black text-white text-center py-3 px-6 rounded-lg font-medium hover:bg-gray-800 transition-colors">
                                SAVE
                            </button>
                        </div>


                    </div>
                </main>
        </div>
        <%- include("../../views/partials/user/footer")%>

            <script>
                // Mobile Sidebar Toggle
                const mobileSidebarBtn = document.getElementById('mobileSidebarBtn');
                const sidebarOverlay = document.getElementById('sidebarOverlay');
                const userSidebar = document.getElementById('userSidebar');

                mobileSidebarBtn.addEventListener('click', () => {
                    userSidebar.classList.remove('hidden');
                    userSidebar.classList.add('fixed', 'inset-y-0', 'left-0', 'z-50', 'overflow-y-auto', 'w-80');
                    sidebarOverlay.classList.remove('hidden');
                });

                sidebarOverlay.addEventListener('click', () => {
                    userSidebar.classList.add('hidden');
                    userSidebar.classList.remove('fixed', 'inset-y-0', 'left-0', 'z-50', 'overflow-y-auto', 'w-80');
                    sidebarOverlay.classList.add('hidden');

                    // Restore desktop visibility
                    if (window.innerWidth >= 1024) {
                        userSidebar.classList.remove('hidden');
                    }
                });

                // Handle window resize
                window.addEventListener('resize', () => {
                    if (window.innerWidth >= 1024) {
                        userSidebar.classList.remove('hidden', 'fixed', 'inset-y-0', 'left-0', 'z-50', 'overflow-y-auto', 'w-80');
                        sidebarOverlay.classList.add('hidden');
                    }
                });
            </script>
            <script>
                document.addEventListener("DOMContentLoaded", () => {
                    const saveBtn = document.getElementById("changePasswordBtn");

                    saveBtn.addEventListener("click", async () => {
                        const oldPassword = document.getElementById("oldPassword").value.trim();
                        const newPassword = document.getElementById("newPassword").value.trim();
                        const confirmPassword = document.getElementById("confirmPassword").value.trim();
                        document.getElementById("oldWarning").innerText = "";
                        document.getElementById("newWarning").innerText = "";
                        document.getElementById("confirmWarning").innerText = "";
                        let isValid = true;
                        if (!oldPassword) {
                            document.getElementById("oldWarning").innerText = "Old password is required.";
                            isValid = false;
                        }

                        if (!newPassword) {
                            document.getElementById("newWarning").innerText = "Enter the new password.";
                            isValid = false;
                        } else if (!/^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[^\w\s])[^\s]{8,}$/) {
                            document.getElementById("newWarning").innerText = "Password should have atleast one capital letter, one small letter, one symbol, one number and there should be 8 chatacters";
                            isValid = false;
                        }

                        if (!confirmPassword) {
                            document.getElementById("confirmWarning").innerText = "Confirm the new password";
                            isValid = false;
                        }

                        if (newPassword !== confirmPassword) {
                            document.getElementById('confirmWarning').innerText = "Password does not match."
                            isValid = false;
                        }


                        if (!isValid) return;
                        const formData = { oldPassword, newPassword };
                        try {
                            const res = await fetch("/editPassword", {
                                method: "PUT",
                                headers: { "Content-Type": "application/json" },
                                body: JSON.stringify(formData),
                            })
                            const data = await res.json();

                            if (data.success) {
                                Swal.fire({
                                    icon: "success",
                                    title: "Profile updated!",
                                    text: "Your password has been successfully updated.",
                                    confirmButtonColor: "#3085d6",
                                    confirmButtonText: "Ok",
                                }).then(() => {
                                    window.location.href = "/profile"; 
                                });
                            } else {
                                Swal.fire({
                                    icon: "warning",
                                    title: "password not updated!",
                                    text: data.message || "Your password has not been updated.",
                                    confirmButtonColor: "#3085d6",
                                });
                            }
                        } catch (error) {
                            console.error("Error updating the password", error);
                            Swal.fire({
                                icon: "error",
                                title: "Server Error.",
                                text: "Unable to connect to the server. Please try again later.",
                                confirmButtonColor: "#3085d6",
                            });
                        }
                    });
                });
            </script>


</body>

</html>