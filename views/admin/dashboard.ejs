<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>CB Dashboard</title>
  <link rel="icon" href="https://res.cloudinary.com/dmx7sia5q/image/upload/v1761540715/logo_dtmtfn.png"
    type="image/png">
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>


</head>

<body class="bg-gray-50">
  <div class="flex flex-col lg:flex-row h-screen bg-gray-50">
    <aside id="sidebar"
      class="fixed left-0 top-0 h-screen w-64 bg-white overflow-y-auto sticky shadow-lg z-40 transform -translate-x-full lg:translate-x-0 transition-transform duration-300 overflow-hidden">
      <%- include("../../views/partials/admin/sidebar") %>
    </aside>
    <div class="flex flex-col flex-1 w-full overflow-hidden">
      <%- include("../../views/partials/admin/header") %>
        <main class="flex-1 overflow-y-auto p-3 sm:p-4 md:p-6 lg:p-8">


          <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-6">

            <div class="bg-white p-4 rounded shadow text-center">
              <h4 class="text-gray-500 text-sm">Total Orders</h4>
              <p id="statOrders" class="text-xl font-bold">0</p>
            </div>

            <div class="bg-white p-4 rounded shadow text-center">
              <h4 class="text-gray-500 text-sm">Total Sales</h4>
              <p id="statSales" class="text-xl font-bold">₹0</p>
            </div>

            <div class="bg-white p-4 rounded shadow text-center">
              <h4 class="text-gray-500 text-sm">Total Discount</h4>
              <p id="statDiscount" class="text-xl font-bold">₹0</p>
            </div>

            <div class="bg-white p-4 rounded shadow text-center">
              <h4 class="text-gray-500 text-sm">Net Revenue</h4>
              <p id="statNet" class="text-xl font-bold">₹0</p>
            </div>

          </div>


          <!-- STATS CARDS -->
          <div class="mb-6 bg-white p-4 rounded shadow flex flex-wrap items-center justify-between gap-4">


            <!-- LEFT SECTION (Dropdown + Date Inputs) -->
            <div class="flex flex-wrap items-center gap-3">

              <!-- RANGE DROPDOWN -->
              <select id="range" class="border px-3 py-2 rounded">
                <option value="daily">1 Day</option>
                <option value="weekly">1 Week</option>
                <option value="monthly" selected>1 Month</option>
                <option value="yearly">1 Year</option>
              </select>

              <!-- FROM DATE -->
              <div class="flex items-center gap-1">
                <label class="text-sm text-gray-600">From:</label>
                <input id="fromDate" type="date" class="border px-3 py-2 rounded">
              </div>

              <!-- TO DATE -->
              <div class="flex items-center gap-1">
                <label class="text-sm text-gray-600">To:</label>
                <input id="toDate" type="date" class="border px-3 py-2 rounded">
              </div>

              <!-- APPLY BUTTON -->
              <button id="applyFilter" class="bg-blue-600 text-white px-5 py-2 rounded hover:bg-blue-700 transition">
                Apply
              </button>
            </div>

            <!-- RIGHT SECTION (Downloads + Timestamp) -->
            <div class="flex items-center gap-3">
              <span id="lastUpdated" class="text-xs text-gray-500">Updated: —</span>
              <a id="downloadPdf" class="border px-3 py-1 rounded bg-red-500 text-white">PDF</a>
              <a id="downloadXlsx" class="border px-3 py-1 rounded bg-green-500 text-white">Excel</a>

            </div>

          </div>



          <!-- GRAPH SECTION -->
          <div class="grid grid-cols-1 lg:grid-cols-3 gap-4 mb-8">

            <!-- DONUT CHART -->
            <div class="bg-white p-6 rounded shadow">
              <h3 class="font-semibold mb-2">Sales vs Discount</h3>
              <canvas id="donutChart" class="w-full h-64"></canvas>
            </div>

            <!-- BAR CHART -->
            <div class="lg:col-span-2 bg-white p-6 rounded shadow">
              <div class="flex justify-between mb-3">
                <h3 class="font-semibold">Activity</h3>
              </div>
              <canvas id="barChart" class="w-full h-64"></canvas>
            </div>
          </div>


          <!-- TABLE SECTION -->
          <div class="bg-white p-6 rounded shadow">
            <h3 class="font-semibold mb-4">Sales Report</h3>

            <table class="min-w-full text-sm">
              <thead>
                <tr class="border-b">
                  <th class="py-2 text-left">Order ID</th>
                  <th class="py-2 text-left">Date</th>
                  <th class="py-2 text-left">Subtotal</th>
                  <th class="py-2 text-left">Discount</th>
                  <th class="py-2 text-left">Coupon</th>
                  <th class="py-2 text-left">Total</th>
                </tr>
              </thead>
              <tbody id="reportTable"></tbody>
            </table>
          </div>

        </main>

        <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
        <script src="/js/dashboard.js"></script>
        <script>
          document.addEventListener("DOMContentLoaded", function () {
            loadReport();  // auto-load report on dashboard load
          });
        </script>

        <script>
          let donutChart, barChart;

          document.addEventListener("DOMContentLoaded", () => {
            loadReport(); // Auto load report when /admin opens
          });

          // ----------------------- DOWNLOAD LINKS -----------------------
          function updateDownloadLinks(range, from, to) {
            let base = `/admin/report/download`;

            if (from && to) range = "custom";

            document.getElementById("downloadPdf").href =
              `${base}.pdf?range=${range}&from=${from}&to=${to}`;

            document.getElementById("downloadXlsx").href =
              `${base}.xlsx?range=${range}&from=${from}&to=${to}`;
          }


          // ----------------------------- LOAD REPORT -----------------------------
          async function loadReport() {
            const range = document.getElementById("range").value;
            const from = document.getElementById("fromDate").value;
            const to = document.getElementById("toDate").value;

            let url = `/admin/report?range=${range}`;

            // If custom date selected
            if (from && to) {
              if (new Date(from) > new Date(to)) {
                return Swal.fire("Invalid", "From date cannot be after To date", "error");
              }
              url = `/admin/report?range=custom&from=${from}&to=${to}`;
            }

            const response = await fetch(url, { headers: { "Accept": "application/json" } });
            const data = await response.json();

            if (!data.success) return;

            updateStats(data.summary);
            updateDonutChart(data.summary);
            updateBarChart(data.orders);
            renderTable(data.orders);
            updateDownloadLinks(range, from, to);

            document.getElementById("lastUpdated").innerText =
              "Updated: " + new Date().toLocaleTimeString();
          }

          // ----------------------------- UPDATE STATS -----------------------------
          function updateStats(summary) {
            document.getElementById("statOrders").innerText = summary.orderCount;
            document.getElementById("statSales").innerText = "₹" + summary.totalSales;
            document.getElementById("statDiscount").innerText = "₹" + summary.totalDiscount;
            document.getElementById("statNet").innerText =
              "₹" + (summary.totalSales - summary.totalDiscount);
          }

          // ----------------------------- DONUT CHART -----------------------------
          function updateDonutChart(summary) {
            const ctx = document.getElementById("donutChart");
            if (donutChart) donutChart.destroy();

            donutChart = new Chart(ctx, {
              type: "doughnut",
              data: {
                labels: ["Sales", "Discount"],
                datasets: [{
                  data: [summary.totalSales, summary.totalDiscount],
                  backgroundColor: ["#3b82f6", "#ef4444"]
                }]
              }
            });
          }

          // ----------------------------- BAR CHART -----------------------------
          function updateBarChart(orders) {
            const ctx = document.getElementById("barChart");

            const months = Array(12).fill(0);

            orders.forEach(o => {
              const monthIndex = new Date(o.createdAt).getMonth();
              months[monthIndex] += o.totalAmount || 0;
            });

            if (barChart) barChart.destroy();

            barChart = new Chart(ctx, {
              type: "bar",
              data: {
                labels: ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"],
                datasets: [{
                  label: "Sales",
                  data: months,
                  backgroundColor: "#3b82f6"
                }]
              }
            });
          }

          // ----------------------------- TABLE RENDER -----------------------------
          function renderTable(orders) {
            const tbody = document.getElementById("reportTable");
            tbody.innerHTML = "";

            orders.forEach(o => {
              let subTotal = 0;
              let discount = 0;

              // Calculate subtotal + discount from items[]
              o.items.forEach(i => {
                const itemPrice = i.price || 0;
                const salePrice = i.salePrice || itemPrice;

                subTotal += itemPrice * i.quantity;
                discount += (itemPrice - salePrice) * i.quantity;
              });

              const couponUsed = o.appliedOffer ? o.appliedOffer : "-";

              tbody.innerHTML += `
        <tr class="border-b">
          <td class="py-2">${o.orderId}</td>
          <td class="py-2">${new Date(o.createdAt).toLocaleString()}</td>
          <td class="py-2">₹${subTotal}</td>
          <td class="py-2">₹${discount}</td>
          <td class="py-2">
  ${o.appliedOffer && o.appliedOffer.code
                  ? o.appliedOffer.code
                  : "-"}
</td>

          <td class="py-2">₹${o.totalAmount}</td>
        </tr>
      `;
            });
          }

          // ----------------------------- FILTER BUTTON -----------------------------
          document.getElementById("applyFilter").addEventListener("click", loadReport);
        </script>






    </div>
  </div>
  <!-- <script src="../../public/js/dashboard.js"></script> -->

</body>

</html>