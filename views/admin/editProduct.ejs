<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Product - Admin Dashboard</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>

<body class="bg-gray-50">
    <div class="flex min-h-screen">

        <!-- Sidebar -->
        <aside id="sidebar"
            class="w-full sm:w-64 bg-white shadow-lg fixed lg:static left-0 top-0 h-screen z-40 overflow-y-auto">
            <%- include("../../views/partials/admin/sidebar") %>
        </aside>

        <!-- Main content -->
        <div class="flex-1 flex flex-col min-h-screen">
            <header class="bg-white shadow-sm sticky top-0 z-30">
                <%- include("../../views/partials/admin/header") %>
            </header>

            <main class="flex-1 p-4 sm:p-6 lg:p-8 overflow-x-auto">
                <div class="mb-6">
                    <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-2">Edit Product</h2>
                    <div class="flex items-center gap-2 text-sm text-gray-600">
                        <span><a href="/admin">Dashboard</a></span>
                        <i class="fas fa-chevron-right text-xs"></i>
                        <span class="text-gray-900"><a href="/admin/products">Products</a></span>
                        <i class="fas fa-chevron-right text-xs"></i>
                        <span class="text-gray-900">Edit</span>
                    </div>
                </div>

                <!-- General Information -->
                <section class="bg-white rounded-lg shadow-sm p-6 mb-6">
                    <h2 class="text-lg font-semibold text-gray-800 mb-4">General Information</h2>
                    <div class="space-y-4">
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <!-- Brand -->
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-2">Brand</label>
                                <select name="brand"
                                    class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-blue-500">
                                    <option value="">Select Brand</option>
                                    <% brand.forEach(b=> { %>
                                        <option value="<%= b._id %>" <%=b._id.toString()===product.brand.toString()
                                            ? 'selected' : '' %>><%= b.name %>
                                        </option>
                                        <% }) %>
                                </select>
                            </div>

                            <!-- Product Name -->
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-2">Product Name</label>
                                <input type="text" name="productName" value="<%= product.model %>"
                                    placeholder="Type product name here..."
                                    class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-blue-500">
                            </div>
                        </div>

                        <!-- Description -->
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">Description</label>
                            <textarea name="description" rows="4" placeholder="Write a short description..."
                                class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-blue-500 resize-none"><%= product.description %></textarea>
                        </div>

                        <!-- Category, Status, Category Type -->
                        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-2">Category</label>
                                <select name="category"
                                    class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-blue-500">
                                    <option value="">Select Category</option>
                                    <% category.forEach(c=> { %>
                                        <option value="<%= c._id %>" <%=c._id.toString()===product.category.toString()
                                            ? 'selected' : '' %>><%= c.name %>
                                        </option>
                                        <% }) %>
                                </select>
                            </div>

                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-2">Status</label>
                                <div class="flex items-center gap-8">
                                    <label class="flex items-center gap-2">
                                        <input type="radio" name="status" value="listed" class="text-blue-600"
                                            <%=product.status==='listed' ? 'checked' : '' %>>
                                        <span>Listed</span>
                                    </label>
                                    <label class="flex items-center gap-2">
                                        <input type="radio" name="status" value="unlisted" class="text-blue-600"
                                            <%=product.status==='unlisted' ? 'checked' : '' %>>
                                        <span>Unlisted</span>
                                    </label>
                                </div>
                            </div>

                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-2">Category Type</label>
                                <div class="flex items-center gap-8">
                                    <label class="flex items-center gap-2">
                                        <input type="radio" name="categoryType" value="component" class="text-blue-600"
                                            <%=product.categoryType==='component' ? 'checked' : '' %>>
                                        <span>Component</span>
                                    </label>
                                    <label class="flex items-center gap-2">
                                        <input type="radio" name="categoryType" value="peripheral" class="text-blue-600"
                                            <%=product.categoryType==='peripheral' ? 'checked' : '' %>>
                                        <span>Peripheral</span>
                                    </label>
                                </div>
                            </div>
                        </div>

                        <!-- Limited Edition & Flash Sale -->
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <label class="flex items-center gap-2 text-sm font-medium text-gray-700">
                                <input type="checkbox" name="limitedEdition" class="text-blue-600"
                                    <%=product.limitedEdition ? 'checked' : '' %>>
                                <span>Limited Edition</span>
                            </label>
                            <label class="flex items-center gap-2 text-sm font-medium text-gray-700">
                                <input type="checkbox" name="flashSale" class="text-blue-600" <%=product.flashSale
                                    ? 'checked' : '' %>>
                                <span>Flash Sale</span>
                            </label>
                        </div>
                    </div>
                </section>

                <!-- Product Images -->
                <section class="bg-white rounded-lg shadow-sm p-6 mb-6">
                    <h2 class="text-lg font-semibold text-gray-800 mb-4">Product Images (max 4)</h2>
                    <div id="imageContainer" class="grid grid-cols-2 sm:grid-cols-4 gap-4">
                        <% product.images.forEach((img, idx)=> { %>
                            <div class="relative group border border-gray-300 rounded-lg overflow-hidden">
                                <img src="<%= img %>" class="w-full h-32 object-cover">
                                <button data-index="<%= idx %>"
                                    class="absolute top-1 right-1 bg-red-600 text-white w-6 h-6 rounded-full flex items-center justify-center text-xs opacity-0 group-hover:opacity-100 remove-image">&times;</button>
                            </div>
                            <% }) %>
                                <div id="uploadBox"
                                    class="border-2 border-dashed border-gray-300 rounded-lg p-6 flex flex-col items-center justify-center bg-gray-50 hover:border-blue-400 cursor-pointer">
                                    <i class="fas fa-image text-3xl text-blue-400 mb-2"></i>
                                    <p class="text-sm text-gray-500">Click or Drop Image</p>
                                    <input type="file" id="imageInput" class="hidden" accept="image/*" multiple>
                                </div>
                    </div>
                </section>

                <!-- Product Variants -->
                <section class="bg-white rounded-lg shadow-sm p-6 mb-6">
                    <h2 class="text-lg font-semibold text-gray-800 mb-4">Product Variants</h2>
                    <div id="variantContainer" class="space-y-4">
                        <% product.variants.forEach(v=> { %>
                            <div class="grid grid-cols-1 sm:grid-cols-4 gap-4 variant-row relative">
                                <input type="text" name="variant[]" placeholder="Variant Name" value="<%= v.variant %>"
                                    class="px-4 py-2 border rounded text-sm">
                                <input type="number" name="quantity[]" placeholder="Quantity" value="<%= v.quantity %>"
                                    class="px-4 py-2 border rounded text-sm">
                                <input type="number" name="price[]" placeholder="Price" value="<%= v.price %>"
                                    class="px-4 py-2 border rounded text-sm">
                                <input type="number" name="offerPrice[]" placeholder="Offer Price"
                                    value="<%= v.offer %>" class="px-4 py-2 border rounded text-sm">
                                <button type="button"
                                    class="absolute -top-3 -right-3 bg-red-600 text-white w-6 h-6 rounded-full remove-variant">&times;</button>
                            </div>
                            <% }) %>
                    </div>
                    <div class="mt-4 flex justify-end">
                        <button type="button" id="addVariantBtn"
                            class="px-5 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700">+ Add Variant</button>
                    </div>
                </section>

                <!-- Product Specifications -->
                <section class="bg-white rounded-lg shadow-sm p-6 mb-6">
                    <h2 class="text-lg font-semibold text-gray-800 mb-4">Product Specifications</h2>
                    <div id="specContainer" class="space-y-4">
                        <% product.specification.forEach(s=> { %>
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 spec-row relative">
                                <input type="text" name="specTitle[]" placeholder="Title" value="<%= s.title %>"
                                    class="px-4 py-2 border rounded text-sm">
                                <input type="text" name="specification[]" placeholder="Specification"
                                    value="<%= s.details %>" class="px-4 py-2 border rounded text-sm">
                                <button type="button"
                                    class="absolute -top-3 -right-3 bg-red-600 text-white w-6 h-6 rounded-full remove-spec">&times;</button>
                            </div>
                            <% }) %>
                    </div>
                    <div class="mt-4 flex justify-end">
                        <button type="button" id="addSpecBtn"
                            class="px-5 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700">+ Add
                            Specification</button>
                    </div>
                </section>

                <!-- Actions -->
                <div class="flex flex-col sm:flex-row gap-4">
                    <button type="button" id="submitBtn"
                        class="flex-1 px-6 py-3 bg-black text-white rounded-lg font-medium hover:bg-gray-800">Update
                        Product</button>
                    <a href="/admin/products"
                        class="sm:w-auto px-8 py-3 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50">Cancel</a>
                </div>
            </main>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/axios/1.6.6/axios.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.js"></script>
    <script>
        const submitBtn = document.getElementById("submitBtn");

        submitBtn.addEventListener("click", async () => {
            try {
                const brand = document.querySelector("select[name='brand']").value;
                const productName = document.querySelector("input[name='productName']").value;
                const description = document.querySelector("textarea[name='description']").value;
                const category = document.querySelector("select[name='category']").value;
                const status = document.querySelector("input[name='status']:checked").value;
                const categoryType = document.querySelector("input[name='categoryType']:checked").value;
                const limitedEdition = document.querySelector("input[name='limitedEdition']").checked;
                const flashSale = document.querySelector("input[name='flashSale']").checked;
                if (!brand || !productName || !category)
                    return Swal.fire('Error', 'Brand, Product Name and Category are required!', 'error');

                // Upload images to Cloudinary
                const uploadedImages = [];
                for (let i = 0; i < images.length; i++) {
                    const canvas = images[i].cropper.getCroppedCanvas({ width: 800, height: 800 });
                    const blob = await new Promise(res => canvas.toBlob(res));
                    const formData = new FormData();
                    formData.append("file", blob);
                    formData.append("upload_preset", "product_upload");

                    const cloudRes = await fetch(`https://api.cloudinary.com/v1_1/dmx7sia5q/image/upload`, {
                        method: "POST",
                        body: formData
                    });
                    const cloudData = await cloudRes.json();
                    uploadedImages.push(cloudData.secure_url);
                }

                // Variants
                const variants = Array.from(document.querySelectorAll(".variant-row")).map(r => ({
                    variant: r.querySelector("input[name='variant[]']").value,
                    quantity: r.querySelector("input[name='quantity[]']").value,
                    price: r.querySelector("input[name='price[]']").value,
                    offer: r.querySelector("input[name='offerPrice[]']").value
                })).filter(v => v.variant);

                // Specifications
                const specifications = Array.from(document.querySelectorAll(".spec-row")).map(r => ({
                    title: r.querySelector("input[name='specTitle[]']").value,
                    details: r.querySelector("input[name='specification[]']").value
                })).filter(s => s.title);
                console.log(specifications)

                const productData = {
                    brand, productName, description, category, status,
                    categoryType, limitedEdition, flashSale,
                    variants, specifications, images: uploadedImages
                };

                const productId = "<%= product._id %>";
                const res = await fetch(`/admin/products/editProduct/${productId}`, {
                    method: "PUT",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify(productData)
                });

                const result = await res.json();
                if (result.success) {
                    Swal.fire('Success', 'Product updated successfully!', 'success')
                        .then(() => window.location.href = "/admin/products");
                } else {
                    Swal.fire('Error', result.message || 'Failed to update product', 'error');
                }
            } catch (err) {
                console.error(err);
                Swal.fire('Error', 'An error occurred while updating the product', 'error');
            }
        });
    </script>

</body>

</html>