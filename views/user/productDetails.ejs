                                        <button
                                            class="sm:w-auto p-3 border-2 border-gray-300 rounded-full hover:border-red-500 hover:text-red-500 transition">
                                            <i class="far fa-heart text-lg"></i>
                                        </button>
                                    </div>

                                    <%}%>
                </div>
            </div>

            <!-- Tabs Section -->
