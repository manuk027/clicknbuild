<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>clickNbuild</title>
    <link rel="icon" href="https://res.cloudinary.com/dmx7sia5q/image/upload/v1761540715/logo_dtmtfn.png"
        type="image/png">
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
        rel="stylesheet">
</head>

<body class="font-[Poppins] bg-gray-50">
    <%- include("../../views/partials/user/header", { peripheral: peripheral, component: component, user: user }) %>
        <!-- Main Content -->
        <main class="container mx-auto px-4 md:px-6 py-8">

            <!-- Breadcrumb -->
            <div class="text-sm text-gray-600 mb-6">
                <a href="/" class="hover:text-black">Home</a>
                <span class="mx-2">/</span>
                <span class="text-black font-medium">
                    <%if(filterCategory.length>1){%>
                        All Products
                        <%}else{%>
                            <%=product[0].category.name%>
                                <%}%>
                </span>
            </div>

            <div class="flex flex-col lg:flex-row gap-8">

                <!-- Sidebar Filters -->
                <aside class="lg:w-64 flex-shrink-0">
                    <div class="bg-white rounded-lg shadow-sm p-6 sticky top-8">
                        <h2 class="text-xl font-semibold mb-6">Filter By</h2>

                        <!-- Brand Filter -->
                        <%if(filterBrand){%>
                            <div class="mb-6">
                                <h3 class="font-medium mb-3">Brand</h3>
                                <div class="space-y-2">
                                    <%for(let i=0; i<filterBrand.length; i++){%>
                                        <label class="flex items-center cursor-pointer">
                                            <input type="checkbox"
                                                class="w-4 h-4 text-black border-gray-300 rounded focus:ring-black">
                                            <span class="ml-2 text-sm">
                                                <%=filterBrand[i]%>
                                            </span>
                                        </label>
                                        <%}%>
                                </div>
                            </div>
                            <%}%>

                                <!-- Category Filter -->
                                <%if(filterCategory){%>
                                    <div class="mb-6">
                                        <h3 class="font-medium mb-3">Category</h3>
                                        <div class="space-y-2">
                                            <%for(let i=0; i<filterCategory.length; i++){%>
                                                <label class="flex items-center cursor-pointer">
                                                    <input type="checkbox"
                                                        class="w-4 h-4 text-black border-gray-300 rounded focus:ring-black">
                                                    <span class="ml-2 text-sm">
                                                        <%=filterCategory[i]%>
                                                    </span>
                                                </label>
                                                <%}%>

                                        </div>
                                    </div>
                                    <%}%>

                                        <!-- Size Filter -->


                                        <button
                                            class="w-full bg-black text-white py-3 rounded-md hover:bg-gray-800 transition font-medium">
                                            APPLY
                                        </button>
                    </div>
                </aside>

                <!-- Products Section -->
                <div class="flex-1">

                    <!-- Sort Bar -->
                    <div
                        class="bg-white rounded-lg shadow-sm p-4 mb-6 flex flex-wrap items-center justify-between gap-4">


                        <div class="flex flex-wrap items-center gap-2">
                            <span class="text-sm text-gray-600">Sort By</span>
                            <button class="px-4 py-2 text-sm border-b-2 border-black font-medium">Popularity</button>
                            <button class="px-4 py-2 text-sm text-gray-600 hover:text-black">Newest First</button>
                            <button class="px-4 py-2 text-sm text-gray-600 hover:text-black">Price: Low - High</button>
                            <button class="px-4 py-2 text-sm text-gray-600 hover:text-black">Price: High - Low</button>
                        </div>
                    </div>

                    <!-- Products Grid -->
                    <%if(product.length){%>
                        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                            <% for(let i=0; i<product.length; i++){ %>
                                <a href="/product?id=<%= product[i]._id %>">
                                    <div
                                        class="bg-white rounded-lg shadow-sm hover:shadow-lg transition-shadow overflow-hidden group flex flex-col h-full min-h-[500px]">

                                        <div
                                            class="relative aspect-square bg-gray-100 flex items-center justify-center p-6">
                                            <img src="<%=product[i].images[0]%>" alt="<%=product[i].brand.name%>"
                                                class="w-full h-full object-contain transition-transform product-img"
                                                data-images='<%- JSON.stringify(product[i].images) %>'>
                                            <button
                                                class="absolute top-3 right-3 w-8 h-8 bg-white rounded-full flex items-center justify-center hover:bg-gray-100 transition">
                                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                                                    stroke-width="2" stroke="currentColor" class="w-5 h-5">
                                                    <path stroke-linecap="round" stroke-linejoin="round"
                                                        d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" />
                                                </svg>
                                            </button>
                                        </div>

                                        <div class="p-4 flex flex-col flex-grow">
                                            <%if(product[i].variants[0].quantity<=10 && product[i].variants[0].quantity>=1){%>
                                                <h3 class="font-medium text-red-900 mb-1 truncate">
                                                    <%=product[i].variants[0].quantity%> items left.
                                                </h3>
                                                <%}else if(product[i].variants[0].quantity===0){%>
                                                    <h3 class="font-medium text-red-900 mb-1 truncate">
                                                        Out of Stock.
                                                    </h3>
                                                    <%}%>
                                                        <h3 class="font-medium text-gray-800 mb-1 truncate">
                                                            <%=product[i].brand.name%>
                                                        </h3>
                                                        <h6 class="font-medium text-gray-800 mb-2 line-clamp-2">
                                                            <%=product[i].model%>
                                                        </h6>

                                                        <div class="flex items-center gap-2 mb-2">
                                                            <span class="text-gray-400 line-through text-sm">
                                                                ₹<%=product[i].variants[0].price%>
                                                            </span>
                                                            <span class="text-lg font-semibold text-gray-900">
                                                                ₹<%=product[i].variants[0].offer%>
                                                            </span>
                                                        </div>

                                                        <div class="flex items-center gap-1 mb-3">
                                                            <span class="text-yellow-400">★★★★★</span>
                                                        </div>

                                                        <!-- Button pinned to bottom -->
                                                        <%if(product[i].variants[0].quantity>=1){%>
                                                            <button
                                                                class="mt-auto w-full bg-black text-white py-2 rounded-md hover:bg-gray-800 transition font-medium text-sm">
                                                                Add to Cart
                                                            </button>
                                                            <%}%>
                                        </div>
                                    </div>
                                </a>
                                <% } %>
                        </div>
                        <%}else{%>
                            <div class="flex flex-col items-center justify-center min-h-[60vh] text-center px-4">
                                <img src="https://cdn-icons-png.flaticon.com/512/1055/1055687.png"
                                    alt="No products found" class="w-32 sm:w-40 mb-6 opacity-80 select-none" />

                                <h2 class="text-2xl sm:text-3xl font-semibold text-gray-800 mb-2">
                                    No Products Found
                                </h2>

                                <p class="text-gray-500 max-w-md">
                                    We couldn’t find any items that match your search or filter criteria.<br />
                                    Try adjusting your filters or explore other categories.
                                </p>

                                <a href="/"
                                    class="mt-6 inline-block bg-black text-white px-6 py-2 rounded-md hover:bg-gray-800 transition text-sm font-medium">
                                    Back to Home
                                </a>
                            </div>

                            <%}%>

                                <script>
                                    document.querySelectorAll('.product-img').forEach(img => {
                                        const images = JSON.parse(img.dataset.images);
                                        let index = 0;
                                        let interval;

                                        img.addEventListener('mouseenter', () => {
                                            if (images.length <= 1) return;
                                            interval = setInterval(() => {
                                                index = (index + 1) % images.length;
                                                img.src = images[index];
                                            }, 1000);
                                        });

                                        img.addEventListener('mouseleave', () => {
                                            clearInterval(interval);
                                            index = 0;
                                            img.src = images[0];
                                        });
                                    });
                                </script>






                </div>
            </div>

        </main>
        <%- include("../../views/partials/user/footer") %>

            <script>
                // Add to cart functionality
                document.querySelectorAll('button').forEach(btn => {
                    if (btn.textContent.includes('Add to Cart')) {
                        btn.addEventListener('click', function (e) {
                            e.preventDefault();
                        });
                    }
                });

                // Filter functionality
                const checkboxes = document.querySelectorAll('input[type="checkbox"]');
                checkboxes.forEach(checkbox => {
                    checkbox.addEventListener('change', function () {
                    });
                });

                // Sort buttons
                const sortBtns = document.querySelectorAll('[class*="px-4 py-2"]');
                sortBtns.forEach(btn => {
                    btn.addEventListener('click', function () {
                        sortBtns.forEach(b => {
                            b.classList.remove('border-b-2', 'border-black', 'font-medium');
                            b.classList.add('text-gray-600');
                        });
                        this.classList.add('border-b-2', 'border-black', 'font-medium');
                        this.classList.remove('text-gray-600');
                    });
                });
            </script>

</body>

</html>