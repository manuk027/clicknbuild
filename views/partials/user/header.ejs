<script src="https://cdn.tailwindcss.com"></script>

<body class="font-[Poppins]">

  <header class="bg-black text-white px-4 md:px-12 py-2 md:py-0 min-h-[4rem] md:h-24 flex items-center justify-between relative z-50">

    <div class="logo flex items-center h-12 w-12 md:h-24 md:w-24 flex-shrink-0 mr-2">
      <img src="https://res.cloudinary.com/dmx7sia5q/image/upload/v1761540715/logo_dtmtfn.png" alt="logo"
        class="w-full h-full object-contain">
    </div>

    <div class="bg-white rounded-md flex items-center px-2 flex-1 max-w-lg mx-2 md:mx-0 border border-gray-300 relative">
      <input id="searchInput" type="text"
        placeholder="<%= typeof searchQuery !== 'undefined' && searchQuery ? searchQuery : 'Search' %>"
        value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>"
        class="p-2 w-full text-black border-none outline-none text-sm rounded-md min-w-0" />

      <button id="clearSearchBtn" class="text-gray-400 hover:text-gray-600 hidden px-2">
        ✕
      </button>
    </div>


    <script>
      const searchInput = document.getElementById("searchInput");
      const clearSearchBtn = document.getElementById("clearSearchBtn");

      function toggleClearButton() {
        if (searchInput.value.trim().length > 0) {
          clearSearchBtn.classList.remove("hidden");
        } else {
          clearSearchBtn.classList.add("hidden");
        }
      }

      searchInput.addEventListener("input", toggleClearButton);
      toggleClearButton(); 

      searchInput.addEventListener("keypress", function (e) {
        if (e.key === "Enter") {
          const query = searchInput.value.trim();
          window.location.href = query
            ? `/products?search=${encodeURIComponent(query)}`
            : `/products`;
        }
      });

      clearSearchBtn.addEventListener("click", function () {
        searchInput.value = "";
        toggleClearButton();
        window.location.href = "/products";
      });
    </script>


    <button id="menu-btn" class="md:hidden text-white focus:outline-none ml-3 flex-shrink-0">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"
        class="w-7 h-7">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16m-7 6h7" />
      </svg>
    </button>

    <div class="hidden md:flex items-center gap-6 lg:gap-12 ml-4">
      <nav class="flex items-center gap-4 lg:gap-10 text-sm lg:text-base">
        <a href="/" class="hover:text-gray-300 whitespace-nowrap">Home</a>
        <a href="/shop" class="hover:text-gray-300 whitespace-nowrap">Shop</a>

        <div class="relative group">
          <button class="hover:text-gray-300 flex items-center gap-1 whitespace-nowrap">
            Components
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2"
              stroke="currentColor" class="w-4 h-4">
              <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25l-7.5 7.5-7.5-7.5" />
            </svg>
          </button>
          <div
            class="absolute left-0 top-full mt-0 w-48 bg-white text-black rounded-md shadow-lg opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50">
            <%for(let i=0; i<component.length; i++){%>
              <a href="/component/<%=component[i].name%>" class="block px-4 py-3 hover:bg-gray-200 first:rounded-t-md">
                <%=component[i].name%>
              </a>
              <%}%>
          </div>
        </div>

        <div class="relative group">
          <button class="hover:text-gray-300 flex items-center gap-1 whitespace-nowrap">
            Peripherals
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2"
              stroke="currentColor" class="w-4 h-4">
              <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25l-7.5 7.5-7.5-7.5" />
            </svg>
          </button>
          <div
            class="absolute left-0 top-full mt-0 w-48 bg-white text-black rounded-md shadow-lg opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50">
            <%for(let i=0; i<peripheral.length; i++){%>
              <a href="/peripheral/<%=peripheral[i].name%>"
                class="block px-4 py-3 hover:bg-gray-200 first:rounded-t-md">
                <%=peripheral[i].name%>
              </a>
              <%}%>
          </div>
        </div>

        <%if(!locals.user){%>
          <a href="/login" class="hover:text-gray-300 whitespace-nowrap">Login / Signup</a>
          <%}%>
      </nav>

      <%if(locals.user){%>
        <div class="flex gap-4 lg:gap-6 items-center">
          <a href="/wishlist" class="hover:opacity-70 transition">
            <img src="/images/heart.png" alt="wishlist" class="w-6 h-6 object-contain">
          </a>
          <a href="/cart" class="hover:opacity-70 transition">
            <img src="/images/cart.png" alt="cart" class="w-6 h-6 object-contain">
          </a>

          <div class="relative group">
            <button class="hover:text-gray-300 flex items-center gap-1 max-w-[150px]">
              <img src="<%=user.profilePhoto || "https://res.cloudinary.com/dmx7sia5q/image/upload/v1763480620/Untitled_design_h0wjcl.png"%>" alt="user" class="w-8 h-8 rounded-full object-cover border border-gray-600">
              <span class="text-sm truncate hidden lg:block ml-1">
                <%=locals.user.fullName%>
              </span>
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2"
                stroke="currentColor" class="w-4 h-4 ml-1">
                <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25l-7.5 7.5-7.5-7.5" />
              </svg>
            </button>
            <div
              class="absolute right-0 top-full mt-2 w-48 bg-white text-black rounded-md shadow-lg opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50">
              <a href="/profile" class="block px-4 py-3 hover:bg-gray-200 first:rounded-t-md">Account</a>
              <a href="/logout" class="block px-4 py-3 hover:bg-gray-200 last:rounded-b-md">Logout</a>
            </div>
          </div>
        </div>
        <%}%>
    </div>
  </header>

  <div id="mobile-menu"
    class="hidden flex flex-col items-center bg-black text-white w-full md:hidden border-t border-gray-800 relative z-40">
    
    <a href="/" class="hover:text-gray-300 w-full text-center py-3 border-b border-gray-900">Home</a>
    <a href="/shop" class="hover:text-gray-300 w-full text-center py-3 border-b border-gray-900">Shop</a>

    <div class="w-full border-b border-gray-900">
      <button id="mobile-components-btn"
        class="w-full text-center py-3 hover:text-gray-300 flex items-center justify-center gap-1">
        Components
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"
          class="w-4 h-4 transition-transform duration-200" id="components-arrow">
          <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25l-7.5 7.5-7.5-7.5" />
        </svg>
      </button>
      <div id="mobile-components-menu" class="hidden flex flex-col items-center bg-gray-100 text-black py-1 w-full">
        <%for(let i=0; i<component.length; i++){%>
          <a href="component/<%=component[i].name%>" class="py-2 hover:bg-gray-200 w-full text-center">
            <%=component[i].name%>
          </a>
          <%}%>
      </div>
    </div>

    <div class="w-full border-b border-gray-900">
      <button id="mobile-peripherals-btn"
        class="w-full text-center py-3 hover:text-gray-300 flex items-center justify-center gap-1">
        Peripherals
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"
          class="w-4 h-4 transition-transform duration-200" id="peripherals-arrow">
          <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25l-7.5 7.5-7.5-7.5" />
        </svg>
      </button>
      <div id="mobile-peripherals-menu" class="hidden flex flex-col items-center bg-gray-100 text-black py-1 w-full">
        <%for(let i=0; i<peripheral.length; i++){%>
          <a href="/peripheral/<%=peripheral[i].name%>" class="py-2 hover:bg-gray-200 w-full text-center">
            <%=peripheral[i].name%>
          </a>
          <%}%>
      </div>
    </div>

    <%if(!locals.user){%>
      <a href="/login" class="hover:text-gray-300 w-full text-center py-3">Login / Signup</a>
      <%}%>

    <%if(locals.user){%>
      <div class="w-full pt-2 pb-4">
        <div class="flex justify-center gap-8 py-3 border-b border-gray-900">
            <a href="/wishlist" class="flex flex-col items-center hover:text-gray-300 text-xs gap-1">
                <img src="/images/heart.png" alt="wishlist" class="w-6 h-6 invert">
                Wishlist
            </a>
            <a href="/cart" class="flex flex-col items-center hover:text-gray-300 text-xs gap-1">
                <img src="/images/cart.png" alt="cart" class="w-6 h-6 invert">
                Cart
            </a>
        </div>

        <div class="w-full mt-2">
          <button id="mobile-profile-btn"
            class="w-full text-center py-3 hover:text-gray-300 flex items-center justify-center gap-2">
            <img src="<%=user.profilePhoto || "https://res.cloudinary.com/dmx7sia5q/image/upload/v1763480620/Untitled_design_h0wjcl.png"%>" alt="user" class="w-6 h-6 rounded-full object-cover">
            <%= user.fullName %>
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2"
                stroke="currentColor" class="w-4 h-4 transition-transform duration-200" id="profile-arrow">
                <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25l-7.5 7.5-7.5-7.5" />
              </svg>
          </button>
          <div id="mobile-profile-menu" class="hidden flex flex-col items-center bg-gray-100 text-black py-1 w-full">
            <a href="/profile" class="py-2 hover:bg-gray-200 w-full text-center">Account</a>
            <a href="/logout" class="py-2 hover:bg-gray-200 w-full text-center">Logout</a>
          </div>
        </div>
      </div>
      <%}%>
  </div>

  <script>
    const menuBtn = document.getElementById('menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    const mobileComponentsBtn = document.getElementById('mobile-components-btn');
    const mobileComponentsMenu = document.getElementById('mobile-components-menu');
    const mobilePeripheralsBtn = document.getElementById('mobile-peripherals-btn');
    const mobilePeripheralsMenu = document.getElementById('mobile-peripherals-menu');
    const mobileProfileBtn = document.getElementById('mobile-profile-btn');
    const mobileProfileMenu = document.getElementById('mobile-profile-menu');
    const componentsArrow = document.getElementById('components-arrow');
    const peripheralsArrow = document.getElementById('peripherals-arrow');
    const profileArrow = document.getElementById('profile-arrow');

    menuBtn.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
    });

    mobileComponentsBtn.addEventListener('click', () => {
      mobileComponentsMenu.classList.toggle('hidden');
      componentsArrow.style.transform = mobileComponentsMenu.classList.contains('hidden') ? 'rotate(0deg)' : 'rotate(180deg)';
    });

    mobilePeripheralsBtn.addEventListener('click', () => {
      mobilePeripheralsMenu.classList.toggle('hidden');
      peripheralsArrow.style.transform = mobilePeripheralsMenu.classList.contains('hidden') ? 'rotate(0deg)' : 'rotate(180deg)';
    });

    // Check if profile btn exists (only when logged in)
    if(mobileProfileBtn) {
        mobileProfileBtn.addEventListener('click', () => {
        mobileProfileMenu.classList.toggle('hidden');
        profileArrow.style.transform = mobileProfileMenu.classList.contains('hidden') ? 'rotate(0deg)' : 'rotate(180deg)';
        });
    }
  </script>

</body>