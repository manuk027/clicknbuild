<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>clickNbuild</title>
    <link rel="icon" href="https://res.cloudinary.com/dmx7sia5q/image/upload/v1761540715/logo_dtmtfn.png"
        type="image/png">
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

</head>

<body class="bg-gray-50">
    <%- include("../../views/partials/user/header", { peripheral: peripheral, component: component, user: user }) %>
        <!-- Mobile Sidebar Toggle Button (visible only on mobile) -->
        <div class="lg:hidden fixed top-4 left-4 z-50">
            <button id="mobileSidebarBtn" class="bg-white p-2 rounded-lg shadow-md">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16">
                    </path>
                </svg>
            </button>
        </div>

        <!-- Sidebar Overlay (mobile only) -->
        <div id="sidebarOverlay" class="hidden fixed inset-0 bg-black bg-opacity-50 z-40 lg:hidden"></div>

        <div class="flex min-h-screen">
            <!-- Sidebar -->

            <%- include("../../views/partials/user/sidebar")%>

                <!-- Main Content -->
                <main class="flex-1 p-4 md:p-6 lg:p-8">
                    <!-- Breadcrumb -->
                    <div class="mb-6">
                        <a href="/profile" class="text-gray-600 hover:text-black text-sm">Account </a>
                        <a href="/wallet" class="text-gray-600 hover:text-black text-sm"> &gt; My Wallet</a>
                    </div>

                    <!-- Wallet Card -->
                    <div class="bg-white rounded-lg shadow-lg p-6 md:p-8 lg:p-10 max-w-4xl mx-auto">
                        <!-- Animation -->
                        <div class="flex justify-center mb-4 md:mb-6">
                            <div
                                class="w-20 h-20 md:w-24 md:h-24 bg-gradient-to-r from-black to-gray-700 rounded-full animate-pulse shadow-xl flex items-center justify-center">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                                    stroke-width="1.5" stroke="white" class="w-10 h-10 md:w-12 md:h-12">
                                    <path stroke-linecap="round" stroke-linejoin="round"
                                        d="M21 12a2.25 2.25 0 0 0-2.25-2.25H15a3 3 0 1 1-6 0H5.25A2.25 2.25 0 0 0 3 12m18 0v6a2.25 2.25 0 0 1-2.25 2.25H5.25A2.25 2.25 0 0 1 3 18v-6m18 0V9M3 12V9m18 0a2.25 2.25 0 0 0-2.25-2.25H5.25A2.25 2.25 0 0 0 3 9m18 0V6a2.25 2.25 0 0 0-2.25-2.25H5.25A2.25 2.25 0 0 0 3 6v3" />
                                </svg>
                            </div>
                        </div>

                        <!-- Header -->
                        <h1 class="text-xl md:text-2xl lg:text-3xl font-light text-center mb-6 md:mb-8">My Wallet</h1>

                        <!-- Balance Section -->
                        <div
                            class="bg-gradient-to-r from-black to-gray-700 rounded-lg p-4 md:p-6 mb-6 md:mb-8 text-white text-center">
                            <p class="text-xs md:text-sm font-medium mb-2 opacity-90">Available wallet balance</p>
                            <p class="text-2xl md:text-4xl font-light">
                                ₹<%=currentBalance%>
                            </p>
                        </div>

                        <!-- Transactions Table -->
                        <%if(wallet.length>=1){%>
                            <div class="mb-6 md:mb-8">
                                <h2 class="text-base md:text-lg font-medium text-gray-700 mb-3 md:mb-4">Recent
                                    Transactions
                                </h2>

                                <!-- Desktop Table -->

                                <div class="hidden md:block overflow-x-auto">
                                    <table class="w-full">
                                        <thead>
                                            <tr class="bg-gray-100 border-b border-gray-200">
                                                <th class="px-4 py-3 text-left text-sm font-medium text-gray-700">
                                                    Transaction ID</th>
                                                <th class="px-4 py-3 text-left text-sm font-medium text-gray-700">Date
                                                </th>
                                                <th class="px-4 py-3 text-left text-sm font-medium text-gray-700">Amount
                                                </th>
                                                <th class="px-4 py-3 text-left text-sm font-medium text-gray-700">Status
                                                </th>
                                            </tr>
                                        </thead>
                                        <tbody class="divide-y divide-gray-200">
                                            <%for(let i=0; i<wallet.length; i++){%>
                                                <tr class="hover:bg-gray-50">
                                                    <td class="px-4 py-3 text-sm text-gray-600">
                                                        <%=wallet[i].transactionId%>
                                                    </td>
                                                    <td class="px-4 py-3 text-sm text-gray-600">
                                                        <%=wallet[i].createdAt.toLocaleDateString("en-CA")%>
                                                    </td>
                                                    <td class="px-4 py-3 text-sm text-gray-900 font-medium">₹
                                                        <%=wallet[i].amount%>
                                                    </td>
                                                    <td class="px-4 py-3 text-sm font-medium 
    <%= wallet[i].type === 'CREDIT' ? 'text-green-600' : 'text-red-600' %>">
                                                        <%= wallet[i].type %>
                                                    </td>
                                                </tr>
                                                <%}%>
                                        </tbody>
                                    </table>
                                </div>

                                <!-- Mobile Cards -->

                                <div class="md:hidden space-y-4">
                                    <%for(let i=0; i<wallet.length; i++){%>
                                        <div class="bg-gray-50 border border-gray-200 rounded-lg p-4">
                                            <div class="flex justify-between items-start mb-2">
                                                <span class="text-xs text-gray-500">
                                                    <%=wallet[i].transactionId%>
                                                </span>
                                                <span class="text-xs <%= wallet[i].type === 'CREDIT' ? 'text-green-600' : 'text-red-600' %> font-medium">
                                                    <%=wallet[i].type%>
                                                </span>
                                            </div>
                                            <div class="flex justify-between items-center">
                                                <span
                                                    class="text-xs text-gray-500"><%=wallet[i].createdAt.toLocaleDateString("en-CA")%></span>
                                                <span class="text-lg font-medium text-gray-900">₹<%=wallet[i].amount%>
                                                        </span>
                                            </div>
                                        </div>
                                        <%}%>
                                </div>

                            </div>
                            <%}%>

                                <!-- Add Money Button -->
                                <div class="flex justify-center">
                                    <button id="addMoneyBtn"
                                        class="w-full sm:w-auto px-6 md:px-8 py-3 bg-black text-white rounded-lg hover:bg-gray-800 transition-colors duration-200 font-medium text-sm md:text-base">
                                        ADD Money
                                    </button>
                                </div>

                                <%if(wallet.length>0){%>
                                    <div class=" flex justify-center mt-3">
                                        <ul class="flex items-center space-x-2">

                                            <% if (current==1) { %>
                                                <li>
                                                    <span
                                                        class="px-3 py-1.5 text-sm font-medium text-gray-400 border border-gray-300 rounded-md cursor-not-allowed">
                                                        First
                                                    </span>
                                                </li>
                                                <% } else { %>
                                                    <li>
                                                        <a href="/wallet/?page=1"
                                                            class="px-3 py-1.5 text-sm font-medium text-gray-700 border border-gray-300 rounded-md hover:bg-gray-100">
                                                            First
                                                        </a>
                                                    </li>
                                                    <% } %>

                                                        <!-- Ellipsis before -->
                                                        <% let i=(Number(current)> 5 ? Number(current) - 4 : 1); %>
                                                            <% if (i !==1) { %>
                                                                <li>
                                                                    <span
                                                                        class="px-3 py-1.5 text-sm font-medium text-gray-500">...</span>
                                                                </li>
                                                                <% } %>

                                                                    <!-- Page Numbers -->
                                                                    <% for (; i <=(Number(current) + 4) && i <=pages;
                                                                        i++) { %>
                                                                        <% if (i==current) { %>
                                                                            <li>
                                                                                <span
                                                                                    class="px-3 py-1.5 text-sm font-medium text-white bg-black border border-gray-300 rounded-md">
                                                                                    <%= i %>
                                                                                </span>
                                                                            </li>
                                                                            <% } else { %>
                                                                                <li>
                                                                                    <a href="/wallet/?page=<%= i %>"
                                                                                        class="px-3 py-1.5 text-sm font-medium text-gray-700 border border-gray-300 rounded-md hover:bg-gray-100">
                                                                                        <%= i %>
                                                                                    </a>
                                                                                </li>
                                                                                <% } %>

                                                                                    <% if (i==Number(current) + 4 && i <
                                                                                        pages) { %>
                                                                                        <li>
                                                                                            <span
                                                                                                class="px-3 py-1.5 text-sm font-medium text-gray-500">...</span>
                                                                                        </li>
                                                                                        <% } %>
                                                                                            <% } %>

                                                                                                <!-- Last Page -->
                                                                                                <% if (current==pages) {
                                                                                                    %>
                                                                                                    <li>
                                                                                                        <span
                                                                                                            class="px-3 py-1.5 text-sm font-medium text-gray-400 border border-gray-300 rounded-md cursor-not-allowed">
                                                                                                            Last
                                                                                                        </span>
                                                                                                    </li>
                                                                                                    <% } else { %>
                                                                                                        <li>
                                                                                                            <a href="/wallet/?page=<%= pages %>"
                                                                                                                class="px-3 py-1.5 text-sm font-medium text-gray-700 border border-gray-300 rounded-md hover:bg-gray-100">
                                                                                                                Last
                                                                                                            </a>
                                                                                                        </li>
                                                                                                        <% } %>
                                        </ul>
                                    </div>
                                    <%}%>
                    </div>
                </main>

        </div>
        <!-- Add Money Modal -->
        <div id="addMoneyModal"
            class="fixed inset-0 bg-black bg-opacity-50 hidden items-center justify-center z-50 flex">

            <div class="bg-white p-6 rounded-lg w-80 shadow-lg">
                <h2 class="text-lg font-semibold mb-4 text-center">Add Money to Wallet</h2>

                <input type="number" id="walletAmountInput" class="w-full border px-3 py-2 rounded mb-4"
                    placeholder="Enter amount" />

                <div class="flex justify-between">
                    <button id="cancelAddMoney" class="px-4 py-2 bg-gray-300 rounded hover:bg-gray-400">
                        Cancel
                    </button>

                    <button id="confirmAddMoney" class="px-4 py-2 bg-black text-white rounded hover:bg-gray-900">
                        Add
                    </button>
                </div>
            </div>
        </div>
        <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
        <script>
            const modal = document.getElementById('addMoneyModal');
            const addMoneyBtn = document.getElementById('addMoneyBtn');
            const confirmBtn = document.getElementById('confirmAddMoney');
            const cancelBtn = document.getElementById('cancelAddMoney');
            const amountInput = document.getElementById('walletAmountInput');
            addMoneyBtn.addEventListener('click', () => {
                modal.classList.remove('hidden');
            });
            cancelBtn.addEventListener('click', () => {
                modal.classList.add('hidden');
            });
            confirmBtn.addEventListener('click', () => {
                let amount = amountInput.value;
                if (!amount || isNaN(amount) || amount < 1) {
                    Swal.fire({
                        title: "Transaction Cancelled",
                        text: "Enter an amount gerater than 0.",
                        icon: "warning",
                        timer: 1500,
                    });
                    return
                }
                modal.classList.add('hidden');
                createOrder(amount);
            })
            async function createOrder(amount) {
                try {
                    const res = await fetch('/wallet/create-order', {
                        method: 'POST',
                        headers: {
                            "Content-Type": 'application/json',
                        },
                        body: JSON.stringify({ amount }),
                    });
                    const data = await res.json();
                    if (data.success) {
                        openRazorpayCheckout(data);
                    } else {
                        Swal.fire({
                            title: "Failed!",
                            text: "Unable to add money. Please try again.",
                            icon: "error",
                            confirmButtonColor: "#000"
                        })
                    }
                } catch (error) {
                    console.error("Error:", error);

                    Swal.fire({
                        title: "Error!",
                        text: "Something went wrong.",
                        icon: "error",
                        confirmButtonColor: "#000"
                    });
                }
            }
            function openRazorpayCheckout(orderData) {
                var options = {
                    key: "rzp_test_RhHusrM3lncUVO",
                    amount: orderData.amount,
                    currency: orderData.currency,
                    name: "clickNbuild",
                    description: "Add money to wallet",
                    image: "https://res.cloudinary.com/dmx7sia5q/image/upload/v1762177534/do7hdqd5snvtmeqmnoa7.jpg",
                    order_id: orderData.order_id,
                    handler: function (response) {
                        verifyPayment(response, orderData.amount);
                    },
                    theme: {
                        color: "#000000",
                    }
                };
                var rzp = new Razorpay(options);
                rzp.open();
            }
            async function verifyPayment(paymentData, amount) {
                try {
                    const res = await fetch('/wallet/verify-payment', {
                        method: "POST",
                        headers: {
                            'Content-Type': "application/json",
                        },
                        body: JSON.stringify({
                            paymentData, amount
                        }),
                    });
                    const data = await res.json();
                    if (data.success) {
                        Swal.fire({
                            title: "Money added!",
                            text: "Money added to the wallet.",
                            icon: "success"
                        }).then(() => {
                            window.location.reload();
                        });
                    } else {
                        Swal.fire({
                            title: "Payment Failed",
                            text: "Verification failed, Your money will be refunded if deducted.",
                            icon: 'error',
                        })
                    }
                } catch (error) {
                    console.error(error);
                }
            }
        </script>

        <%- include("../../views/partials/user/footer")%>

            <script>
                // Mobile Sidebar Toggle
                const mobileSidebarBtn = document.getElementById('mobileSidebarBtn');
                const sidebarOverlay = document.getElementById('sidebarOverlay');
                const userSidebar = document.getElementById('userSidebar');

                mobileSidebarBtn.addEventListener('click', () => {
                    userSidebar.classList.remove('hidden');
                    userSidebar.classList.add('fixed', 'inset-y-0', 'left-0', 'z-50', 'overflow-y-auto', 'w-80');
                    sidebarOverlay.classList.remove('hidden');
                });

                sidebarOverlay.addEventListener('click', () => {
                    userSidebar.classList.add('hidden');
                    userSidebar.classList.remove('fixed', 'inset-y-0', 'left-0', 'z-50', 'overflow-y-auto', 'w-80');
                    sidebarOverlay.classList.add('hidden');

                    // Restore desktop visibility
                    if (window.innerWidth >= 1024) {
                        userSidebar.classList.remove('hidden');
                    }
                });

                // Handle window resize
                window.addEventListener('resize', () => {
                    if (window.innerWidth >= 1024) {
                        userSidebar.classList.remove('hidden', 'fixed', 'inset-y-0', 'left-0', 'z-50', 'overflow-y-auto', 'w-80');
                        sidebarOverlay.classList.add('hidden');
                    }
                });
            </script>


</body>

</html>