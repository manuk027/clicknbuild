<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Category List - Admin Dashboard</title>
    <link rel="icon" href="https://res.cloudinary.com/dmx7sia5q/image/upload/v1761540715/logo_dtmtfn.png"
        type="image/png">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>

<body class="bg-gray-50">

    <div class="flex min-h-screen">
        <aside id="sidebar"
            class="fixed left-0 top-0 h-screen w-64 bg-white overflow-y-auto sticky shadow-lg z-40 transform -translate-x-full lg:translate-x-0 transition-transform duration-300 overflow-hidden">
            <%- include("../../views/partials/admin/sidebar") %>
        </aside>

        <div class="flex-1 flex flex-col min-h-screen">
            <header class="bg-white shadow-sm sticky top-0 z-30">
                <%- include("../../views/partials/admin/header") %>
            </header>

            <main class="flex-1 p-4 sm:p-6 lg:p-8">
                <div class="mb-6">
                    <div class="flex justify-between items-center w-full">
                        <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-2">
                            PRODUCT LIST
                        </h1>
                        <a href="/admin/products/addProducts"
                            class="flex items-center justify-center gap-2 px-4 py-2.5 border border-black rounded-lg hover:bg-gray-50 hover:text-black transition-colors bg-black text-white">
                            <span>ADD PRODUCT</span>
                            <i class="fas fa-plus"></i>
                        </a>
                    </div>
                    <div class="flex items-center gap-2 text-sm text-gray-600">
                        <span><a href="/admin">Dashboard</a></span>
                        <i class="fas fa-chevron-right text-xs"></i>
                        <span class="text-gray-900">Product</span>
                    </div>
                </div>

                <div class="flex flex-col sm:flex-row gap-4 mb-6">
                    <div class="flex-1 relative">
                        <i class="fas fa-search absolute left-3 top-1/2 -translate-y-1/2 text-gray-400"></i>
                        <input type="text" id="searchInput" placeholder="Search category..."
                            class="w-full pl-10 pr-4 py-2.5 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-gray-900 focus:border-transparent">
                    </div>
                    <div class="flex gap-4">
                        <div class="relative">
                            <button id="filtersBtn"
                                class="flex items-center gap-2 px-4 py-2.5 border border-gray-300 rounded-lg hover:bg-gray-50 transition-colors">
                                <i class="fas fa-sliders-h"></i>
                                <span>Filters</span>
                                <i class="fas fa-chevron-down text-sm ml-1"></i>
                            </button>
                            <div id="filtersDropdown"
                                class="hidden absolute mt-2 w-40 bg-white border border-gray-200 rounded-md shadow-lg z-50">
                                <a href="#" class="block px-4 py-2 hover:bg-gray-100">Price</a>
                                <a href="#" class="block px-4 py-2 hover:bg-gray-100">Category</a>
                                <a href="#" class="block px-4 py-2 hover:bg-gray-100">Availability</a>
                            </div>
                        </div>
                        <div class="relative">
                            <button id="sortBtn"
                                class="flex items-center gap-2 px-4 py-2.5 border border-gray-300 rounded-lg hover:bg-gray-50 transition-colors">
                                <i class="fas fa-sort"></i>
                                <span>SORT</span>
                                <i class="fas fa-chevron-down text-sm ml-1"></i>
                            </button>

                            <div id="sortDropdown"
                                class="hidden absolute mt-2 w-36 bg-white border border-gray-200 rounded-md shadow-lg z-50">
                                <a onclick="applySort('newest')" class="block px-4 py-2 hover:bg-gray-100">Newest</a>
                                <a onclick="applySort('oldest')" class="block px-4 py-2 hover:bg-gray-100">Oldest</a>
                            </div>
                        </div>

                        <script>
                            document.getElementById("sortBtn").addEventListener("click", () => {
                                document.getElementById("sortDropdown").classList.toggle("hidden");
                            });

                            document.addEventListener("click", (e) => {
                                if (!document.getElementById("sortBtn").contains(e.target) &&
                                    !document.getElementById("sortDropdown").contains(e.target)) {
                                    document.getElementById("sortDropdown").classList.add("hidden");
                                }
                            });

                            function applySort(sortType) {
                                const url = new URL(window.location.href);
                                url.searchParams.set("sort", sortType);
                                window.location.href = url.toString();
                            }
                        </script>

                    </div>
                </div>

                <div class="bg-white rounded-lg shadow overflow-hidden">
                    <div class="overflow-x-auto">
                        <table class="w-full min-w-[800px] ">
                            <thead class="bg-black text-white text-center">
                                <tr>
                                    <th
                                        class="px-3 sm:px-4 py-3 sm:py-4 text-xs sm:text-sm font-semibold whitespace-nowrap">
                                        Image
                                    </th>
                                    <th
                                        class="px-3 sm:px-4 py-3 sm:py-4 text-xs sm:text-sm font-semibold whitespace-nowrap">
                                        Brand
                                    </th>
                                    <th
                                        class="px-3 sm:px-4 py-3 sm:py-4 text-xs sm:text-sm font-semibold whitespace-nowrap">
                                        Model
                                    </th>
                                    <th
                                        class="px-3 sm:px-4 py-3 sm:py-4 text-xs sm:text-sm font-semibold whitespace-nowrap">
                                        Category
                                    </th>
                                    <th
                                        class="px-3 sm:px-4 py-3 sm:py-4 text-xs sm:text-sm font-semibold whitespace-nowrap">
                                        Listing
                                    </th>
                                    <th
                                        class="px-3 sm:px-4 py-3 sm:py-4 text-xs sm:text-sm font-semibold whitespace-nowrap">
                                        Edit
                                    </th>
                                    <th
                                        class="px-3 sm:px-4 py-3 sm:py-4 text-xs sm:text-sm font-semibold whitespace-nowrap">
                                        Variants
                                    </th>
                                </tr>
                            </thead>

                            <tbody class="divide-y divide-gray-200">
                                <%for(let i=0; i<product.length; i++){%>
                                    <tr class="hover:bg-gray-50 transition-colors">
                                        <td class="px-4 py-4">
                                            <div class="w-10 h-10 flex-shrink-0 mx-auto">
                                                <img src="<%=product[i].images[0]%>" alt="<%= product.name %>"
                                                    class="rounded-full w-full h-full object-cover">
                                            </div>
                                        </td>

                                        <td class="px-4 py-4 text-gray-700">
                                            <%=product[i].brand?.name%>
                                        </td>
                                        <td class="px-4 py-4 text-gray-700">
                                            <%=product[i]?.model%>
                                        </td>
                                        <td class="px-4 py-4 text-gray-700">
                                            <%=product[i]?.category?.name%>
                                        </td>
                                        <td class="px-4 py-4 text-gray-700">
                                            <% if (product[i].isListed) { %>
                                                <a href="/admin/products/unListProduct?id=<%=product[i]._id%>"
                                                    class="inline-flex items-center justify-center w-20 h-8 rounded-full bg-red-600 text-white text-sm font-medium hover:bg-red-700 transition-colors">
                                                    Unlist
                                                </a>
                                                <% } else { %>
                                                    <a href="/admin/products/listProduct?id=<%=product[i]._id%>"
                                                        class="inline-flex items-center justify-center w-20 h-8 rounded-full bg-green-600 text-white text-sm font-medium hover:bg-green-700 transition-colors">
                                                        List
                                                    </a>
                                                    <% } %>
                                        </td>
                                        <td class="px-4 py-4 text-gray-700">
                                            <a class="p-2 text-gray-600 hover:bg-gray-100 rounded"
                                                href="/admin/products/editProduct?id=<%=product[i]._id%>">
                                                <i class="fas fa-edit"></i>

                                            </a>
                                        </td>
                                        <td class="px-4 py-4 text-gray-700">
                                            <button
                                                class="text-gray-600 hover:text-gray-900 transition-colors showVariantsBtn"
                                                data-id="<%= product[i]._id %>">
                                                <i class="far fa-eye text-lg"></i>
                                            </button>

                                        </td>
                                    </tr>
                                    <%}%>
                            </tbody>
                        </table>
                    </div>
                </div>

                <% if (product.length> 0) { %>
                    <div class="flex justify-center m-6">
                        <nav aria-label="Dashboard Pagination">
                            <ul class="flex items-center space-x-2">

                                <!-- First Page -->
                                <% if (current==1) { %>
                                    <li>
                                        <span
                                            class="px-3 py-1.5 text-sm font-medium text-gray-400 border border-gray-300 rounded-md cursor-not-allowed">First</span>
                                    </li>
                                    <% } else { %>
                                        <li>
                                            <a href="/admin/products/?page=1"
                                                class="px-3 py-1.5 text-sm font-medium text-gray-700 border border-gray-300 rounded-md hover:bg-gray-100">First</a>
                                        </li>
                                        <% } %>

                                            <!-- Ellipsis before -->
                                            <% let i=(Number(current)> 5 ? Number(current) - 4 : 1); %>
                                                <% if(i !==1) { %>
                                                    <li><span
                                                            class="px-3 py-1.5 text-sm font-medium text-gray-500">...</span>
                                                    </li>
                                                    <% } %>

                                                        <!-- Page Numbers -->
                                                        <% for(; i <=(Number(current) + 4) && i <=pages; i++) { %>
                                                            <% if (i==current) { %>
                                                                <li>
                                                                    <span
                                                                        class="px-3 py-1.5 text-sm font-medium text-white bg-black border border-gray-300 rounded-md">
                                                                        <%= i %>
                                                                    </span>
                                                                </li>
                                                                <% } else { %>
                                                                    <li>
                                                                        <a href="/admin/products/?page=<%= i %>"
                                                                            class="px-3 py-1.5 text-sm font-medium text-gray-700 border border-gray-300 rounded-md hover:bg-gray-100">
                                                                            <%= i %>
                                                                        </a>
                                                                    </li>
                                                                    <% } %>
                                                                        <% if (i==Number(current) + 4 && i < pages) { %>
                                                                            <li><span
                                                                                    class="px-3 py-1.5 text-sm font-medium text-gray-500">...</span>
                                                                            </li>
                                                                            <% } %>
                                                                                <% } %>

                                                                                    <!-- Last Page -->
                                                                                    <% if (current==pages) { %>
                                                                                        <li>
                                                                                            <span
                                                                                                class="px-3 py-1.5 text-sm font-medium text-gray-400 border border-gray-300 rounded-md cursor-not-allowed">Last</span>
                                                                                        </li>
                                                                                        <% } else { %>
                                                                                            <li>
                                                                                                <a href="/admin/products/?page=<%= pages %>"
                                                                                                    class="px-3 py-1.5 text-sm font-medium text-gray-700 border border-gray-300 rounded-md hover:bg-gray-100">Last</a>
                                                                                            </li>
                                                                                            <% } %>

                            </ul>
                        </nav>
                    </div>
                    <% } %>
            </main>
        </div>
    </div>

    <div id="overlay" class="fixed inset-0 bg-black bg-opacity-50 z-30 hidden lg:hidden"></div>

    <script src="https://code.jquery.com/jquery-3.6.4.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/js/admin/categoryList.js"></script>
    <script src="//cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        document.querySelectorAll(".showVariantsBtn").forEach(button => {
            button.addEventListener("click", async () => {
                const productId = button.dataset.id;

                try {
                    const res = await fetch(`/admin/ptoducts/viewVariants?id=${productId}`);
                    const data = await res.json();
                    if (!data.success) {
                        return Swal.fire("Error", data.message, "error");
                    }
                    const product = data.product;

                    if (!product || !product.variants || product.variants.length === 0) {
                        return Swal.fire("Info", "No variants found for this product.", "info");
                    }

                    // Build variants table HTML
                    let variantsHTML = `
        <table style="width:100%; border-collapse: collapse;">
            <thead>
                <tr>
                    <th style="border:1px solid #ccc; padding:8px;">Variant</th>
                    <th style="border:1px solid #ccc; padding:8px;">Quantity</th>
                    <th style="border:1px solid #ccc; padding:8px;">Price</th>
                    <th style="border:1px solid #ccc; padding:8px;">Offer</th>
                </tr>
            </thead>
            <tbody>
    `;

                    product.variants.forEach(v => {
                        variantsHTML += `
            <tr>
                <td style="border:1px solid #ccc; padding:8px;">${v.variant}</td>
                <td style="border:1px solid #ccc; padding:8px;">${v.quantity}</td>
                <td style="border:1px solid #ccc; padding:8px;">${v.price}</td>
                <td style="border:1px solid #ccc; padding:8px;">${v.offer}</td>
            </tr>
        `;
                    });

                    variantsHTML += '</tbody></table>';

                    // Show popup
                    Swal.fire({
                        title: `Variants of ${product.model}`,
                        html: variantsHTML,
                        width: '700px',
                        showCloseButton: true,
                        confirmButtonText: 'Close'
                    });

                } catch (error) {
                    console.error(error);
                    Swal.fire("Error", "Failed to fetch product variants.", "error");
                }

            });
        });
    </script>

</body>

</html>