                            </select>
                            <button
                                class="bg-black text-white px-4 sm:px-6 py-2 text-sm sm:text-base rounded-full hover:bg-gray-800 transition whitespace-nowrap">Write
                                a Review</button>
                        </div>
                    </div>

                    <!-- Reviews Grid -->
                    <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 sm:gap-6 mb-8">
                        <!-- Review 1 -->
                        <div class="border border-gray-200 rounded-lg p-4 sm:p-6 hover:shadow-lg transition">
                            <div class="flex justify-between items-start mb-3">
                                <div class="flex text-yellow-400 text-sm sm:text-base">
                                    <i class="fas fa-star"></i>
                                    <i class="fas fa-star"></i>
                                    <i class="fas fa-star"></i>
                                    <i class="fas fa-star"></i>
                                    <i class="fas fa-star-half-alt"></i>
                                </div>
                                <button class="text-gray-400 hover:text-gray-600">
                                    <i class="fas fa-ellipsis-v"></i>
                                </button>
                            </div>
                            <div class="flex items-center gap-2 mb-3">
                                <h4 class="font-semibold text-sm sm:text-base">Samantha D.</h4>
                                <i class="fas fa-check-circle text-green-500 text-xs sm:text-sm"></i>
                            </div>
                            <p class="text-gray-600 text-xs sm:text-sm mb-3 line-clamp-4">"Cooler Gelis is the first
                                brand that comes to mind when I think of a soft drink. It's refreshing and I love the
                                taste." "It's a brand I've grown up with and trust. It's perfect for parties and
                                celebrations." "I feel Gelis is a good substitute for the price, and it's a trend
                                finally."</p>
                            <p class="text-gray-400 text-xs">Posted on August 15, 2025</p>
                        </div>
                        <div class="border border-gray-200 rounded-lg p-4 sm:p-6 hover:shadow-lg transition">
                            <div class="flex justify-between items-start mb-3">
                                <div class="flex text-yellow-400 text-sm sm:text-base">
                                    <i class="fas fa-star"></i>
                                    <i class="fas fa-star"></i>
                                    <i class="fas fa-star"></i>
                                    <i class="fas fa-star"></i>
                                    <i class="fas fa-star-half-alt"></i>
                                </div>
                                <button class="text-gray-400 hover:text-gray-600">
                                    <i class="fas fa-ellipsis-v"></i>
                                </button>
                            </div>
                            <div class="flex items-center gap-2 mb-3">
                                <h4 class="font-semibold text-sm sm:text-base">Ava H.</h4>
                                <i class="fas fa-check-circle text-green-500 text-xs sm:text-sm"></i>
                            </div>
                            <p class="text-gray-600 text-xs sm:text-sm mb-3 line-clamp-4">"Cooler Gelis is the first
                                brand that comes to mind when I think of a soft drink. It's refreshing and I love the
                                taste." "It's a brand I've grown up with and trust. It's perfect for parties and
                                celebrations." "I feel Gelis is a good substitute for the price, and it's a trend
                                finally."</p>
                            <p class="text-gray-400 text-xs">Posted on August 18, 2025</p>
                        </div>
                    </div>

                    <!-- Pagination -->
                    <div class="flex justify-center items-center gap-2 flex-wrap">
                        <button
                            class="w-8 h-8 sm:w-10 sm:h-10 flex items-center justify-center border border-gray-300 rounded-lg hover:bg-gray-100 transition">
                            <i class="fas fa-chevron-left text-xs sm:text-sm"></i>
                        </button>
                        <button
                            class="w-8 h-8 sm:w-10 sm:h-10 flex items-center justify-center bg-black text-white rounded-lg text-sm">1</button>
                        <button
                            class="w-8 h-8 sm:w-10 sm:h-10 flex items-center justify-center border border-gray-300 rounded-lg hover:bg-gray-100 transition text-sm">2</button>
                        <button
                            class="w-8 h-8 sm:w-10 sm:h-10 flex items-center justify-center border border-gray-300 rounded-lg hover:bg-gray-100 transition text-sm">3</button>
                        <span class="px-2 text-sm">...</span>
                        <button
                            class="w-8 h-8 sm:w-10 sm:h-10 flex items-center justify-center border border-gray-300 rounded-lg hover:bg-gray-100 transition text-sm">5</button>
                        <button
                            class="w-8 h-8 sm:w-10 sm:h-10 flex items-center justify-center border border-gray-300 rounded-lg hover:bg-gray-100 transition">
                            <i class="fas fa-chevron-right text-xs sm:text-sm"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
        </div>
        <!-- Recommended Products Section -->

        <% const shuffled=recommendedProducts.sort(()=> 0.5 -Math.random());
            const randomProducts = shuffled.slice(0, 4);
            %>
            <div class="container mx-auto px-4 py-12 max-w-7xl">
                <h2 class="text-2xl sm:text-3xl font-semibold mb-8 text-gray-900">Recommended Products</h2>

                <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-6">
                    <% recommendedProducts.forEach(p=> { %>
                        <div class="border border-gray-200 rounded-xl overflow-hidden hover:shadow-lg transition">
                            <a href="/product?id=<%= p._id %>" class="block">
                                <img src="<%= p.images[0] %>" alt="<%= p.model %>"
                                    class="w-full h-48 object-contain bg-gray-50 p-4">
                                <div class="p-4">
                                    <h3 class="text-sm sm:text-base font-medium text-gray-800 truncate">
                                        <%= p.brand.name %>
                                            <%= p.model %>
                                    </h3>
                                    <div class="mt-1 flex items-center gap-2">
                                        <span class="text-lg sm:text-xl font-bold text-black">₹<%= p.variants[0].offer
                                                %>
                                        </span>
                                        <span class="text-gray-500 text-sm line-through">₹<%= p.variants[0].price %>
                                        </span>
                                    </div>
                                    <a href="/product?id=<%= p._id %>"
                                        class="mt-3 w-full bg-black text-white py-2 rounded-full text-sm hover:bg-gray-800 transition inline-block text-center">
                                        View Details
                                    </a>
                                </div>
                            </a>
                        </div>
                        <% }) %>
                </div>
            </div>

            <%- include("../../views/partials/user/footer") %>
                <script>
                    // Tab switching
                    const tabBtns = document.querySelectorAll(' .tab-btn'); const
                        tabContents = document.querySelectorAll('.tab-content'); tabBtns.forEach(btn => {
                            btn.addEventListener('click', () => {
                                const tabName = btn.getAttribute('data-tab');

                                // Remove active classes
                                tabBtns.forEach(b => {
                                    b.classList.remove('border-black', 'text-gray-900');
                                    b.classList.add('border-transparent', 'text-gray-600');
                                });

                                // Add active class to clicked tab
                                btn.classList.add('border-black', 'text-gray-900');
                                btn.classList.remove('border-transparent', 'text-gray-600');

                                // Hide all content
                                tabContents.forEach(content => content.classList.add('hidden'));

                                // Show selected content
                                document.getElementById(tabName + 'Tab').classList.remove('hidden');
                            });
                        });

                    // Show **details tab** by default
                    document.getElementById('detailsTab').classList.remove('hidden');

                    // Make the "Product Details" button active by default
                    tabBtns.forEach(btn => {
                        if (btn.getAttribute('data-tab') === 'details') {
                            btn.classList.add('border-black', 'text-gray-900');
                            btn.classList.remove('border-transparent', 'text-gray-600');
                        } else {
                            btn.classList.remove('border-black', 'text-gray-900');
                            btn.classList.add('border-transparent', 'text-gray-600');
                        }
                    });

                    // Color button selection
                    const colorBtns = document.querySelectorAll('.color-btn');
                    colorBtns.forEach(btn => {
                        btn.addEventListener('click', () => {
                            colorBtns.forEach(b => {
                                b.classList.remove('border-black', 'bg-black', 'text-white');
                                b.classList.add('border-gray-300', 'bg-white', 'text-gray-700');
                            });

                            if (btn.textContent.trim() === 'Black') {
                                btn.classList.add('border-black', 'bg-black', 'text-white');
                                btn.classList.remove('border-gray-300', 'bg-white', 'text-gray-700');
                            } else {
                                btn.classList.add('border-gray-300', 'bg-white', 'text-gray-700');
                            }
                        });
                    });

                    // Rating stars
                    const ratingStars = document.querySelectorAll('.rating-star');
                    let selectedRating = 0;

                    ratingStars.forEach(star => {
                        star.addEventListener('click', () => {
                            selectedRating = parseInt(star.getAttribute('data-rating'));
                            updateStars();
                        });

                        star.addEventListener('mouseenter', () => {
                            const rating = parseInt(star.getAttribute('data-rating'));
                            ratingStars.forEach((s, index) => {
                                if (index < rating) {
                                    s.classList.remove('far', 'text-gray-300');
                                    s.classList.add('fas', 'text-yellow-400');
                                } else {
                                    s.classList.remove('fas', 'text-yellow-400');
                                    s.classList.add('far', 'text-gray-300');
                                }
                            });
                        });
                    });

                    const starsContainer = document.querySelector('.rating-star').parentElement;
                    starsContainer.addEventListener('mouseleave', () => {
                        updateStars();
                    });

                    function updateStars() {
                        ratingStars.forEach((star, index) => {
                            if (index < selectedRating) {
                                star.classList.remove('far', 'text-gray-300');
                                star.classList.add('fas', 'text-yellow-400');
                            } else {
                                star.classList.remove('fas', 'text-yellow-400');
                                star.classList.add('far', 'text-gray-300');
                            }
                        });
                    }
                </script>
                <script>
                    document.addEventListener("DOMContentLoaded", () => {
                        const addToCartBtn = document.getElementById("add-to-cart-btn");

                        if (!addToCartBtn) return; // Safety check

                        addToCartBtn.addEventListener("click", async (event) => {
                            event.preventDefault();

                            const productId = "<%= product._id %>";
                            const variantId = "<%= product.variants[index]._id %>";
                            console.log(variantId, productId);

                            try {
                                const response = await fetch("/cart/add", {
                                    method: "POST",
                                    headers: { "Content-Type": "application/json" },
                                    body: JSON.stringify({ productId, variantId, quantity: 1 }),
                                    credentials: "include", // ✅ always include cookies/session
                                });

                                const contentType = response.headers.get("content-type");

                                // ⚠️ Handle non-JSON (e.g. login page HTML)
                                if (!contentType || !contentType.includes("application/json")) {
                                    await Swal.fire({
                                        icon: "warning",
                                        title: "Login Required",
                                        text: "Please log in to add items to your cart.",
                                        confirmButtonColor: "#000000",
                                    });
                                    window.location.href = "/login";
                                    return;
                                }

                                const data = await response.json();

                                if (response.status === 401) {
                                    await Swal.fire({
                                        icon: "warning",
                                        title: "Login Required",
                                        text: "Please log in to continue shopping.",
                                        confirmButtonColor: "#000000",
                                    });
                                    window.location.href = "/login";
                                    return;
                                }

                                if (data.success) {
                                    await Swal.fire({
                                        icon: "success",
                                        title: "Added to Cart!",
                                        text: data.message || "Product added to cart successfully.",
                                        confirmButtonColor: "#000000",
                                        confirmButtonText: "OK",
                                    });

                                    // ✅ Redirect to homepage (or wherever you want)
                                    window.location.reload();
                                } else {
                                    await Swal.fire({
                                        icon: "warning",
                                        title: "Could Not Add Product",
                                        text: data.message || "Something went wrong. Please try again.",
                                        confirmButtonColor: "#000000",
                                    });
                                }

                            } catch (error) {
                                console.error("❌ Error adding to cart:", error);
                                await Swal.fire({
                                    icon: "error",
                                    title: "Server Error",
                                    text: "Unable to connect to the server. Please try again later.",
                                    confirmButtonColor: "#000000",
                                });
                            }

                        });
                    });
                </script>


</body>

</html>