<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Product - Admin Dashboard</title>
    <link rel="icon" href="https://res.cloudinary.com/dmx7sia5q/image/upload/v1761540715/logo_dtmtfn.png" type="image/png">
    
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/axios/1.6.6/axios.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.js"></script>

    <style>
        @keyframes loader-slide {
            0% { transform: translateX(-100%); }
            50% { transform: translateX(100%); }
            100% { transform: translateX(-100%); }
        }
        .animate-loader {
            animation: loader-slide 1.5s ease-in-out infinite;
        }
        /* Error Styling */
        .is-invalid {
            border-color: #dc2626 !important; /* Red border */
            background-color: #fef2f2; /* Light red background */
        }
        .error-text {
            color: #dc2626;
            font-size: 0.75rem; /* text-xs */
            margin-top: 0.25rem;
        }
    </style>
</head>

<body class="bg-gray-50 font-sans text-gray-900">

    <%- include("../../views/partials/admin/sidebar") %>

    <div class="flex flex-col min-h-screen lg:ml-64 transition-all duration-300">
        
        <header class="bg-white shadow-sm sticky top-0 z-30">
            <%- include("../../views/partials/admin/header") %>
        </header>

        <main class="flex-1 p-4 sm:p-6 lg:p-8">

            <div class="mb-6">
                <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-2">ADD PRODUCT</h2>
                <div class="flex items-center gap-2 text-sm text-gray-600">
                    <span><a href="/admin" class="hover:text-black">Dashboard</a></span>
                    <i class="fas fa-chevron-right text-xs"></i>
                    <span class="text-gray-900"><a href="/admin/products" class="hover:text-black">Products</a></span>
                    <i class="fas fa-chevron-right text-xs"></i>
                    <span class="text-gray-900 font-medium">Add</span>
                </div>
            </div>

            <section class="bg-white rounded-lg shadow-sm p-6 mb-6">
                <h2 class="text-lg font-semibold text-gray-800 mb-4">General Information</h2>
                <div class="space-y-4">

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">Brand</label>
                            <select name="brand" id="brand" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none transition-colors">
                                <option value="">Select Brand</option>
                                <% brand.forEach(b=> { %>
                                    <option value="<%= b._id %>"><%= b.name %></option>
                                <% }) %>
                            </select>
                            <p class="error-text hidden">Brand is required.</p>
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">Product Name</label>
                            <input type="text" name="productName" id="productName" placeholder="Type product name here..." class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none transition-colors">
                            <p class="error-text hidden">Product name is required.</p>
                        </div>
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Description</label>
                        <textarea name="description" id="description" rows="4" placeholder="Write a short description..." class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none resize-none transition-colors"></textarea>
                        <p class="error-text hidden">Description is required.</p>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">Category</label>
                            <select name="category" id="category" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none transition-colors">
                                <option value="">Select Category</option>
                                <% category.forEach(c=> { %>
                                    <option value="<%= c._id %>"><%= c.name %></option>
                                <% }) %>
                            </select>
                            <p class="error-text hidden">Category is required.</p>
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">Status</label>
                            <div class="flex items-center gap-8">
                                <label class="flex items-center gap-2 cursor-pointer">
                                    <input type="radio" name="status" value="listed" checked class="text-blue-600">
                                    <span>Listed</span>
                                </label>
                                <label class="flex items-center gap-2 cursor-pointer">
                                    <input type="radio" name="status" value="unlisted" class="text-blue-600">
                                    <span>Unlisted</span>
                                </label>
                            </div>
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">Category Type</label>
                            <div class="flex items-center gap-8">
                                <label class="flex items-center gap-2 cursor-pointer">
                                    <input type="radio" name="categoryType" value="component" checked class="text-blue-600">
                                    <span>Component</span>
                                </label>
                                <label class="flex items-center gap-2 cursor-pointer">
                                    <input type="radio" name="categoryType" value="peripheral" class="text-blue-600">
                                    <span>Peripheral</span>
                                </label>
                            </div>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <label class="flex items-center gap-2 text-sm font-medium text-gray-700 cursor-pointer">
                            <input type="checkbox" name="limitedEdition" class="text-blue-600 rounded">
                            <span>Limited Edition</span>
                        </label>
                        <label class="flex items-center gap-2 text-sm font-medium text-gray-700 cursor-pointer">
                            <input type="checkbox" name="flashSale" class="text-blue-600 rounded">
                            <span>Flash Sale</span>
                        </label>
                    </div>

                </div>
            </section>

            <section class="bg-white rounded-lg shadow-sm p-6 mb-6">
                <h2 class="text-lg font-semibold text-gray-800 mb-4">Product Images (Exactly 4 Required)</h2>
                <div id="imageContainer" class="grid grid-cols-2 sm:grid-cols-4 gap-4">
                    <div id="uploadBox" class="border-2 border-dashed border-gray-300 rounded-lg p-6 flex flex-col items-center justify-center bg-gray-50 hover:border-blue-400 transition cursor-pointer text-center aspect-square">
                        <i class="fas fa-image text-3xl text-blue-400 mb-2"></i>
                        <p class="text-sm text-gray-500">Click or Drop Image</p>
                        <input type="file" id="imageInput" class="hidden" accept="image/*" multiple>
                    </div>
                </div>
                <p id="imageError" class="error-text hidden font-medium text-sm mt-2">You must upload exactly 4 images.</p>
            </section>

            <section class="bg-white rounded-lg shadow-sm p-6 mb-6">
                <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-4 gap-2">
                    <h2 class="text-lg font-semibold text-gray-800">Product Variants</h2>
                    <button type="button" id="addVariantBtn" class="px-4 py-2 bg-blue-50 text-blue-600 rounded-lg hover:bg-blue-100 transition text-sm font-medium">
                        + Add Variant
                    </button>
                </div>
                <div id="variantContainer" class="space-y-4">
                    <div class="grid grid-cols-1 sm:grid-cols-4 gap-4 variant-row relative p-4 bg-gray-50 rounded-lg border border-gray-200">
                        <div>
                            <input type="text" name="variant[]" placeholder="Variant Name" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none text-sm">
                            <p class="error-text hidden"></p>
                        </div>
                        <div>
                            <input type="number" name="quantity[]" placeholder="Quantity" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none text-sm">
                            <p class="error-text hidden"></p>
                        </div>
                        <div>
                            <input type="number" name="price[]" placeholder="Price" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none text-sm">
                            <p class="error-text hidden"></p>
                        </div>
                        <div>
                            <input type="number" name="offerPrice[]" placeholder="Offer Price" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none text-sm">
                            <p class="error-text hidden"></p>
                        </div>
                    </div>
                </div>
                <p id="variantMainError" class="error-text hidden font-medium text-sm mt-2">At least one variant row is required.</p>
            </section>

            <section class="bg-white rounded-lg shadow-sm p-6 mb-6">
                <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-4 gap-2">
                    <h2 class="text-lg font-semibold text-gray-800">Product Specifications</h2>
                    <button type="button" id="addSpecBtn" class="px-4 py-2 bg-green-50 text-green-600 rounded-lg hover:bg-green-100 transition text-sm font-medium">
                        + Add Specification
                    </button>
                </div>
                <div id="specContainer" class="space-y-4">
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 spec-row relative p-4 bg-gray-50 rounded-lg border border-gray-200">
                        <div>
                            <input type="text" name="specTitle[]" placeholder="Title (e.g. Processor)" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none text-sm">
                            <p class="error-text hidden"></p>
                        </div>
                        <div>
                            <input type="text" name="specification[]" placeholder="Details (e.g. Intel i9)" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none text-sm">
                            <p class="error-text hidden"></p>
                        </div>
                    </div>
                </div>
                <p id="specMainError" class="error-text hidden font-medium text-sm mt-2">At least one complete specification is required.</p>
            </section>

            <div class="flex flex-col sm:flex-row gap-4 mb-8">
                <button type="button" id="submitBtn" class="flex-1 px-6 py-3 bg-black text-white rounded-lg font-medium hover:bg-gray-800 transition shadow-lg transform active:scale-95">
                    Add Product
                </button>
                <a href="/admin/products" class="sm:w-auto px-8 py-3 border border-gray-300 text-gray-700 text-center rounded-lg hover:bg-gray-50 transition font-medium">
                    Cancel
                </a>
            </div>

        </main>
    </div>

    <div id="loader" class="fixed inset-0 bg-white/90 flex items-center justify-center z-[70] hidden">
        <div class="flex flex-col items-center">
            <h1 id="logoTextLoader" class="text-4xl font-bold text-gray-800 mb-4">clickNbuild</h1>
            <div class="w-24 h-1 rounded-full overflow-hidden relative bg-gray-200">
                <div class="loader-bar absolute left-0 top-0 w-full h-full bg-gradient-to-r from-blue-400 via-purple-500 to-pink-500 animate-loader"></div>
            </div>
        </div>
    </div>

    <script>
        // ---------------- UTILS ----------------
        // Helper to remove red borders/messages when user types
        document.addEventListener('input', function(e) {
            if (e.target.classList.contains('is-invalid')) {
                e.target.classList.remove('is-invalid');
                // Find sibling error text
                const parent = e.target.parentElement;
                const err = parent.querySelector('.error-text');
                if(err) err.classList.add('hidden');
            }
        });

        // ---------------- IMAGE HANDLING ----------------
        const imageInput = document.getElementById("imageInput");
        const uploadBox = document.getElementById("uploadBox");
        const imageContainer = document.getElementById("imageContainer");
        let images = [];

        uploadBox.addEventListener("click", () => imageInput.click());
        imageInput.addEventListener("change", e => handleFiles(Array.from(e.target.files)));
        
        // Drag & Drop
        uploadBox.addEventListener("dragover", e => { e.preventDefault(); uploadBox.classList.add("border-blue-400", "bg-blue-50"); });
        uploadBox.addEventListener("dragleave", e => { e.preventDefault(); uploadBox.classList.remove("border-blue-400", "bg-blue-50"); });
        uploadBox.addEventListener("drop", e => { 
            e.preventDefault(); 
            uploadBox.classList.remove("border-blue-400", "bg-blue-50"); 
            handleFiles(Array.from(e.dataTransfer.files)); 
        });

        function handleFiles(files) {
            if (images.length + files.length > 4) { 
                const imgErr = document.getElementById("imageError");
                imgErr.textContent = "You cannot add more than 4 images.";
                imgErr.classList.remove("hidden");
                return; 
            }
            document.getElementById("imageError").classList.add("hidden");
            
            files.forEach(file => {
                const reader = new FileReader();
                reader.onload = () => {
                    const imgObj = { name: file.name, url: reader.result, file };
                    images.push(imgObj);
                    renderImages();
                };
                reader.readAsDataURL(file);
            });
            imageInput.value = "";
        }

        function renderImages() {
            imageContainer.innerHTML = "";
            images.forEach((img, idx) => {
                const div = document.createElement("div");
                div.className = "relative group border border-gray-300 rounded-lg overflow-hidden aspect-square";
                div.innerHTML = `<img src="${img.url}" class="w-full h-full object-cover">
                                <button data-index="${idx}" class="absolute top-2 right-2 bg-red-600 text-white w-7 h-7 rounded-full flex items-center justify-center shadow-md opacity-0 group-hover:opacity-100 transition z-10">&times;</button>`;
                imageContainer.appendChild(div);
                
                // Initialize Cropper
                img.cropper = new Cropper(div.querySelector("img"), { 
                    aspectRatio: 1, 
                    viewMode: 1,
                    autoCropArea: 1
                });
                
                div.querySelector("button").addEventListener("click", (e) => { 
                    e.preventDefault(); 
                    images.splice(idx, 1); 
                    renderImages(); 
                });
            });

            if (images.length < 4) {
                imageContainer.appendChild(uploadBox);
                uploadBox.classList.remove("hidden");
            } else {
                uploadBox.classList.add("hidden");
            }
        }

        // ---------------- VARIANTS ----------------
        const addVariantBtn = document.getElementById("addVariantBtn");
        const variantContainer = document.getElementById("variantContainer");

        addVariantBtn.addEventListener("click", () => {
            const row = document.createElement("div");
            row.className = "grid grid-cols-1 sm:grid-cols-4 gap-4 variant-row relative p-4 bg-gray-50 rounded-lg border border-gray-200 animate-fade-in";
            // Note: Each input is wrapped in a DIV to hold the error message below it
            row.innerHTML = `
                <div>
                    <input type="text" name="variant[]" placeholder="Variant Name" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none text-sm">
                    <p class="error-text hidden"></p>
                </div>
                <div>
                    <input type="number" name="quantity[]" placeholder="Quantity" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none text-sm">
                    <p class="error-text hidden"></p>
                </div>
                <div>
                    <input type="number" name="price[]" placeholder="Price" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none text-sm">
                    <p class="error-text hidden"></p>
                </div>
                <div>
                    <input type="number" name="offerPrice[]" placeholder="Offer Price" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none text-sm">
                    <p class="error-text hidden"></p>
                </div>
                <button type="button" class="absolute -top-2 -right-2 bg-red-600 text-white w-7 h-7 rounded-full shadow-md flex items-center justify-center remove-variant"><i class="fas fa-times text-xs"></i></button>`;
            variantContainer.appendChild(row);
            
            row.querySelector(".remove-variant").addEventListener("click", () => {
                row.remove();
            });
        });

        // ---------------- SPECIFICATIONS ----------------
        const addSpecBtn = document.getElementById("addSpecBtn");
        const specContainer = document.getElementById("specContainer");
        
        addSpecBtn.addEventListener("click", () => {
            const row = document.createElement("div");
            row.className = "grid grid-cols-1 sm:grid-cols-2 gap-4 spec-row relative p-4 bg-gray-50 rounded-lg border border-gray-200 animate-fade-in";
            row.innerHTML = `
                <div>
                    <input type="text" name="specTitle[]" placeholder="Title" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none text-sm">
                    <p class="error-text hidden"></p>
                </div>
                <div>
                    <input type="text" name="specification[]" placeholder="Specification" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none text-sm">
                    <p class="error-text hidden"></p>
                </div>
                <button type="button" class="absolute -top-2 -right-2 bg-red-600 text-white w-7 h-7 rounded-full shadow-md flex items-center justify-center remove-spec"><i class="fas fa-times text-xs"></i></button>`;
            specContainer.appendChild(row);
            row.querySelector(".remove-spec").addEventListener("click", () => row.remove());
        });

        // ---------------- VALIDATION & SUBMISSION ----------------
        const submitBtn = document.getElementById("submitBtn");
        const loader = document.getElementById("loader");

        // Helper to show error on a specific field
        function showError(inputElement, message) {
            inputElement.classList.add('is-invalid');
            // Assuming the structure is <div> <input> <p class="error-text"> </div>
            const errorP = inputElement.parentElement.querySelector('.error-text');
            if (errorP) {
                errorP.innerText = message;
                errorP.classList.remove('hidden');
            }
        }

        submitBtn.addEventListener("click", async () => {
            
            // 1. Reset All Errors
            document.querySelectorAll(".is-invalid").forEach(e => e.classList.remove("is-invalid"));
            document.querySelectorAll(".error-text").forEach(e => e.classList.add("hidden"));

            let isValid = true;
            let firstErrorElement = null;

            // 2. Validate General Fields
            const brandEl = document.getElementById("brand");
            const nameEl = document.getElementById("productName");
            const descEl = document.getElementById("description");
            const catEl = document.getElementById("category");

            if (!brandEl.value.trim()) { 
                showError(brandEl, "Please select a brand.");
                isValid = false; 
                if(!firstErrorElement) firstErrorElement = brandEl;
            }
            if (!nameEl.value.trim()) { 
                showError(nameEl, "Product name cannot be empty.");
                isValid = false; 
                if(!firstErrorElement) firstErrorElement = nameEl;
            }
            if (!descEl.value.trim()) { 
                showError(descEl, "Description cannot be empty.");
                isValid = false; 
                if(!firstErrorElement) firstErrorElement = descEl;
            }
            if (!catEl.value.trim()) { 
                showError(catEl, "Please select a category.");
                isValid = false; 
                if(!firstErrorElement) firstErrorElement = catEl;
            }

            // 3. Validate Images
            if (images.length !== 4) {
                const imgErr = document.getElementById("imageError");
                imgErr.textContent = `You have uploaded ${images.length} images. Exactly 4 are required.`;
                imgErr.classList.remove("hidden");
                isValid = false;
                if(!firstErrorElement) firstErrorElement = document.getElementById("imageContainer");
            }

            // 4. Validate Variants
            const variantRows = document.querySelectorAll(".variant-row");
            const variantsData = [];
            
            if (variantRows.length === 0) {
                 const vMainErr = document.getElementById("variantMainError");
                 vMainErr.classList.remove("hidden");
                 isValid = false;
            } else {
                variantRows.forEach((row, index) => {
                    const nameIn = row.querySelector("input[name='variant[]']");
                    const qtyIn = row.querySelector("input[name='quantity[]']");
                    const priceIn = row.querySelector("input[name='price[]']");
                    const offerIn = row.querySelector("input[name='offerPrice[]']");

                    let rowValid = true;

                    // Empty Checks
                    if (!nameIn.value.trim()) { 
                        showError(nameIn, "Variant Name required."); 
                        rowValid = false; 
                    }
                    if (!qtyIn.value) { 
                        showError(qtyIn, "Quantity required."); 
                        rowValid = false; 
                    }
                    if (!priceIn.value) { 
                        showError(priceIn, "Price required."); 
                        rowValid = false; 
                    }
                    if (!offerIn.value) { 
                        showError(offerIn, "Offer Price required."); 
                        rowValid = false; 
                    }

                    // Logic Checks (Only if inputs are filled)
                    if (rowValid) {
                        const qty = parseFloat(qtyIn.value);
                        const price = parseFloat(priceIn.value);
                        const offer = parseFloat(offerIn.value);

                        if (qty < 0) {
                            showError(qtyIn, "Quantity cannot be negative.");
                            rowValid = false;
                        }

                        if (price <= 0) {
                            showError(priceIn, "Price must be greater than 0.");
                            rowValid = false;
                        }

                        if (offer < 0) {
                            showError(offerIn, "Offer cannot be negative.");
                            rowValid = false;
                        }

                        if (price > 0 && offer >= 0 && price <= offer) {
                            showError(priceIn, "Regular Price must be higher than Offer Price.");
                            showError(offerIn, "Offer Price must be lower than Regular Price.");
                            rowValid = false;
                        }

                        if (rowValid) {
                            variantsData.push({
                                variant: nameIn.value.trim(),
                                quantity: qty,
                                price: price,
                                offer: offer
                            });
                        }
                    }
                    
                    if (!rowValid) {
                        isValid = false;
                        if(!firstErrorElement) firstErrorElement = row;
                    }
                });
            }

            // 5. Validate Specifications
            const specRows = document.querySelectorAll(".spec-row");
            const specsData = [];
            
            if (specRows.length === 0) {
                const sMainErr = document.getElementById("specMainError");
                sMainErr.classList.remove("hidden");
                isValid = false;
            } else {
                let hasOneCompleteSpec = false;
                
                specRows.forEach(row => {
                    const titleIn = row.querySelector("input[name='specTitle[]']");
                    const descIn = row.querySelector("input[name='specification[]']");
                    
                    const titleVal = titleIn.value.trim();
                    const descVal = descIn.value.trim();

                    if (titleVal === "" && descVal === "") {
                        // Empty row: Flag it
                        showError(titleIn, "Title required.");
                        showError(descIn, "Details required.");
                        isValid = false;
                    } else if (titleVal === "" || descVal === "") {
                        // Partial
                        if(!titleVal) showError(titleIn, "Title required.");
                        if(!descVal) showError(descIn, "Details required.");
                        isValid = false;
                    } else {
                        // Valid row
                        hasOneCompleteSpec = true;
                        specsData.push({ title: titleVal, details: descVal });
                    }
                });

                if(!hasOneCompleteSpec && isValid) {
                     // If logic slipped through (shouldn't happen with logic above)
                     // This ensures we actually pushed data
                }
            }


            // 6. Stop if Invalid
            if (!isValid) {
                if(firstErrorElement) {
                    firstErrorElement.scrollIntoView({ behavior: 'smooth', block: 'center' });
                } else {
                    window.scrollTo({ top: 0, behavior: 'smooth' });
                }
                // NO SWEET ALERT HERE as requested. Just visual red errors.
                return;
            }

            // 7. Process Submission
            loader.classList.remove("hidden");

            try {
                // Upload Images
                const uploadedImages = [];
                for (let i = 0; i < images.length; i++) {
                    const canvas = images[i].cropper.getCroppedCanvas({ width: 800, height: 800 });
                    const blob = await new Promise(res => canvas.toBlob(res));
                    const formData = new FormData();
                    formData.append("file", blob);
                    formData.append("upload_preset", "product_upload");
                    
                    const uploadRes = await axios.post(`https://api.cloudinary.com/v1_1/dmx7sia5q/image/upload`, formData);
                    uploadedImages.push(uploadRes.data.secure_url);
                }

                // Prepare Payload
                const statusEl = document.querySelector("input[name='status']:checked");
                const categoryTypeEl = document.querySelector("input[name='categoryType']:checked");
                
                const productData = {
                    brand: brandEl.value,
                    productName: nameEl.value,
                    description: descEl.value,
                    category: catEl.value,
                    status: statusEl ? statusEl.value : "listed",
                    categoryType: categoryTypeEl ? categoryTypeEl.value : "component",
                    limitedEdition: document.querySelector("input[name='limitedEdition']").checked,
                    flashSale: document.querySelector("input[name='flashSale']").checked,
                    variants: variantsData,
                    specifications: specsData,
                    images: uploadedImages
                };

                const response = await fetch("/admin/products/addProducts", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify(productData)
                });

                const result = await response.json();
                loader.classList.add("hidden");

                if (result.success) {
                    Swal.fire({
                        title: 'Success!',
                        text: 'Product has been added.',
                        icon: 'success',
                        confirmButtonColor: '#3085d6'
                    }).then(() => {
                        window.location.href = "/admin/products";
                    });
                } else {
                    Swal.fire('Error', result.message || 'Failed to add product', 'error');
                }

            } catch (err) {
                console.error(err);
                loader.classList.add("hidden");
                Swal.fire('Error', 'An error occurred while uploading. Check console for details.', 'error');
            }
        });
    </script>
</body>
</html>