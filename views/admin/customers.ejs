<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Customer List - Admin Dashboard</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>

<body class="bg-gray-50">
    <div class="flex min-h-screen">

        <!-- ============================================ -->
        <!-- SIDEBAR SECTION - INCLUDE YOUR SIDEBAR HERE -->
        <!-- ============================================ -->
        <aside id="sidebar"
            class="w-full sm:w-64 bg-white shadow-lg fixed lg:static left-0 top-0 h-screen z-40 transition-transform duration-300 lg:translate-x-0 -translate-x-full overflow-y-auto">
            <%- include("../../views/partials/admin/sidebar") %>
        </aside>

        <!-- Main Content Area -->
        <div class="flex-1 flex flex-col min-h-screen">

            <!-- ============================================ -->
            <!-- HEADER SECTION - INCLUDE YOUR HEADER HERE -->
            <!-- ============================================ -->
            <header class="bg-white shadow-sm sticky top-0 z-30">
                <%- include("../../views/partials/admin/header") %>
            </header>

            <!-- Page Content -->
            <main class="flex-1 p-4 sm:p-6 lg:p-8">
                <!-- Page Title & Breadcrumb -->
                <div class="mb-6">
                    <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-2">CUSTOMER LIST</h1>
                    <div class="flex items-center gap-2 text-sm text-gray-600">
                        <span>Dashboard</span>
                        <i class="fas fa-chevron-right text-xs"></i>
                        <span class="text-gray-900">CUSTOMERS</span>
                    </div>
                </div>

                <!-- Search & Filter Bar -->
                <div class="flex flex-col sm:flex-row gap-4 mb-6">
                    <div class="flex-1 relative">
                        <i class="fas fa-search absolute left-3 top-1/2 -translate-y-1/2 text-gray-400"></i>
                        <input type="text" placeholder="Search customer..."
                            class="w-full pl-10 pr-4 py-2.5 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-gray-900 focus:border-transparent">
                    </div>
                    <button
                        class="flex items-center justify-center gap-2 px-4 py-2.5 border border-gray-300 rounded-lg hover:bg-gray-50 transition-colors">
                        <i class="fas fa-sliders-h"></i>
                        <span>Filters</span>
                    </button>
                </div>

                <!-- Customer Table -->
                <div class="bg-white rounded-lg shadow overflow-hidden">
                    <div class="overflow-x-auto">
                        <table class="w-full min-w-[800px]">
                            <thead class="bg-black text-white">
                                <tr>
                                    <th
                                        class="px-3 sm:px-4 py-3 sm:py-4 text-left text-xs sm:text-sm font-semibold whitespace-nowrap">
                                        Customer Name</th>
                                    <th
                                        class="px-3 sm:px-4 py-3 sm:py-4 text-left text-xs sm:text-sm font-semibold whitespace-nowrap">
                                        Phone</th>
                                    <th
                                        class="px-3 sm:px-4 py-3 sm:py-4 text-left text-xs sm:text-sm font-semibold whitespace-nowrap">
                                        Orders</th>
                                    <th
                                        class="px-3 sm:px-4 py-3 sm:py-4 text-left text-xs sm:text-sm font-semibold whitespace-nowrap">
                                        Balance</th>
                                    <th
                                        class="px-3 sm:px-4 py-3 sm:py-4 text-left text-xs sm:text-sm font-semibold whitespace-nowrap">
                                        Status</th>
                                    <th
                                        class="px-3 sm:px-4 py-3 sm:py-4 text-left text-xs sm:text-sm font-semibold whitespace-nowrap">
                                        BLOCK/<br>UNBLOCK</th>
                                    <th
                                        class="px-3 sm:px-4 py-3 sm:py-4 text-left text-xs sm:text-sm font-semibold whitespace-nowrap">
                                        Action</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-gray-200">
                                <%for(let i=0; i<data.length; i++){%>
                                    <tr class="hover:bg-gray-50 transition-colors">
                                        <td class="px-4 py-4">
                                            <div class="flex items-center gap-3">
                                                <div class="w-10 h-10 bg-gray-200 rounded-full flex-shrink-0"></div>
                                                <div>
                                                    <p class="font-medium text-gray-900">
                                                        <%=data[i].fullName%>
                                                    </p>
                                                    <p class="text-sm text-gray-500">
                                                        <%=data[i].email%>
                                                    </p>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="px-4 py-4 text-gray-700">
                                            <%=data[i].phoneNumber%>
                                        </td>
                                        <td class="px-4 py-4 text-gray-700">
                                            <%=data[i].walletBalance%>
                                        </td>
                                        <td class="px-4 py-4 text-gray-700">
                                            <%=data[i].walletBalance%>
                                        </td>
                                        <td class="px-4 py-4">
                                            <span
                                                class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-red-100 text-red-700">
                                                <%if(data[i].isBlocked){%>
                                                    Blocked
                                                    <%}else{%>
                                                        Unblocked
                                                        <%}%>
                                            </span>
                                        </td>
                                        <td class="px-4 py-4">
                                            <% if (data[i].isBlocked) { %>
                                                <a href="/admin/unblockCustomers?id=<%= data[i]._id %>"
                                                    class="inline-flex items-center justify-center w-20 h-8 rounded-full bg-red-600 text-white text-sm font-medium hover:bg-red-700 transition-colors">
                                                    Unblock
                                                </a>
                                                <% } else { %>
                                                    <a href="/admin/blockCustomers?id=<%= data[i]._id %>"
                                                        class="inline-flex items-center justify-center w-20 h-8 rounded-full bg-green-600 text-white text-sm font-medium hover:bg-green-700 transition-colors">
                                                        Block
                                                    </a>
                                                    <% } %>


                                        </td>
                                        <td class="px-4 py-4">
                                            <button class="text-gray-600 hover:text-gray-900 transition-colors">
                                                <i class="far fa-eye text-lg"></i>
                                            </button>
                                        </td>
                                    </tr>
                                    <%}%>
                            </tbody>
                        </table>
                    </div>

                    <!-- Pagination -->
                    <div class="flex items-center justify-center px-4 py-4 border-t border-gray-200">
                        <nav aria-label="Page navigation" class="flex justify-center mt-2 mb-2">
                            <ul class="flex items-center gap-2">
                                <% for (let i=1; i <=totalPages; i++) { %>
                                    <li>
                                        <a href="?page=<%= i %>" class="px-3 py-1.5 border border-gray-300 rounded-md text-sm font-medium text-gray-700 hover:bg-gray-100 transition-colors
                                            <%= (i === currentPage) ? 'bg-black text-white border-blue-600' : '' %>">
                                            <%= i %>
                                        </a>
                                    </li>
                                    <% } %>
                            </ul>
                        </nav>
                    </div>

                </div>
            </main>
        </div>
    </div>

    <!-- Mobile Menu Overlay -->
    <div id="overlay" class="fixed inset-0 bg-black bg-opacity-50 z-30 hidden lg:hidden"></div>

    <script>
        // Mobile menu toggle
        const menuToggle = document.getElementById('menuToggle');
        const sidebar = document.getElementById('sidebar');
        const overlay = document.getElementById('overlay');

        menuToggle.addEventListener('click', () => {
            sidebar.classList.toggle('-translate-x-full');
            overlay.classList.toggle('hidden');
        });

        overlay.addEventListener('click', () => {
            sidebar.classList.add('-translate-x-full');
            overlay.classList.add('hidden');
        });

        // Block/Unblock toggle functionality
        const blockButtons = document.querySelectorAll('td:nth-child(6) button');
        blockButtons.forEach(button => {
            button.addEventListener('click', function () {
                const isBlocked = this.classList.contains('bg-red-600');
                const statusBadge = this.closest('tr').querySelector('td:nth-child(5) span');

                if (isBlocked) {
                    // Change to Block state
                    this.classList.remove('bg-red-600');
                    this.classList.add('bg-gray-200', 'hover:bg-gray-300');
                    this.querySelector('span').textContent = 'BLOCK';
                    this.querySelector('span').classList.remove('text-white');
                    this.querySelector('span').classList.add('text-gray-700');

                    // Update status badge
                    statusBadge.classList.remove('bg-red-100', 'text-red-700');
                    statusBadge.classList.add('bg-green-100', 'text-green-700');
                    statusBadge.textContent = 'Active';
                } else {
                    // Change to Unblock state
                    this.classList.remove('bg-gray-200', 'hover:bg-gray-300');
                    this.classList.add('bg-red-600');
                    this.querySelector('span').textContent = 'UNBLOCK';
                    this.querySelector('span').classList.remove('text-gray-700');
                    this.querySelector('span').classList.add('text-white');

                    // Update status badge
                    statusBadge.classList.remove('bg-green-100', 'text-green-700');
                    statusBadge.classList.add('bg-red-100', 'text-red-700');
                    statusBadge.textContent = 'Blocked';
                }
            });
        });
    </script>
</body>

</html>