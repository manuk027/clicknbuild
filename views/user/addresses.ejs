<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>clickNbuild</title>
    <link rel="icon" href="https://res.cloudinary.com/dmx7sia5q/image/upload/v1761540715/logo_dtmtfn.png" type="image/png">
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

</head>

<body class="bg-gray-50">
    <%- include("../../views/partials/user/header", { peripheral: peripheral, component: component, user: user }) %>
        <!-- Mobile Sidebar Toggle Button (visible only on mobile) -->
        <div class="lg:hidden fixed top-4 left-4 z-50">
            <button id="mobileSidebarBtn" class="bg-white p-2 rounded-lg shadow-md">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16">
                    </path>
                </svg>
            </button>
        </div>

        <!-- Sidebar Overlay (mobile only) -->
        <div id="sidebarOverlay" class="hidden fixed inset-0 bg-black bg-opacity-50 z-40 lg:hidden"></div>

        <div class="flex min-h-screen">
            <!-- Sidebar -->

            <%- include("../../views/partials/user/sidebar")%>

                <!-- Main Content -->
                <main class="flex-1 p-4 md:p-6 lg:p-8">
                    <!-- Breadcrumb -->
                    <nav class="mb-6 text-sm">
                        <ol class="flex items-center space-x-2 text-gray-600">
                            <li><a href="#" class="hover:text-gray-900">Profile</a></li>
                            <li><span>></span></li>
                            <li class="text-gray-900 font-medium">Address</li>
                        </ol>
                    </nav>

                    <!-- Delivery Address Card -->
                    <div class="bg-white rounded-2xl shadow-sm p-6 lg:p-8">
                        <h1 class="text-2xl lg:text-3xl font-bold mb-8 text-center lg:text-left">Delivery Address</h1>

                        <% if (address.length> 0) { %>
                            <!-- Address Cards Grid -->
                            <div id="addressContainer"
                                class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-6 mb-8">
                                <% for (let i=0; i < address[0].address.length; i++) { %>
                                    <!-- Address Card -->
                                    <div
                                        class="address-card border border-gray-200 rounded-xl p-6 relative hover:shadow-md transition-all duration-200 bg-white">

                                        <!-- Edit Button -->
                                        <a href="/editAddress/<%= address[0].address[i]._id %>"
                                            class="edit-btn absolute top-4 right-4 p-2 hover:bg-gray-100 rounded-lg transition">
                                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                    d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z">
                                                </path>
                                            </svg>
                                        </a>

                                        <!-- Address Info -->
                                        <div class="pr-8">
                                            <h3 class="font-bold text-lg mb-1">
                                                <%= address[0].address[i].fullName %>
                                            </h3>
                                            <p class="text-gray-600 text-sm mb-1">
                                                <%= address[0].address[i].phoneNumber %>
                                            </p>
                                            <p class="text-gray-600 text-sm mb-1">
                                                <%= address[0].address[i].address %>
                                            </p>
                                            <p class="text-gray-600 text-sm mb-1">
                                                <%= address[0].address[i].district %>
                                            </p>
                                            <p class="text-gray-600 text-sm mb-1">
                                                <%= address[0].address[i].state %>
                                            </p>
                                            <p class="text-gray-600 text-sm mb-1">
                                                <%= address[0].address[i].city %>
                                            </p>
                                            <p class="text-gray-600 text-sm mb-1">
                                                <%= address[0].address[i].pincode %>
                                            </p>
                                            <p class="text-gray-600 text-sm mb-4">
                                                <%= address[0].address[i].landmark %>
                                            </p>

                                            <div
                                                class="flex items-center justify-between mt-4 pt-4 border-t border-gray-200">
                                                <%if(i==0){%>
                                                    <span
                                                        class="bg-gray-100 text-gray-700 px-3 py-1 rounded-full text-xs font-medium">Default</span>
                                                    <%}%>
                                                        <button data-id="<%= address[0].address[i]._id %>"
                                                            class="delete-btn text-white bg-black px-4 py-2 rounded-lg text-sm font-medium hover:bg-gray-800 transition">
                                                            DELETE
                                                        </button>
                                            </div>
                                        </div>
                                    </div>
                                    <% } %>
                            </div>
                            <% } else { %>
                                <h6 class="text-lg font-semibold mb-8 text-center text-gray-600">No address found.</h6>
                                <% } %>

                                    <!-- Add New Address Button -->
                                    <div class="flex justify-center">
                                        <a id="addNewAddressBtn" href="/address"
                                            class="bg-black text-white px-8 py-3 rounded-lg font-medium hover:bg-gray-800 transition">
                                            Add New Address
                                        </a>
                                    </div>
                    </div>

                </main>
        </div>
        <%- include("../../views/partials/user/footer")%>

            <script>
                // Mobile Sidebar Toggle
                const mobileSidebarBtn = document.getElementById('mobileSidebarBtn');
                const sidebarOverlay = document.getElementById('sidebarOverlay');
                const userSidebar = document.getElementById('userSidebar');

                mobileSidebarBtn.addEventListener('click', () => {
                    userSidebar.classList.remove('hidden');
                    userSidebar.classList.add('fixed', 'inset-y-0', 'left-0', 'z-50', 'overflow-y-auto', 'w-80');
                    sidebarOverlay.classList.remove('hidden');
                });

                sidebarOverlay.addEventListener('click', () => {
                    userSidebar.classList.add('hidden');
                    userSidebar.classList.remove('fixed', 'inset-y-0', 'left-0', 'z-50', 'overflow-y-auto', 'w-80');
                    sidebarOverlay.classList.add('hidden');

                    // Restore desktop visibility
                    if (window.innerWidth >= 1024) {
                        userSidebar.classList.remove('hidden');
                    }
                });

                // Handle window resize
                window.addEventListener('resize', () => {
                    if (window.innerWidth >= 1024) {
                        userSidebar.classList.remove('hidden', 'fixed', 'inset-y-0', 'left-0', 'z-50', 'overflow-y-auto', 'w-80');
                        sidebarOverlay.classList.add('hidden');
                    }
                });
            </script>
            <script>
                document.addEventListener("DOMContentLoaded", () => {
                    const deleteButtons = document.querySelectorAll(".delete-btn");

                    deleteButtons.forEach((button) => {
                        button.addEventListener("click", async (event) => {
                            event.preventDefault();
                            const addressId = button.getAttribute("data-id");

                            const confirm = await Swal.fire({
                                title: "Are you sure?",
                                text: "This address will be permanently deleted.",
                                icon: "warning",
                                showCancelButton: true,
                                confirmButtonColor: "#000",
                                cancelButtonColor: "#6b7280",
                                confirmButtonText: "Yes, delete it",
                                cancelButtonText: "Cancel"
                            });

                            if (confirm.isConfirmed) {
                                try {
                                    const response = await fetch(`/deleteAddress/${addressId}`, {
                                        method: "DELETE",
                                    });
                                    const result = await response.json();

                                    if (result.success) {
                                        Swal.fire("Deleted!", "The address was deleted successfully.", "success")
                                            .then(() => location.reload());
                                    } else {
                                        Swal.fire("Error!", result.message || "Something went wrong.", "error");
                                    }
                                } catch (err) {
                                    Swal.fire("Error!", "Unable to delete the address.", "error");
                                }
                            }
                        });
                    });
                });
            </script>



</body>

</html>