<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>clickNbuild</title>
    <link rel="icon" href="https://res.cloudinary.com/dmx7sia5q/image/upload/v1761540715/logo_dtmtfn.png"
        type="image/png">
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>

<body class="bg-gray-50">
    <!-- ADD HEADER HERE -->
    <%- include("../../views/partials/user/header", { peripheral: peripheral, component: component, user: user }) %>
        <!-- Main Wishlist Section -->
        <nav class="mb-6 text-sm pl-5 pt-5">
            <ol class="flex flex-wrap items-center space-x-2 text-gray-600">
                <li><a href="/" class="hover:text-gray-900">Home</a></li>
                <li><span>></span></li>
                <li><a href="/wishlist" class="hover:text-gray-900 font-bold">Wishlist</a></li>
            </ol>
        </nav>
        <%if(wishlist.items.length>=1){%>
            <main class="container mx-auto px-4 py-8 max-w-7xl">
                <!-- Wishlist Header -->
                <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-6">
                    <h1 class="text-2xl font-semibold">
                        Wishlist (<span id="wishlist-count">
                            <%=wishlist.items.length%>
                        </span>)
                    </h1>
                    <div class="flex flex-col sm:flex-row gap-3 w-full sm:w-auto">
                        <!-- <button id="move-all-btn"
                            class="px-4 py-2 border border-gray-300 rounded hover:bg-gray-400 hover:text-white hover:border transition text-sm sm:text-base">
                            Move all to cart
                        </button> -->
                        <button id="empty-wishlist-btn" onclick="emptyWishlist()"
                            class="px-4 py-2 bg-black text-white hover:border  hover:text-black rounded hover:bg-white transition text-sm sm:text-base">
                            Empty my Wishlist
                        </button>
                    </div>
                </div>

                <!-- Wishlist Items Grid -->
                <div class="bg-white rounded-lg shadow-sm p-4 sm:p-6">
                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4 sm:gap-6">

                        <%for(let i=0; i<wishlist.items.length; i++){%>
                            <div
                                class="border border-gray-200 rounded-2xl p-4 flex flex-col items-center hover:shadow-lg transition-all duration-300 bg-white max-w-xs w-full sm:max-w-sm md:max-w-md lg:max-w-xs mx-auto h-[280px] sm:h-[380px] md:h-[380px]">

                                <!-- Product Image -->
                                <div
                                    class="bg-gray-100 rounded-xl w-auto aspect-square flex items-center justify-center mb-4 overflow-hidden">
                                    <img src="<%= wishlist.items[i].productId.images[0] %>"
                                        alt="<%= wishlist.items[i].productId.brand.name %> <%= wishlist.items[i].productId.model %>"
                                        class="w-24 h-24 sm:w-32 sm:h-32 md:w-40 md:h-40 object-contain transition-transform duration-300 hover:scale-105" />
                                </div>

                                <!-- Product Title -->
                                <p
                                    class="text-base sm:text-lg md:text-xl font-semibold mb-2 text-center text-gray-800 truncate w-full px-2">
                                    <%=wishlist.items[i].productId.brand.name%>
                                        <%=wishlist.items[i].productId.model%>
                                </p>

                                <!-- Spacer to push buttons to bottom -->
                                <div class="flex-grow"></div>

                                <!-- Buttons -->
                                <div class="w-full space-y-2 mt-auto">
                                    <button
                                        class="add-to-cart-btn w-full py-2 sm:py-2.5 bg-black text-white rounded-xl hover:bg-gray-800 transition text-sm sm:text-base md:text-lg font-medium"
                                        data-product-id="<%= wishlist.items[i].productId._id %>"
                                        data-variant-id="<%= wishlist.items[i].variantId %>">
                                        Add to Cart
                                    </button>

                                    <button
                                        onclick="addToWishlist('<%= wishlist.items[i].productId._id %>', '<%=wishlist.items[i].variantId%>')"
                                        class="w-full py-2 sm:py-2.5 bg-[#2E2E2E] text-white rounded-xl hover:bg-white hover:text-black border border-transparent hover:border-gray-400 transition text-sm sm:text-base md:text-lg font-medium">
                                        Remove
                                    </button>
                                </div>
                            </div>


                            <%}%>

                    </div>
                </div>
            </main>
            <%}%>
                <%if(wishlist.items.length===0){%>
                    <div id="empty-cart-message"
                        class="items-center justify-center flex h-[60vh] bg-white rounded-lg shadow p-12 mb-8 mx-5">
                        <div class="text-center">
                            <p class="text-2xl text-gray-600 mb-6">No Products found</p>
                            <a href="/shop"
                                class="bg-black text-white px-8 py-3 rounded hover:bg-gray-800 transition font-semibold">
                                Add Product to Wishlist
                            </a>
                        </div>
                    </div>
                    <%}%>
                        <%- include("../../views/partials/user/footer") %>
                            <!-- ADD FOOTER HERE -->
                            <script>
                                async function addToWishlist(productId, variantId) {

                                    try {
                                        const response = await fetch("/wishlist/add", {
                                            method: "POST",
                                            headers: { "Content-Type": "application/json" },
                                            body: JSON.stringify({ productId, variantId }),
                                            credentials: "include",
                                        });

                                        const contentType = response.headers.get("content-type");

                                        // If not logged in, backend likely returned HTML
                                        if (!contentType || !contentType.includes("application/json")) {
                                            await Swal.fire({
                                                icon: "warning",
                                                title: "Login Required",
                                                text: "Please log in to add items to your wishlist.",
                                                confirmButtonColor: "#000000",
                                            });
                                            window.location.href = "/login";
                                            return;
                                        }

                                        const data = await response.json();

                                        if (response.status === 401) {
                                            await Swal.fire({
                                                icon: "warning",
                                                title: "Login Required",
                                                text: "Please log in to continue shopping.",
                                                confirmButtonColor: "#000000",
                                            });
                                            window.location.href = "/login";
                                            return;
                                        }

                                        if (data.success) {
                                            if (data.added) {
                                                await Swal.fire({
                                                    icon: "success",
                                                    title: "Added to wishlist!",
                                                    text: data.message || "Product added to wishlist successfully.",
                                                    confirmButtonColor: "#000000",
                                                });
                                            } else {
                                                await Swal.fire({
                                                    icon: "warning",
                                                    title: "Removed from wishlist!",
                                                    text: data.message || "Product removed from wishlist successfully.",
                                                    confirmButtonColor: "#000000",
                                                });
                                            }
                                            if (response.ok) {
                                                window.location.reload();
                                            }

                                            // Reload to show updated cart count, etc.
                                            window.location.reload();
                                        } else {
                                            await Swal.fire({
                                                icon: "warning",
                                                title: "Could Not Add Product",
                                                text: data.message || "Something went wrong. Please try again.",
                                                confirmButtonColor: "#000000",
                                            });
                                        }

                                    } catch (error) {
                                        console.error(" Error adding to wishlist:", error);
                                        await Swal.fire({
                                            icon: "error",
                                            title: "Server Error",
                                            text: "Unable to connect to the server. Please try again later.",
                                            confirmButtonColor: "#000000",
                                        });
                                    }
                                };
                            </script>




                            <script>
                                async function emptyWishlist() {
                                    // SweetAlert confirmation
                                    const result = await Swal.fire({
                                        title: "Empty wishlist!",
                                        text: "Your entire wishlist will be cleared!",
                                        icon: "warning",
                                        showCancelButton: true,
                                        confirmButtonColor: "#3085d6",
                                        cancelButtonColor: "#d33",
                                        confirmButtonText: "Empty wishlist",
                                        cancelButtonText: "Cancel",
                                    });

                                    if (result.isConfirmed) {
                                        try {
                                            const response = await fetch("/wishlist/empty", {
                                                method: "DELETE",
                                            });
                                            const data = await response.json();
                                            if (response.ok) {
                                                Swal.fire({
                                                    title: "Wishlist cleared!",
                                                    text: data.message || "Your wihslist have been successfully cleared.",
                                                    icon: "success",
                                                    confirmButtonColor: "#3085d6",
                                                }).then(() => window.location.reload());
                                            } else {
                                                Swal.fire({
                                                    title: "Error!",
                                                    text: data.message || "Failed to empty your wihslist. Please try again.",
                                                    icon: "error",
                                                    confirmButtonColor: "#3085d6",
                                                });
                                            }
                                        } catch (error) {
                                            console.error("Error clearing wihslist:", error);
                                            Swal.fire({
                                                title: "Error!",
                                                text: "Something went wrong while clearing your wishlist.",
                                                icon: "error",
                                                confirmButtonColor: "#3085d6",
                                            });
                                        }
                                    }
                                }
                            </script>
                            <script>
                                document.addEventListener("DOMContentLoaded", () => {
                                    // Select all buttons with the class
                                    const addToCartButtons = document.querySelectorAll(".add-to-cart-btn");

                                    // Loop through each button and attach click event
                                    addToCartButtons.forEach((button) => {
                                        button.addEventListener("click", async (event) => {
                                            event.preventDefault();

                                            const productId = button.dataset.productId;
                                            const variantId = button.dataset.variantId;

                                            console.log("🛒 Sending to backend:", { productId, variantId });

                                            try {
                                                const response = await fetch("/cart/add", {
                                                    method: "POST",
                                                    headers: { "Content-Type": "application/json" },
                                                    body: JSON.stringify({ productId, variantId, quantity: 1 }),
                                                    credentials: "include",
                                                });

                                                const contentType = response.headers.get("content-type");

                                                // If not logged in, backend likely returned HTML
                                                if (!contentType || !contentType.includes("application/json")) {
                                                    await Swal.fire({
                                                        icon: "warning",
                                                        title: "Login Required",
                                                        text: "Please log in to add items to your cart.",
                                                        confirmButtonColor: "#000000",
                                                    });
                                                    window.location.href = "/login";
                                                    return;
                                                }

                                                const data = await response.json();

                                                if (response.status === 401) {
                                                    await Swal.fire({
                                                        icon: "warning",
                                                        title: "Login Required",
                                                        text: "Please log in to continue shopping.",
                                                        confirmButtonColor: "#000000",
                                                    });
                                                    window.location.href = "/login";
                                                    return;
                                                }

                                                if (data.success) {
                                                    await Swal.fire({
                                                        icon: "success",
                                                        title: "Added to Cart!",
                                                        text: data.message || "Product added to cart successfully.",
                                                        confirmButtonColor: "#000000",
                                                    });
                                                    // Reload to show updated cart count, etc.
                                                    window.location.reload();
                                                } else {
                                                    await Swal.fire({
                                                        icon: "warning",
                                                        title: "Could Not Add Product",
                                                        text: data.message || "Something went wrong. Please try again.",
                                                        confirmButtonColor: "#000000",
                                                    });
                                                }

                                            } catch (error) {
                                                console.error(" Error adding to cart:", error);
                                                await Swal.fire({
                                                    icon: "error",
                                                    title: "Server Error",
                                                    text: "Unable to connect to the server. Please try again later.",
                                                    confirmButtonColor: "#000000",
                                                });
                                            }
                                        });
                                    });
                                });
                            </script>
</body>

</html>