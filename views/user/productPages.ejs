<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>clickNbuild</title>
    <link rel="icon" href="https://res.cloudinary.com/dmx7sia5q/image/upload/v1761540715/logo_dtmtfn.png"
        type="image/png">
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
        rel="stylesheet">
    <!-- SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

</head>

<body class="font-[Poppins] bg-gray-50">
    <%- include("../../views/partials/user/header", { peripheral: peripheral, component: component, user: user }) %>

        <!-- Main Content -->
        <main class="container mx-auto px-4 md:px-6 py-8">

            <!-- Breadcrumb -->
            <div class="text-sm text-gray-600 mb-6">
                <a href="/" class="hover:text-black">Home</a>
                <span class="mx-2">/</span>
                <span class="text-black font-medium">
                    <% if(filterCategory.length>1){ %>
                        All Products
                        <% } else { %>
                            <%=product[0].category.name%>
                                <% } %>
                </span>
            </div>

            <!-- ✅ Mobile Filter & Sort Dropdowns -->
            <!-- ✅ Mobile Filter & Sort Section (Supports Multiple Filters, Single Sort) -->
            <div class="lg:hidden mb-6 bg-white p-4 rounded-lg shadow-sm">
                <form id="filterForm" method="GET"
                    action="/<%= typeof route !== 'undefined' ? route : 'products' %>/<%= typeof name !== 'undefined' ? name : '' %>"
                    class="hidden lg:block">


                    <!-- Filter Section -->
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-3">Filter By</label>
                        <% if(filterBrand && filterBrand.length){ %>
                            <h4 class="font-medium text-gray-800 mb-2">Brand</h4>
                            <div class="grid grid-cols-2 gap-2 mb-4">
                                <% for(let i=0; i<filterBrand.length; i++){ %>
                                    <label class="flex items-center space-x-2">
                                        <input type="checkbox" name="brand" value="<%=filterBrand[i]%>"
                                            class="text-black focus:ring-black rounded border-gray-300"
                                            <%=selectedBrands && selectedBrands.includes(filterBrand[i]) ? 'checked'
                                            : '' %>>
                                        <span class="text-sm">
                                            <%=filterBrand[i]%>
                                        </span>
                                    </label>
                                    <% } %>
                            </div>
                            <% } %>

                                <% if(filterCategory && filterCategory.length){ %>
                                    <h4 class="font-medium text-gray-800 mb-2">Category</h4>
                                    <div class="grid grid-cols-2 gap-2">
                                        <% for(let i=0; i<filterCategory.length; i++){ %>
                                            <label class="flex items-center space-x-2">
                                                <input type="checkbox" name="category" value="<%=filterCategory[i]%>"
                                                    class="text-black focus:ring-black rounded border-gray-300"
                                                    <%=selectedCategories &&
                                                    selectedCategories.includes(filterCategory[i]) ? 'checked' : '' %>>
                                                <span class="text-sm">
                                                    <%=filterCategory[i]%>
                                                </span>
                                            </label>
                                            <% } %>
                                    </div>
                                    <% } %>
                    </div>

                    <!-- Sort Dropdown -->
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Sort By</label>
                        <select id="mobileSortDropdown" name="sort"
                            class="w-full border border-gray-300 rounded-md py-2 px-3 text-sm focus:outline-none focus:ring-1 focus:ring-black">
                            <option value="">Select Sort</option>
                            <option value="newest">Newest First</option>
                            <option value="oldest">Oldest First</option>
                            <option value="priceAsc">Price: Low - High</option>
                            <option value="priceDesc">Price: High - Low</option>
                            <option value="nameAsc">Name: A - Z</option>
                            <option value="nameDesc">Name: Z - A</option>
                        </select>
                    </div>

                    <!-- Apply Button -->
                    <button type="submit"
                        class="w-full bg-black text-white py-2 rounded-md text-sm font-medium hover:bg-gray-800 transition">
                        Apply Filter
                    </button>
                </form>
            </div>
            <!-- ✅ End Mobile Section -->

            <!-- ✅ End Mobile Section -->

            <div class="flex flex-col lg:flex-row gap-8">

                <!-- Sidebar Filters -->
                <form id="filterForm" method="GET"
                    action="/<%= typeof route !== 'undefined' ? route : 'products' %>/<%= typeof name !== 'undefined' ? name : '' %>">
                    <% if (filterBrand) { %>
                        <div class="mb-6">
                            <h3 class="font-medium mb-3">Brand</h3>
                            <div class="space-y-2">
                                <% for (let i=0; i < filterBrand.length; i++) { %>
                                    <label class="flex items-center cursor-pointer">
                                        <input type="checkbox" name="brand" value="<%= filterBrand[i] %>"
                                            class="w-4 h-4 text-black border-gray-300 rounded focus:ring-black"
                                            <%=selectedBrands && selectedBrands.includes(filterBrand[i]) ? 'checked'
                                            : '' %>>
                                        <span class="ml-2 text-sm">
                                            <%= filterBrand[i] %>
                                        </span>
                                    </label>
                                    <% } %>
                            </div>
                        </div>
                        <% } %>

                            <% if (filterCategory) { %>
                                <div class="mb-6">
                                    <h3 class="font-medium mb-3">Category</h3>
                                    <div class="space-y-2">
                                        <% for (let i=0; i < filterCategory.length; i++) { %>
                                            <label class="flex items-center cursor-pointer">
                                                <input type="checkbox" name="category" value="<%= filterCategory[i] %>"
                                                    class="w-4 h-4 text-black border-gray-300 rounded focus:ring-black"
                                                    <%=selectedCategories &&
                                                    selectedCategories.includes(filterCategory[i]) ? 'checked' : '' %>>
                                                <span class="ml-2 text-sm">
                                                    <%= filterCategory[i] %>
                                                </span>
                                            </label>
                                            <% } %>
                                    </div>
                                </div>
                                <% } %>

                                    <button type="submit"
                                        class="w-full bg-black text-white py-3 rounded-md hover:bg-gray-800 transition font-medium">
                                        APPLY
                                    </button>
                </form>

                <!-- Products Section -->
                <div class="flex-1">

                    <!-- Sort Bar (Visible on Desktop Only) -->
                    <div
                        class="bg-white rounded-lg shadow-sm p-4 mb-6 flex-wrap items-center justify-between gap-4 hidden lg:flex">
                        <div class="flex flex-wrap items-center gap-2">
                            <span class="text-sm text-gray-600 font-bold">Sort By</span>
                            <a onclick="applySort('newest')"
                                class="px-4 py-2 text-sm text-gray-600 hover:text-black">Newest First</a>
                            <a onclick="applySort('oldest')"
                                class="px-4 py-2 text-sm text-gray-600 hover:text-black">Oldest First</a>
                            <a onclick="applySort('priceAsc')"
                                class="px-4 py-2 text-sm text-gray-600 hover:text-black">Price: Low - High</a>
                            <a onclick="applySort('priceDesc')"
                                class="px-4 py-2 text-sm text-gray-600 hover:text-black">Price: High - Low</a>
                            <a onclick="applySort('nameAsc')"
                                class="px-4 py-2 text-sm text-gray-600 hover:text-black">Name: A - Z</a>
                            <a onclick="applySort('nameDesc')"
                                class="px-4 py-2 text-sm text-gray-600 hover:text-black">Price: Z - A</a>
                        </div>
                    </div>

                    <script>
                        function applySort(sortType) {
                            const url = new URL(window.location.href);
                            if (sortType) {
                                url.searchParams.set("sort", sortType);
                            } else {
                                url.searchParams.delete("sort");
                            }
                            window.location.href = url.toString();
                        }
                    </script>

                    <!-- Products Grid -->
                    <% if(product.length){ %>
                        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                            <% for(let i=0; i<product.length; i++){ %>
                                <div
                                    class="bg-white rounded-lg shadow-sm hover:shadow-lg transition-shadow overflow-hidden group flex flex-col h-full min-h-[500px]">
                                    <div
                                        class="relative aspect-square bg-gray-100 flex items-center justify-center p-6">
                                        <a href="/product?id=<%= product[i]._id %>">
                                            <img src="<%=product[i].images[0]%>" alt="<%=product[i].brand.name%>"
                                                class="w-full h-full object-contain transition-transform product-img"
                                                data-images='<%- JSON.stringify(product[i].images) %>'>
                                        </a>
                                        <script>console.log(product[i]?.variants[0]?._id.toString());</script>
                                        <button
                                            onclick="addToWishlist('<%= product[i]._id %>', '<%= product[i].variants[0]._id %>', <%= i %>)"
                                            class="absolute top-3 right-3 w-8 h-8 rounded-full flex items-center justify-center transition bg-white hover:bg-gray-100">

                                            <svg xmlns="http://www.w3.org/2000/svg"
                                                fill="<%= wish.includes(product[i].variants[0]._id.toString()) ? 'red' : 'white' %>"
                                                stroke="<%= wish.includes(product[i].variants[0]._id.toString()) ? 'none' : 'black' %>"
                                                viewBox="0 0 24 24" stroke-width="2"
                                                class="w-5 h-5 transition-all duration-300 ease-in-out"
                                                id="qty-<%= i %>">
                                                <path stroke-linecap="round" stroke-linejoin="round"
                                                    d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" />
                                            </svg>
                                        </button>


                                    </div>
                                    <div class="p-4 flex flex-col flex-grow">
                                        <% if(product[i].variants[0].quantity<=10 && product[i].variants[0].quantity>=1){ %>
                                            <h3 class="font-medium text-red-900 mb-1 truncate">
                                                <%=product[i].variants[0].quantity%> items left.
                                            </h3>
                                            <% } else if(product[i].variants[0].quantity===0){ %>
                                                <h3 class="font-medium text-red-900 mb-1 truncate">Out of Stock.
                                                </h3>
                                                <% } %>

                                                    <h3 class="font-medium text-gray-800 mb-1 truncate">
                                                        <%=product[i].brand.name%>
                                                    </h3>
                                                    <h6 class="font-medium text-gray-800 mb-2 line-clamp-2">
                                                        <%=product[i].model%>
                                                    </h6>

                                                    <div class="flex items-center gap-2 mb-2">
                                                        <span class="text-gray-400 line-through text-sm">₹
                                                            <%=product[i].variants[0].price%>
                                                        </span>
                                                        <span class="text-lg font-semibold text-gray-900">₹
                                                            <%=product[i].variants[0].offer%>
                                                        </span>
                                                    </div>

                                                    <div class="flex items-center gap-1 mb-3">
                                                        <span class="text-yellow-400">★★★★★</span>
                                                    </div>

                                                    <% if(product[i].variants[0].quantity>=1){ %>
                                                        <button
                                                            class="add-to-cart-btn mt-auto w-full bg-black text-white py-2 rounded-md hover:bg-gray-800 transition font-medium text-sm"
                                                            data-product-id="<%= product[i]._id %>"
                                                            data-variant-id="<%= product[i].variants[0]._id %>">
                                                            Add to Cart
                                                        </button>

                                                        <% } %>
                                    </div>
                                </div>

                                <% } %>
                        </div>
                        <% } else { %>
                            <div class="flex flex-col items-center justify-center min-h-[60vh] text-center px-4">
                                <img src="https://cdn-icons-png.flaticon.com/512/1055/1055687.png"
                                    alt="No products found" class="w-32 sm:w-40 mb-6 opacity-80 select-none" />
                                <h2 class="text-2xl sm:text-3xl font-semibold text-gray-800 mb-2">No Products Found</h2>
                                <p class="text-gray-500 max-w-md">
                                    We couldn’t find any items that match your search or filter criteria.<br />
                                    Try adjusting your filters or explore other categories.
                                </p>
                                <a href="/"
                                    class="mt-6 inline-block bg-black text-white px-6 py-2 rounded-md hover:bg-gray-800 transition text-sm font-medium">
                                    Back to Home
                                </a>
                            </div>
                            <% } %>

                                <script>
                                    document.querySelectorAll('.product-img').forEach(img => {
                                        const images = JSON.parse(img.dataset.images);
                                        let index = 0;
                                        let interval;

                                        img.addEventListener('mouseenter', () => {
                                            if (images.length <= 1) return;
                                            interval = setInterval(() => {
                                                index = (index + 1) % images.length;
                                                img.src = images[index];
                                            }, 1000);
                                        });

                                        img.addEventListener('mouseleave', () => {
                                            clearInterval(interval);
                                            index = 0;
                                            img.src = images[0];
                                        });
                                    });
                                </script>
                </div>
            </div>
        </main>

        <%- include("../../views/partials/user/footer") %>

            <script>
                document.querySelectorAll('button').forEach(btn => {
                    if (btn.textContent.includes('Add to Cart')) {
                        btn.addEventListener('click', e => e.preventDefault());
                    }
                });
            </script>
            <script>
                document.addEventListener("DOMContentLoaded", () => {
                    // Select all buttons with the class
                    const addToCartButtons = document.querySelectorAll(".add-to-cart-btn");

                    // Loop through each button and attach click event
                    addToCartButtons.forEach((button) => {
                        button.addEventListener("click", async (event) => {
                            event.preventDefault();

                            const productId = button.dataset.productId;
                            const variantId = button.dataset.variantId;

                            console.log("🛒 Sending to backend:", { productId, variantId });

                            try {
                                const response = await fetch("/cart/add", {
                                    method: "POST",
                                    headers: { "Content-Type": "application/json" },
                                    body: JSON.stringify({ productId, variantId, quantity: 1 }),
                                    credentials: "include",
                                });

                                const data = await response.json().catch(() => null); // prevent crash if backend returns HTML

                                // 🧩 Check login by status, not content-type
                                if (response.status === 401 || (data && data.message === "User not logged in.")) {
                                    await Swal.fire({
                                        icon: "warning",
                                        title: "Login Required",
                                        text: "Please log in to continue shopping.",
                                        confirmButtonColor: "#000000",
                                    });
                                    window.location.href = "/login";
                                    return;
                                }

                                // ✅ Handle success
                                if (response.ok && data?.success) {
                                    await Swal.fire({
                                        icon: "success",
                                        title: "Added to Cart!",
                                        text: data.message || "Product added to cart successfully.",
                                        confirmButtonColor: "#000000",
                                    });
                                    window.location.reload();
                                    return;
                                }

                                // ⚠️ Expected user errors (validation, out of stock, etc.)
                                if (response.status === 400 || response.status === 404) {
                                    await Swal.fire({
                                        icon: "warning",
                                        title: "Could Not Add Product",
                                        text: data?.message || "Please check product availability or quantity.",
                                        confirmButtonColor: "#000000",
                                    });
                                    return;
                                }

                                // ❌ Unexpected or server errors
                                if (response.status === 500 || !data?.success) {
                                    await Swal.fire({
                                        icon: "error",
                                        title: "Server Error",
                                        text: data?.message || "Something went wrong while adding to cart.",
                                        confirmButtonColor: "#000000",
                                    });
                                    return;
                                }
                            } catch (error) {
                                console.error("Error adding to cart:", error);
                                await Swal.fire({
                                    icon: "error",
                                    title: "Network Error",
                                    text: "Unable to connect to the server. Please try again later.",
                                    confirmButtonColor: "#000000",
                                });
                            }


                        });
                    });
                });
            </script>
            <script>
                async function addToWishlist(productId, variantId, index) {
                    try {
                        const response = await fetch("/wishlist/add", {
                            method: "POST",
                            headers: { "Content-Type": "application/json" },
                            body: JSON.stringify({ productId, variantId }),
                            credentials: "include",
                        });

                        const contentType = response.headers.get("content-type");

                        // If not logged in, backend likely returned HTML
                        if (!contentType || !contentType.includes("application/json")) {
                            await Swal.fire({
                                icon: "warning",
                                title: "Login Required",
                                text: "Please log in to add items to your wishlist.",
                                confirmButtonColor: "#000000",
                            });
                            window.location.href = "/login";
                            return;
                        }

                        const data = await response.json();

                        if (response.status === 401) {
                            await Swal.fire({
                                icon: "warning",
                                title: "Login Required",
                                text: "Please log in to continue shopping.",
                                confirmButtonColor: "#000000",
                            });
                            window.location.href = "/login";
                            return;
                        }

                        if (data.success) {
                            if (data.added) {
                                await Swal.fire({
                                    icon: "success",
                                    title: "Added to wishlist!",
                                    text: data.message || "Product added to wishlist successfully.",
                                    confirmButtonColor: "#000000",
                                });

                                const heart = document.querySelector(`#qty-${index}`);
                                heart.style.fill = "red";
                                heart.style.stroke = "none"; // no border when red

                            } else {
                                await Swal.fire({
                                    icon: "warning",
                                    title: "Removed from wishlist!",
                                    text: data.message || "Product removed from wishlist successfully.",
                                    confirmButtonColor: "#000000",
                                });

                                const heart = document.querySelector(`#qty-${index}`);
                                heart.style.fill = "white"; // white heart
                                heart.style.stroke = "black"; // black border
                            }


                        } else {
                            await Swal.fire({
                                icon: "warning",
                                title: "Could Not Add Product",
                                text: data.message || "Something went wrong. Please try again.",
                                confirmButtonColor: "#000000",
                            });
                        }

                    } catch (error) {
                        console.error(" Error adding to wishlist:", error);
                        await Swal.fire({
                            icon: "error",
                            title: "Server Error",
                            text: "Unable to connect to the server. Please try again later.",
                            confirmButtonColor: "#000000",
                        });
                    }
                };
            </script>

</body>

</html>